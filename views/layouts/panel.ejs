<!doctype html>
<html lang="pl">
<head><%- include('../partials/head') %></head>
<body class="min-h-screen bg-paper">
<%- include('../partials/dash-top', { area: 'Mój panel' }) %>
<div class="lg:grid lg:grid-cols-[18rem_1fr]">
  <%- include('../partials/dash-side', { items: [
    { href: '/panel', label: 'Pulpit', icon: 'dashboard', exact: true },
    { href: '/panel/ulubione', label: 'Ulubione', icon: 'heart', badge: user.favorites.length || '' },
    { href: '/panel/wyszukiwania', label: 'Zapisane wyszukiwania', icon: 'bell' },
    { href: '/panel/wiadomosci', label: 'Wiadomości', icon: 'message', badge: unread || '' },
    { sep: 'Sprzedaję / wynajmuję' },
    { href: '/panel/ogloszenia', label: 'Moje ogłoszenia', icon: 'list' },
    { href: '/panel/ogloszenia/nowe', label: 'Dodaj ogłoszenie', icon: 'plus', exact: true },
    { sep: 'Konto' },
    { href: '/panel/ustawienia', label: 'Ustawienia', icon: 'settings' }
  ] }) %>
  <main class="min-w-0 px-4 py-6 lg:px-8 lg:py-8">
    <%- include('../partials/flash') %>
    <%- body %>
  </main>
</div>
<div id="toast" class="fixed left-1/2 z-[70] flex -translate-x-1/2 items-center gap-2 rounded-full bg-navy-900 px-5 py-3 text-sm font-medium text-white shadow-lift" style="bottom: calc(24px + env(safe-area-inset-bottom, 0px))" hidden></div>
<script src="/js/app.js?v=1" defer></script>
</body>
</html>

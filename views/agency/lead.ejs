<a href="/biuro-panel/zapytania" class="text-sm font-semibold text-muted hover:text-navy-900">← Zapytania</a>
<div class="mt-3 grid gap-6 xl:grid-cols-[1fr_360px]">
  <div class="grid content-start gap-6">
    <div class="card card-pad">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div><h1 class="font-display text-2xl font-extrabold"><%= lead.name %></h1><p class="text-sm text-muted"><%= fmt.dateTime(lead.createdAt) %> · <%= lead.topic === 'prezentacja' ? 'prośba o prezentację' : lead.topic === 'wycena' ? 'prośba o wycenę' : 'zapytanie' %></p></div>
        <span class="badge tone-<%= P.LEAD_STATUS[lead.status].tone %>"><%= P.LEAD_STATUS[lead.status].label %></span>
      </div>
      <div class="mt-5 rounded-2xl bg-paper p-4 whitespace-pre-line"><%= lead.message %></div>
      <% if (lead.replies.length) { %>
      <div class="mt-5 grid gap-3">
        <% lead.replies.forEach(function(r){ var mine = r.side === 'seller'; %>
        <div class="flex <%= mine ? 'justify-end' : '' %>"><div class="max-w-[85%] rounded-3xl <%= mine ? 'rounded-br-md bg-navy-800 text-white' : 'rounded-bl-md bg-paper' %> px-4 py-3"><p class="text-xs opacity-70"><%= r.authorName %> · <%= fmt.dateTime(r.at) %></p><p class="mt-1 whitespace-pre-line"><%= r.text %></p></div></div>
        <% }) %>
      </div>
      <% } %>
      <form method="post" action="/biuro-panel/zapytania/<%= lead._id %>" class="mt-5 grid gap-2">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="label" for="ld-reply">Odpowiedz klientowi (e-mail na <%= lead.email %>)</label>
        <textarea id="ld-reply" name="reply" class="textarea" placeholder="Dzień dobry, dziękuję za zainteresowanie ofertą…"></textarea>
        <button class="btn btn-primary w-fit"><%- icon('send', 'ico-sm') %>Wyślij odpowiedź</button>
      </form>
    </div>
    <div class="card card-pad">
      <h2 class="font-display text-lg font-bold">Notatki wewnętrzne</h2>
      <% if (lead.notes.length) { %><ul class="mt-4 grid gap-3"><% lead.notes.slice().reverse().forEach(function(n){ %><li class="rounded-2xl border border-line p-3.5"><p class="text-xs text-muted"><%= n.authorName || (n.author && n.author.name) %> · <%= fmt.dateTime(n.at) %></p><p class="mt-1 whitespace-pre-line text-sm"><%= n.text %></p></li><% }) %></ul><% } %>
      <form method="post" action="/biuro-panel/zapytania/<%= lead._id %>" class="mt-4 flex gap-2">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label for="ld-note" class="sr-only">Notatka</label><input id="ld-note" name="note" class="input" placeholder="np. Zadzwonić w piątek, szuka 3 pokoi z balkonem">
        <button class="btn btn-outline shrink-0">Dodaj</button>
      </form>
    </div>
    <% if (history.length) { %>
    <div class="card card-pad"><h2 class="font-display text-lg font-bold">Wcześniejsze zapytania tego klienta</h2>
      <ul class="mt-3 divide-y divide-line"><% history.forEach(function(h){ %><li class="flex justify-between gap-3 py-2.5 text-sm"><a href="/biuro-panel/zapytania/<%= h._id %>" class="truncate font-semibold hover:text-teal-600"><%= h.listing ? h.listing.title : 'Strona biura' %></a><span class="shrink-0 text-muted"><%= fmt.dateShort(h.createdAt) %></span></li><% }) %></ul></div>
    <% } %>
  </div>
  <aside class="grid content-start gap-4">
    <form method="post" action="/biuro-panel/zapytania/<%= lead._id %>" class="card card-pad grid gap-4">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div><label class="label" for="ld-status">Etap</label><select id="ld-status" name="status" class="select"><% Object.keys(P.LEAD_STATUS).forEach(function(k){ %><option value="<%= k %>" <%= lead.status === k ? 'selected' : '' %>><%= P.LEAD_STATUS[k].label %></option><% }) %></select></div>
      <div><label class="label" for="ld-agent">Opiekun</label><select id="ld-agent" name="assignedTo" class="select"><option value="">Nieprzypisane</option><% agents.forEach(function(a){ %><option value="<%= a.id %>" <%= lead.assignedTo && String(lead.assignedTo._id) === a.id ? 'selected' : '' %>><%= a.name %></option><% }) %></select></div>
      <div><label class="label" for="ld-pres">Termin prezentacji</label><input id="ld-pres" name="presentationAt" type="datetime-local" class="input" value="<%= fmt.inputDateTime(lead.presentationAt) %>"></div>
      <button class="btn btn-primary">Zapisz</button>
    </form>
    <div class="card card-pad text-sm">
      <p class="font-semibold">Dane klienta</p>
      <p class="mt-2 flex items-center gap-2"><%- icon('mail', 'ico-sm text-teal-500') %><span class="select-all"><%= lead.email %></span></p>
      <% if (lead.phone) { %><p class="mt-1 flex items-center gap-2"><%- icon('phone', 'ico-sm text-teal-500') %><span class="select-all"><%= lead.phone %></span></p><% } %>
      <p class="mt-1 flex items-center gap-2 text-muted"><%- icon('user', 'ico-sm') %><%= lead.fromUser ? 'Zalogowany użytkownik' : 'Gość' %></p>
    </div>
    <% if (lead.listing) { %>
    <a href="/oferta/<%= lead.listing.slug %>-<%= lead.listing.num %>" target="_blank" class="card overflow-hidden hover:shadow-soft">
      <div class="scene aspect-[16/10]"><% if (lead.listing.images && lead.listing.images[0]) { %><img src="<%= lead.listing.images[0].url %>" alt=""><% } else { %><%- art.sceneFor(lead.listing) %><% } %></div>
      <div class="p-4"><p class="font-semibold"><%= lead.listing.title %></p><p class="text-sm text-muted num"><%= fmt.price(lead.listing.price, lead.listing.transaction) %> · <%= lead.listing.cityName %></p></div>
    </a>
    <% } %>
  </aside>
</div>

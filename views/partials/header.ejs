<header class="sticky-top sticky z-50 border-b border-line bg-white">
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <div class="flex items-center gap-8">
      <%- include('logo') %>
      <nav class="hidden items-center gap-1 text-[15px] font-semibold text-navy-700 lg:flex" aria-label="Główne menu">
        <a href="/sprzedaz/mieszkania" class="rounded-lg px-3 py-2 hover:bg-paper <%= isActive('/sprzedaz') ? 'text-teal-600' : '' %>">Kupno</a>
        <a href="/wynajem/mieszkania" class="rounded-lg px-3 py-2 hover:bg-paper <%= isActive('/wynajem') ? 'text-teal-600' : '' %>">Wynajem</a>
        <a href="/sprzedaz/mieszkania?rynek=pierwotny" class="rounded-lg px-3 py-2 hover:bg-paper">Nowe mieszkania</a>
        <a href="/biura" class="rounded-lg px-3 py-2 hover:bg-paper <%= isActive('/biura') || isActive('/biuro') ? 'text-teal-600' : '' %>">Biura</a>
      </nav>
    </div>
    <div class="flex items-center gap-1">
      <a href="/panel/obserwowane" class="btn-icon relative text-navy-800" aria-label="Obserwowane">
        <%- icon('heart', 'ico') %>
        <span data-fav-count class="absolute right-1 top-1 grid h-4 min-w-[16px] place-items-center rounded-full bg-orange-500 px-1 text-[10px] font-bold text-white num" <%= user && user.favorites.length ? '' : 'hidden' %>><%= user ? user.favorites.length : 0 %></span>
      </a>
      <% if (user) { %>
      <details class="relative" data-dropdown>
        <summary class="btn btn-ghost cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <%- icon('user', 'ico') %><span class="hidden sm:inline">Moje konto</span>
        </summary>
        <div class="absolute right-0 mt-2 w-60 rounded-xl border border-line bg-white p-2 shadow-lift">
          <p class="truncate px-3.5 pb-2 pt-1 text-xs text-muted"><%= user.email %></p>
          <a href="/panel/ogloszenia" class="side-link">Moje ogłoszenia</a>
          <a href="/panel/obserwowane" class="side-link">Obserwowane</a>
          <a href="/panel/wiadomosci" class="side-link">Wiadomości</a>
          <a href="/panel/ustawienia" class="side-link">Ustawienia konta</a>
          <% if (user.agency) { %><a href="/biuro-panel" class="side-link border-t border-line">Panel biura</a><% } %>
          <% if (user.role === 'admin') { %><a href="/admin" class="side-link">Administracja</a><% } %>
          <form method="post" action="/wyloguj" class="mt-1 border-t border-line pt-1"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="side-link w-full">Wyloguj</button></form>
        </div>
      </details>
      <% } else { %>
      <a href="/logowanie" class="btn btn-ghost"><%- icon('user', 'ico') %><span class="hidden sm:inline">Zaloguj się</span></a>
      <% } %>
      <a href="<%= user && user.agency ? '/biuro-panel/ogloszenia/nowe' : '/panel/ogloszenia/nowe' %>" class="btn btn-outline ml-1 hidden !border-navy-800 sm:inline-flex">Dodaj ogłoszenie</a>
      <button type="button" class="btn-icon lg:hidden" data-toggle="#mobileMenu" aria-label="Menu" aria-expanded="false"><%- icon('menu', 'ico') %></button>
    </div>
  </div>
  <div id="mobileMenu" class="border-t border-line bg-white lg:hidden" hidden>
    <nav class="wrap grid gap-1 py-3">
      <a href="/sprzedaz/mieszkania" class="side-link">Kupno</a>
      <a href="/wynajem/mieszkania" class="side-link">Wynajem</a>
      <a href="/sprzedaz/mieszkania?rynek=pierwotny" class="side-link">Nowe mieszkania</a>
      <a href="/biura" class="side-link">Biura nieruchomości</a>
      <a href="/miasta" class="side-link">Miasta</a>
      <a href="/panel/ogloszenia/nowe" class="btn btn-accent mt-2">Dodaj ogłoszenie</a>
    </nav>
  </div>
</header>

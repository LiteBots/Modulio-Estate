<section class="wrap py-8">
  <%- include('../partials/breadcrumbs') %>
  <h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight">Mapa strony</h1>
</section>
<section class="wrap grid gap-6 pb-16 md:grid-cols-2 lg:grid-cols-4">
  <div class="card card-pad"><h2 class="font-display text-lg font-bold">Sprzedaż</h2><ul class="mt-3 grid gap-1.5 text-sm"><% P.TYPES.forEach(function(t){ %><li><a href="/sprzedaz/<%= t.slug %>" class="hover:text-teal-600"><%= t.sale %></a></li><% }) %></ul></div>
  <div class="card card-pad"><h2 class="font-display text-lg font-bold">Wynajem</h2><ul class="mt-3 grid gap-1.5 text-sm"><% P.TYPES.forEach(function(t){ %><li><a href="/wynajem/<%= t.slug %>" class="hover:text-teal-600"><%= t.rent %></a></li><% }) %></ul></div>
  <div class="card card-pad"><h2 class="font-display text-lg font-bold">Serwis</h2><ul class="mt-3 grid gap-1.5 text-sm"><% [['/miasta','Miasta'],['/biura','Biura nieruchomości'],['/raport-cen','Raport cen'],['/kalkulator-kredytowy','Kalkulator kredytowy'],['/poradnik','Poradnik'],['/zostan-partnerem','Zostań partnerem'],['/reklama','Reklama'],['/o-nas','O nas'],['/kontakt','Kontakt'],['/pomoc','Pomoc'],['/regulamin','Regulamin'],['/polityka-prywatnosci','Polityka prywatności'],['/cookies','Cookies']].forEach(function(x){ %><li><a href="<%= x[0] %>" class="hover:text-teal-600"><%= x[1] %></a></li><% }) %></ul></div>
  <div class="card card-pad"><h2 class="font-display text-lg font-bold">Poradnik</h2><ul class="mt-3 grid gap-1.5 text-sm"><% articles.forEach(function(a){ %><li><a href="/poradnik/<%= a.slug %>" class="hover:text-teal-600"><%= a.title %></a></li><% }) %></ul></div>
  <div class="card card-pad md:col-span-2 lg:col-span-4">
    <h2 class="font-display text-lg font-bold">Mieszkania na sprzedaż według miast</h2>
    <div class="mt-3 columns-2 gap-6 text-sm sm:columns-4 lg:columns-6"><a href="/sprzedaz/mieszkania/trojmiasto" class="block py-0.5 hover:text-teal-600">Trójmiasto</a><% LOC.CITIES.forEach(function(c){ %><a href="/sprzedaz/mieszkania/<%= c.slug %>" class="block py-0.5 hover:text-teal-600"><%= c.name %></a><% }) %></div>
  </div>
  <div class="card card-pad md:col-span-2 lg:col-span-4">
    <h2 class="font-display text-lg font-bold">Domy na sprzedaż według miast</h2>
    <div class="mt-3 columns-2 gap-6 text-sm sm:columns-4 lg:columns-6"><% LOC.CITIES.forEach(function(c){ %><a href="/sprzedaz/domy/<%= c.slug %>" class="block py-0.5 hover:text-teal-600"><%= c.name %></a><% }) %></div>
  </div>
</section>

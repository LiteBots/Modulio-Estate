<h1 class="font-display text-3xl font-extrabold">Ulubione</h1>
<p class="mt-1 text-muted"><%= listings.length %> <%= fmt.plural(listings.length, 'zapisana oferta', 'zapisane oferty', 'zapisanych ofert') %></p>
<% if (listings.length) { %>
<div class="mt-6 grid gap-5 sm:grid-cols-2 xl:grid-cols-3"><% listings.forEach(function(l){ %><div class="<%= ['active','reserved'].includes(l.status) ? '' : 'opacity-60' %>"><%- include('../partials/listing-card', { l: l }) %><% if (!['active','reserved'].includes(l.status)) { %><p class="mt-2 text-center text-sm text-muted">Oferta nieaktualna</p><% } %></div><% }) %></div>
<% } else { %>
<div class="card mt-6 p-10 text-center"><%- icon('heart', 'ico-lg mx-auto text-orange-400') %><p class="mt-3 font-display text-xl font-bold">Brak ulubionych</p><p class="mt-1 text-muted">Klikaj serduszko przy ofertach, aby je tu zebrać.</p><a href="/sprzedaz" class="btn btn-primary mt-5">Przeglądaj oferty</a></div>
<% } %>

<% var cities = ['gdansk','gdynia','sopot','slupsk','ustka','koszalin','kolobrzeg','szczecin','chojnice','bytow','miastko','lebork']; %>
<footer class="mt-auto border-t border-line bg-paper text-sm text-navy-600">
  <div class="wrap py-12">
    <div class="grid gap-10 md:grid-cols-4">
      <div>
        <%- include('logo') %>
        <p class="mt-4 max-w-xs text-muted">Ogłoszenia nieruchomości z województwa pomorskiego i zachodniopomorskiego.</p>
        <div class="mt-5 flex gap-2">
          <% [['facebook','Facebook'],['instagram','Instagram'],['linkedin','LinkedIn'],['tiktok','TikTok'],['youtube','YouTube']].forEach(function(s){ %>
          <a href="<%= site.socials[s[0]] %>" target="_blank" rel="noopener" aria-label="<%= s[1] %>" class="grid h-9 w-9 place-items-center rounded-lg border border-line bg-white text-navy-700 hover:border-navy-300"><%- icon(s[0], 'ico-sm') %></a>
          <% }) %>
        </div>
      </div>
      <div>
        <p class="mb-3 font-semibold text-navy-900">Mieszkania na sprzedaż</p>
        <ul class="grid gap-2"><% cities.slice(0, 6).forEach(function(c){ %><li><a href="/sprzedaz/mieszkania/<%= c %>" class="hover:text-teal-600"><%= cityName(c) %></a></li><% }) %></ul>
      </div>
      <div>
        <p class="mb-3 font-semibold text-navy-900">Mieszkania na wynajem</p>
        <ul class="grid gap-2"><% cities.slice(6).forEach(function(c){ %><li><a href="/wynajem/mieszkania/<%= c %>" class="hover:text-teal-600"><%= cityName(c) %></a></li><% }) %><li><a href="/miasta" class="font-semibold text-teal-600">Wszystkie miasta</a></li></ul>
      </div>
      <div>
        <p class="mb-3 font-semibold text-navy-900">ModulioEstate</p>
        <ul class="grid gap-2">
          <li><a href="/o-nas" class="hover:text-teal-600">O nas</a></li>
          <li><a href="/zostan-partnerem" class="hover:text-teal-600">Dla biur nieruchomości</a></li>
          <li><a href="/reklama" class="hover:text-teal-600">Reklama</a></li>
          <li><a href="/raport-cen" class="hover:text-teal-600">Ceny mieszkań</a></li>
          <li><a href="/kalkulator-kredytowy" class="hover:text-teal-600">Kalkulator kredytowy</a></li>
          <li><a href="/poradnik" class="hover:text-teal-600">Poradnik</a></li>
          <li><a href="/pomoc" class="hover:text-teal-600">Pomoc</a></li>
          <li><a href="/kontakt" class="hover:text-teal-600">Kontakt</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 flex flex-col gap-3 border-t border-line pt-6 text-xs text-muted md:flex-row md:items-center md:justify-between">
      <p>© <%= new Date().getFullYear() %> <%= site.name %> · <%= site.company.name %></p>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <a href="/regulamin" class="hover:text-navy-900">Regulamin</a>
        <a href="/polityka-prywatnosci" class="hover:text-navy-900">Polityka prywatności</a>
        <a href="/cookies" class="hover:text-navy-900">Cookies</a>
        <a href="/mapa-strony" class="hover:text-navy-900">Mapa strony</a>
        <a href="/kontakt#zgloszenia" class="hover:text-navy-900">Zgłoś nielegalne treści</a>
      </div>
    </div>
  </div>
</footer>

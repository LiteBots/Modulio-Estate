<%
  var v = function(k){ return l[k] === undefined || l[k] === null ? '' : l[k]; };
  var feats = (l.features || []).map(String);
  var isAgency = mode === 'agency';
  var allDistricts = {}; LOC.CITIES.forEach(function(c){ if (c.districts.length) allDistricts[c.slug] = c.districts; });
  var hasExtra = !!(l.bathrooms || l.buildingMaterial || l.windows || l.kitchen || l.parking || l.energyClass || l.balconyArea || l.ownership || l.roof || l.access || l.plotWidth || l.rentFor || l.minRentMonths || l.videoUrl || l.virtualTourUrl || l.deposit);
  var step = function(n, title, hint){ return '<div class="mb-5"><p class="text-[11px] font-bold uppercase tracking-[.16em] text-orange-600">Krok ' + n + ' z 7</p><h3 class="font-display text-xl font-bold" style="letter-spacing:-0.03em">' + title + '</h3>' + (hint ? '<p class="mt-0.5 text-sm text-muted">' + hint + '</p>' : '') + '</div>'; };
  var select = function(name, key, label, attrs){
    var o = '<label class="block" ' + (attrs || '') + '><span class="label">' + label + '</span><select name="' + name + '" class="select"><option value="">– wybierz –</option>';
    P.OPTIONS[key].forEach(function(x){ o += '<option' + (v(name) === x ? ' selected' : '') + '>' + x + '</option>'; });
    return o + '</select></label>';
  };
  var numIn = function(name, label, attrs, ph){ return '<label class="block" ' + (attrs || '') + '><span class="label">' + label + '</span><input name="' + name + '" inputmode="decimal" class="input num" value="' + fmt.escapeHtml(v(name)) + '"' + (ph ? ' placeholder="' + ph + '"' : '') + '></label>'; };
%>
<form method="post" action="<%= action %>" enctype="multipart/form-data" class="grid gap-5" data-listing-form data-districts='<%- JSON.stringify(allDistricts).replace(/'/g, "&#39;") %>'>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (errors && errors.length) { %>
  <div class="alert alert-error"><%- icon('alert', 'ico mt-px') %><div><p class="font-semibold">Popraw formularz:</p><ul class="mt-1 list-disc pl-5"><% errors.forEach(function(e){ %><li><%= e %></li><% }) %></ul></div></div>
  <% } %>

  <!-- 1 -->
  <section class="card p-5 sm:p-7">
    <%- step(1, 'Co chcesz ogłosić?') %>
    <div class="grid gap-4 sm:grid-cols-3">
      <div><span class="label">Transakcja *</span><div class="grid grid-cols-2 gap-2">
        <% [['sprzedaz','Sprzedaż'],['wynajem','Wynajem']].forEach(function(o){ %><label class="cursor-pointer"><input type="radio" name="transaction" value="<%= o[0] %>" class="peer sr-only" <%= v('transaction') === o[0] ? 'checked' : '' %> data-tr><span class="block rounded-[12px] border border-line py-2.5 text-center text-sm font-bold peer-checked:border-navy-800 peer-checked:bg-navy-800 peer-checked:text-white"><%= o[1] %></span></label><% }) %>
      </div></div>
      <div><span class="label">Rynek *</span><div class="grid grid-cols-2 gap-2">
        <% [['wtorny','Wtórny'],['pierwotny','Pierwotny']].forEach(function(o){ %><label class="cursor-pointer"><input type="radio" name="market" value="<%= o[0] %>" class="peer sr-only" <%= (v('market') || 'wtorny') === o[0] ? 'checked' : '' %>><span class="block rounded-[12px] border border-line py-2.5 text-center text-sm font-bold peer-checked:border-navy-800 peer-checked:bg-navy-800 peer-checked:text-white"><%= o[1] %></span></label><% }) %>
      </div></div>
      <label class="block"><span class="label">Typ ogłoszeniodawcy</span>
        <% if (isAgency) { %>
        <select name="advertiserType" class="select"><option value="biuro" <%= v('advertiserType') !== 'deweloper' ? 'selected' : '' %>>Biuro nieruchomości</option><option value="deweloper" <%= v('advertiserType') === 'deweloper' ? 'selected' : '' %>>Deweloper</option></select>
        <% } else { %>
        <input class="input bg-paper" value="Osoba prywatna" disabled><input type="hidden" name="advertiserType" value="prywatny">
        <% } %>
      </label>
    </div>
    <span class="label mt-5">Rodzaj nieruchomości *</span>
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
      <% P.TYPES.forEach(function(t){ %><label class="cursor-pointer"><input type="radio" name="type" value="<%= t.key %>" class="peer sr-only" <%= v('type') === t.key ? 'checked' : '' %> data-type><span class="flex items-center gap-2 rounded-[12px] border border-line bg-white px-3 py-2.5 text-sm font-semibold peer-checked:border-orange-500 peer-checked:ring-2 peer-checked:ring-orange-200"><%- icon(t.icon, 'ico-sm text-orange-600') %><%= t.label %></span></label><% }) %>
    </div>
  </section>

  <!-- 2 -->
  <section class="card p-5 sm:p-7">
    <%- step(2, 'Lokalizacja', 'Obsługujemy województwo pomorskie i zachodniopomorskie. Postaw pinezkę – kupujący zobaczą dokładne miejsce na mapie.') %>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block"><span class="label">Miejscowość *</span>
        <select name="city" required class="select" data-city>
          <option value="">Wybierz…</option>
          <optgroup label="Pomorskie"><% LOC.CITIES.filter(function(c){ return c.voivodeship === 'pomorskie'; }).sort(function(a,b){ return a.name.localeCompare(b.name, 'pl'); }).forEach(function(c){ %><option value="<%= c.slug %>" <%= v('city') === c.slug ? 'selected' : '' %>><%= c.name %></option><% }) %></optgroup>
          <optgroup label="Zachodniopomorskie"><% LOC.CITIES.filter(function(c){ return c.voivodeship === 'zachodniopomorskie'; }).sort(function(a,b){ return a.name.localeCompare(b.name, 'pl'); }).forEach(function(c){ %><option value="<%= c.slug %>" <%= v('city') === c.slug ? 'selected' : '' %>><%= c.name %></option><% }) %></optgroup>
        </select></label>
      <label class="block"><span class="label">Dzielnica, osiedle lub wieś</span><input name="district" list="districtList" class="input" value="<%= v('district') %>"><datalist id="districtList"></datalist></label>
      <label class="block sm:col-span-2"><span class="label">Ulica i numer</span>
        <span class="flex gap-2"><input name="street" class="input" value="<%= v('street') %>" placeholder="np. Wojska Polskiego 12"><button type="button" class="btn btn-primary shrink-0" data-pin-find><%- icon('map-pin', 'ico-sm') %><span class="hidden sm:inline">Znajdź na mapie</span></button></span></label>
    </div>
    <div class="mt-4 overflow-hidden rounded-[18px] border border-line">
      <div data-pin-map class="h-[320px] w-full"></div>
      <div class="flex flex-wrap items-center justify-between gap-2 border-t border-line bg-white px-4 py-2.5 text-sm">
        <p data-pin-msg class="text-muted">Kliknij na mapie, aby postawić pinezkę, albo wpisz adres i wybierz „Znajdź na mapie”.</p>
        <button type="button" class="text-sm font-semibold text-muted underline hover:text-ink" data-pin-clear>Usuń pinezkę</button>
      </div>
    </div>
    <input type="hidden" name="lat" value="<%= v('lat') %>"><input type="hidden" name="lng" value="<%= v('lng') %>">
    <label class="mt-4 flex items-center gap-2 text-sm"><input type="checkbox" name="showExactAddress" class="check" <%= l.showExactAddress !== false || isNew ? 'checked' : '' %>>Pokaż dokładny adres i pinezkę w ogłoszeniu (odznacz, aby pokazać tylko okolicę)</label>
  </section>

  <!-- 3 -->
  <section class="card p-5 sm:p-7">
    <%- step(3, 'Cena i koszty') %>
    <div class="grid gap-4 sm:grid-cols-3">
      <label class="block"><span class="label"><span data-price-label>Cena (zł)</span> *</span><input name="price" required inputmode="numeric" class="input num" value="<%= v('price') %>" data-price-input></label>
      <%- numIn('rentExtra', 'Czynsz administracyjny (zł/mc)', '', 'np. 650') %>
      <%- numIn('deposit', 'Kaucja (zł)', 'data-rent-only') %>
    </div>
    <p class="mt-2 text-sm text-muted" data-ppm></p>
    <div class="mt-3 flex flex-wrap gap-5 text-sm">
      <label class="flex items-center gap-2"><input type="checkbox" name="negotiable" class="check" <%= l.negotiable ? 'checked' : '' %>>Cena do negocjacji</label>
      <label class="flex items-center gap-2"><input type="checkbox" name="noCommission" class="check" <%= l.noCommission || (!isAgency && isNew) ? 'checked' : '' %>>Bez prowizji</label>
    </div>
  </section>

  <!-- 4 -->
  <section class="card p-5 sm:p-7">
    <%- step(4, 'Parametry nieruchomości') %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <label class="block"><span class="label">Metraż (m²) *</span><input name="area" inputmode="decimal" class="input num" value="<%= v('area') %>" data-area-input></label>
      <%- numIn('rooms', 'Liczba pokoi / pomieszczeń', 'data-hide-for="dzialka,garaz"') %>
      <%- numIn('bathrooms', 'Liczba łazienek', 'data-hide-for="dzialka,garaz,magazyn"') %>
      <%- numIn('floor', 'Piętro (0 = parter)', 'data-hide-for="dzialka,dom,garaz"') %>
      <%- numIn('floorsTotal', 'Liczba pięter w budynku', 'data-hide-for="dzialka,garaz"') %>
      <%- numIn('yearBuilt', 'Rok budowy', 'data-hide-for="dzialka"') %>
      <%- numIn('plotArea', 'Powierzchnia działki (m²)', 'data-show-for="dom,dzialka,magazyn"') %>
      <%- select('plotType', 'plotType', 'Rodzaj działki', 'data-show-for="dzialka"') %>
      <%- select('buildingType', 'buildingType', 'Rodzaj zabudowy', 'data-hide-for="dzialka"') %>
      <%- select('condition', 'condition', 'Stan wykończenia', 'data-hide-for="dzialka"') %>
      <%- select('heating', 'heating', 'Ogrzewanie', 'data-hide-for="dzialka,garaz"') %>
      <label class="block"><span class="label">Dostępne od</span><input name="availableFrom" type="date" class="input" value="<%= fmt.inputDate(l.availableFrom) %>"></label>
    </div>
  </section>

  <!-- 5 -->
  <section class="card p-5 sm:p-7">
    <%- step(5, 'Zdjęcia i multimedia', 'Ogłoszenia ze zdjęciami dostają kilka razy więcej wiadomości. Pierwsze zdjęcie będzie główne.') %>
    <% if (l.images && l.images.length) { %>
    <div class="mb-3 grid grid-cols-3 gap-2 sm:grid-cols-6">
      <% l.images.forEach(function(im, i){ %>
      <div class="overflow-hidden rounded-[12px] border border-line bg-white">
        <img src="<%= im.url %>" alt="" class="aspect-[4/3] w-full object-cover">
        <div class="grid gap-0.5 p-1.5 text-xs">
          <label class="flex items-center gap-1.5"><input type="checkbox" name="keepImages" value="<%= im.url %>" checked class="check">Zostaw</label>
          <label class="flex items-center gap-1.5"><input type="radio" name="cover" value="<%= im.url %>" <%= i === 0 ? 'checked' : '' %>>Główne</label>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
    <label class="flex cursor-pointer flex-col items-center justify-center gap-1.5 rounded-[18px] border-2 border-dashed border-navy-200 bg-white px-6 py-8 text-center hover:border-orange-400" data-dropzone>
      <%- icon('upload', 'ico-lg text-orange-500') %>
      <span class="font-bold">Wybierz lub przeciągnij zdjęcia</span>
      <span class="text-sm text-muted">JPG, PNG lub WEBP, do 10 MB każde · maks. <%= isAgency ? 40 : 30 %></span>
      <input type="file" name="images" accept="image/jpeg,image/png,image/webp,image/avif" multiple class="sr-only" data-file-input>
    </label>
    <div class="mt-3 grid grid-cols-3 gap-2 sm:grid-cols-6" data-file-preview></div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <label class="block"><span class="label">Film YouTube</span><input name="videoUrl" type="url" class="input" value="<%= v('videoUrl') %>" placeholder="https://www.youtube.com/watch?v=…"></label>
      <label class="block"><span class="label">Wirtualny spacer 3D</span><input name="virtualTourUrl" type="url" class="input" value="<%= v('virtualTourUrl') %>" placeholder="https://"></label>
    </div>
  </section>

  <!-- 6 -->
  <section class="card p-5 sm:p-7">
    <%- step(6, 'Tytuł i opis') %>
    <label class="block"><span class="label">Tytuł *</span><input name="title" required maxlength="140" class="input" value="<%= v('title') %>" placeholder="np. 3 pokoje z balkonem blisko plaży" data-count="140"><span class="hint" data-count-out></span></label>
    <label class="mt-4 block"><span class="label">Opis *</span><textarea name="description" required class="textarea !min-h-[200px]" maxlength="12000" data-count="12000" placeholder="Opisz układ, stan, okolicę (szkoła, przystanek, sklepy, odległość od morza) i koszty utrzymania. Min. 40 znaków."><%= v('description') %></textarea><span class="hint" data-count-out></span></label>
  </section>

  <!-- 7 -->
  <section class="card p-5 sm:p-7">
    <%- step(7, 'Dane kontaktowe') %>
    <div class="grid gap-4 sm:grid-cols-3">
      <% if (isAgency) { %>
      <label class="block"><span class="label">Opiekun oferty</span><select name="agent" class="select"><% agents.forEach(function(a){ %><option value="<%= a.id %>" <%= String(l.agent && l.agent._id ? l.agent._id : l.agent) === a.id ? 'selected' : '' %>><%= a.name %></option><% }) %></select></label>
      <label class="block"><span class="label">Nr oferty w biurze</span><input name="refNumber" class="input" value="<%= v('refNumber') %>"></label>
      <label class="block"><span class="label">Telefon (opcjonalnie)</span><input name="contactPhone" class="input" value="<%= v('contactPhone') %>"></label>
      <% } else { %>
      <label class="block"><span class="label">Imię</span><input name="contactName" class="input" value="<%= v('contactName') %>"></label>
      <label class="block"><span class="label">Telefon</span><input name="contactPhone" class="input" value="<%= v('contactPhone') %>"></label>
      <label class="block"><span class="label">E-mail</span><input name="contactEmail" type="email" class="input" value="<%= v('contactEmail') %>"></label>
      <% } %>
    </div>
  </section>

  <!-- Dodatkowe -->
  <details class="card" <%= hasExtra || feats.length ? 'open' : '' %>>
    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-5 sm:p-7 [&::-webkit-details-marker]:hidden">
      <span><span class="block font-display text-xl font-bold" style="letter-spacing:-0.03em">Więcej szczegółów i udogodnienia</span><span class="text-sm text-muted">Opcjonalne, ale lepiej opisane ogłoszenia częściej trafiają do wyników z filtrami</span></span>
      <span class="icon-box"><%- icon('chevron-down', 'ico-sm') %></span>
    </summary>
    <div class="border-t border-line p-5 sm:p-7">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <%- select('buildingMaterial', 'buildingMaterial', 'Materiał budynku', 'data-hide-for="dzialka"') %>
        <%- select('windows', 'windows', 'Okna', 'data-hide-for="dzialka"') %>
        <%- select('kitchen', 'kitchen', 'Kuchnia', 'data-hide-for="dzialka,garaz,magazyn"') %>
        <%- select('parking', 'parking', 'Miejsce parkingowe', 'data-hide-for="dzialka,garaz"') %>
        <%- numIn('balconyArea', 'Balkon / taras (m²)', 'data-hide-for="dzialka,garaz,magazyn"') %>
        <%- select('energyClass', 'energyClass', 'Klasa energetyczna', 'data-hide-for="dzialka"') %>
        <%- numIn('energyKwh', 'Zapotrzebowanie EP (kWh/m²·rok)', 'data-hide-for="dzialka"') %>
        <%- select('ownership', 'ownership', 'Forma własności') %>
        <%- select('roof', 'roof', 'Dach', 'data-show-for="dom,magazyn"') %>
        <%- select('access', 'access', 'Dojazd', 'data-show-for="dom,dzialka,magazyn"') %>
        <%- numIn('plotWidth', 'Szerokość działki (m)', 'data-show-for="dzialka"') %>
        <%- numIn('plotLength', 'Długość działki (m)', 'data-show-for="dzialka"') %>
        <%- select('rentFor', 'rentFor', 'Najem dla', 'data-rent-only') %>
        <%- numIn('minRentMonths', 'Minimalny okres najmu (mies.)', 'data-rent-only') %>
      </div>
      <% P.FEATURE_GROUPS.forEach(function(g){ %>
      <p class="label mt-6"><%= g[0] %></p>
      <div class="flex flex-wrap gap-2"><% g[1].forEach(function(k){ %><label class="chip cursor-pointer has-[:checked]:border-navy-800 has-[:checked]:bg-navy-800 has-[:checked]:text-white"><input type="checkbox" name="features" value="<%= k %>" class="sr-only" <%= feats.includes(k) ? 'checked' : '' %>><%= P.FEATURE_LABEL[k] %></label><% }) %></div>
      <% }) %>
    </div>
  </details>

  <div class="sticky bottom-0 z-20 -mx-1 flex flex-wrap items-center justify-between gap-2 rounded-[18px] border border-line bg-white/95 px-4 py-3 shadow-lift backdrop-blur" style="margin-bottom: env(safe-area-inset-bottom, 0px)">
    <p class="text-sm text-muted">Publikując, akceptujesz <a href="/regulamin" target="_blank" class="link">regulamin</a>.</p>
    <div class="flex gap-2">
      <% if (isNew || l.status === 'draft') { %><button name="saveAs" value="draft" class="btn btn-outline">Zapisz szkic</button><% } %>
      <button name="saveAs" value="publish" class="btn btn-accent"><%= isNew ? 'Opublikuj ogłoszenie' : 'Zapisz zmiany' %></button>
    </div>
  </div>
</form>

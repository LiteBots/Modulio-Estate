<h1 class="font-display text-3xl font-extrabold">Wiadomości</h1>
<div class="mt-5 inline-flex rounded-full bg-white p-1 ring-1 ring-line">
  <a href="/panel/wiadomosci" class="rounded-full px-4 py-2 text-sm font-semibold <%= box === 'wyslane' ? 'bg-navy-800 text-white' : 'text-muted' %>">Moje zapytania</a>
  <a href="/panel/wiadomosci?skrzynka=odebrane" class="rounded-full px-4 py-2 text-sm font-semibold <%= box === 'odebrane' ? 'bg-navy-800 text-white' : 'text-muted' %>">Do moich ogłoszeń</a>
</div>
<% if (items.length) { %>
<div class="card mt-6 divide-y divide-line">
  <% items.forEach(function(m){ var unreadMe = box === 'odebrane' ? !m.readBySeller : !m.readByClient; var st = P.LEAD_STATUS[m.status] || {}; %>
  <a href="/panel/wiadomosci/<%= m._id %>" class="flex items-center gap-4 p-4 hover:bg-paper">
    <span class="relative grid h-11 w-11 shrink-0 place-items-center rounded-full bg-teal-50 text-teal-600"><%- icon(m.listing ? 'home' : 'briefcase', 'ico') %><% if (unreadMe) { %><span class="absolute -right-0.5 -top-0.5 h-3 w-3 rounded-full border-2 border-white bg-orange-500"></span><% } %></span>
    <span class="min-w-0 flex-1"><span class="block truncate <%= unreadMe ? 'font-bold' : 'font-semibold' %>"><%= m.listing ? m.listing.title : (m.agency ? m.agency.name : 'Wiadomość') %></span><span class="block truncate text-sm text-muted"><%= box === 'odebrane' ? m.name + ': ' : '' %><%= (m.replies && m.replies.length ? m.replies[m.replies.length - 1].text : m.message) %></span></span>
    <span class="hidden shrink-0 sm:block"><span class="badge tone-<%= st.tone %>"><%= st.label %></span></span>
    <span class="shrink-0 text-xs text-muted"><%= fmt.timeAgo(m.updatedAt) %></span>
  </a>
  <% }) %>
</div>
<% } else { %>
<div class="card mt-6 p-10 text-center text-muted"><%= box === 'odebrane' ? 'Nikt jeszcze nie zapytał o Twoje ogłoszenia.' : 'Zapytania wysłane ze stron ofert pojawią się tutaj.' %></div>
<% } %>

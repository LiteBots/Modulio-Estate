<form action="/szukaj" method="get" class="w-full rounded-xl bg-white p-4 shadow-lift sm:p-5" data-hero-search>
  <input type="hidden" name="transakcja" value="sprzedaz" data-hs-tr>
  <input type="hidden" name="rynek" value="" data-hs-market disabled>
  <div class="mb-4 flex gap-6 border-b border-line" role="tablist">
    <button type="button" class="-mb-px border-b-2 border-navy-800 pb-2.5 font-semibold text-navy-900" data-hs-tab="sprzedaz" aria-selected="true">Kupno</button>
    <button type="button" class="-mb-px border-b-2 border-transparent pb-2.5 font-semibold text-muted hover:text-navy-900" data-hs-tab="wynajem" aria-selected="false">Wynajem</button>
  </div>
  <div class="grid gap-3 md:grid-cols-[1fr_1.4fr_1fr_auto]">
    <label class="block"><span class="label">Rodzaj nieruchomości</span>
      <select name="typ" class="select" data-hs-type>
        <% P.TYPES.forEach(function(t){ %><option value="<%= t.key %>" <%= t.key === 'mieszkanie' ? 'selected' : '' %>><%= t.plural %></option><% }) %>
        <option value="">Wszystkie</option>
      </select></label>
    <label class="block"><span class="label">Lokalizacja</span>
      <input name="q" list="cityList" autocomplete="off" placeholder="Wpisz miasto, np. Słupsk" class="input"></label>
    <label class="block"><span class="label" data-hs-price-label>Cena do</span>
      <select name="cena_do" class="select num" data-hs-price data-sale="300000,400000,500000,700000,900000,1200000,1500000,2000000" data-rent="1500,2000,2500,3000,4000,5000,7000">
        <option value="">Dowolna</option><% [300000,400000,500000,700000,900000,1200000,1500000,2000000].forEach(function(v){ %><option value="<%= v %>"><%= fmt.shortPrice(v) %> zł</option><% }) %>
      </select></label>
    <button class="btn btn-accent self-end !py-3 md:px-8"><%- icon('search', 'ico-sm') %>Szukaj</button>
  </div>
  <datalist id="cityList"><option value="Trójmiasto"></option><% LOC.CITIES.forEach(function(c){ %><option value="<%= c.name %>"></option><% }) %></datalist>
</form>

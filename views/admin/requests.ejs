<div class="flex flex-wrap items-end justify-between gap-4">
  <h1 class="font-display text-3xl font-extrabold">Zgłoszenia z formularzy</h1>
  <form method="get" class="flex gap-2" data-autosubmit>
    <select name="typ" class="select !w-auto text-sm"><option value="">Wszystkie typy</option><% ['biuro','deweloper','reklama','inne'].forEach(function(t){ %><option <%= query.typ === t ? 'selected' : '' %>><%= t %></option><% }) %></select>
    <select name="status" class="select !w-auto text-sm"><option value="">Każdy status</option><% ['nowe','kontakt','umowa','odrzucone'].forEach(function(t){ %><option <%= query.status === t ? 'selected' : '' %>><%= t %></option><% }) %></select>
  </form>
</div>
<div class="mt-6 grid gap-3">
  <% items.forEach(function(p){ %>
  <form method="post" action="/admin/zgloszenia/<%= p._id %>" class="card p-5">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div><div class="flex items-center gap-2"><span class="badge tone-info"><%= p.kind %></span><span class="text-xs text-muted"><%= fmt.dateTime(p.createdAt) %></span></div>
        <p class="mt-2 font-display text-lg font-bold"><%= p.company || p.name %></p>
        <p class="text-sm text-muted"><%= p.name %> · <span class="select-all"><%= p.email %></span> · <span class="select-all"><%= p.phone || '' %></span> · <%= p.city || '' %></p>
        <% if (p.agentsCount || p.listingsCount) { %><p class="text-sm text-muted">Agenci: <%= p.agentsCount || '–' %> · oferty: <%= p.listingsCount || '–' %></p><% } %>
        <% if (p.interests && p.interests.length) { %><div class="mt-2 flex flex-wrap gap-1"><% p.interests.forEach(function(i){ %><span class="badge tone-muted"><%= P.AD_PLACEMENTS[i] ? P.AD_PLACEMENTS[i].label : i %></span><% }) %></div><% } %>
      </div>
      <select name="status" class="select !w-auto text-sm"><% ['nowe','kontakt','umowa','odrzucone'].forEach(function(s){ %><option <%= p.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select>
    </div>
    <% if (p.message) { %><p class="mt-3 whitespace-pre-line rounded-2xl bg-paper p-3 text-sm"><%= p.message %></p><% } %>
    <textarea name="adminNotes" class="textarea mt-3 !min-h-[70px] text-sm" placeholder="Notatki wewnętrzne"><%= p.adminNotes || '' %></textarea>
    <div class="mt-3 flex flex-wrap gap-2"><button class="btn btn-primary btn-sm">Zapisz</button><% if (['biuro','deweloper'].includes(p.kind) && !p.agency) { %><button name="action" value="create-agency" class="btn btn-accent btn-sm"><%- icon('plus', 'ico-sm') %>Utwórz biuro z tego zgłoszenia</button><% } %><% if (p.agency) { %><a href="/admin/biura/<%= p.agency %>" class="btn btn-outline btn-sm">Biuro utworzone</a><% } %></div>
  </form>
  <% }) %>
  <% if (!items.length) { %><div class="card p-10 text-center text-muted">Brak zgłoszeń.</div><% } %>
</div>

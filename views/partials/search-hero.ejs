<form action="/szukaj" method="get" class="w-full" data-hero-search>
  <input type="hidden" name="transakcja" value="sprzedaz" data-hs-tr>
  <input type="hidden" name="rynek" value="" data-hs-market disabled>
  <div class="flex gap-1 overflow-x-auto hide-scrollbar" role="tablist">
    <button type="button" class="rounded-t-2xl bg-white px-5 py-2.5 text-sm font-bold text-navy-800" data-hs-tab="sprzedaz" aria-selected="true">Kupno</button>
    <button type="button" class="rounded-t-2xl px-5 py-2.5 text-sm font-bold text-white/85 hover:text-white" data-hs-tab="wynajem" aria-selected="false">Wynajem</button>
    <button type="button" class="rounded-t-2xl px-5 py-2.5 text-sm font-bold text-white/85 hover:text-white" data-hs-tab="pierwotny" aria-selected="false">Rynek pierwotny</button>
    <button type="button" class="rounded-t-2xl px-5 py-2.5 text-sm font-bold text-white/85 hover:text-white" data-hs-tab="komercyjne" aria-selected="false">Komercyjne</button>
  </div>
  <div class="grid gap-2 rounded-b-[1.75rem] rounded-tr-[1.75rem] bg-white p-2.5 shadow-lift md:grid-cols-[1.6fr_1fr_1fr_1fr_auto]">
    <label class="flex min-w-0 items-center gap-3 rounded-2xl px-4 py-3 hover:bg-paper">
      <%- icon('map-pin', 'ico shrink-0 text-teal-500') %>
      <span class="min-w-0 flex-1">
        <span class="block text-[11px] font-bold uppercase tracking-wider text-muted">Lokalizacja</span>
        <input name="q" list="cityList" autocomplete="off" placeholder="np. Słupsk, Gdańsk Oliwa, Koszalin" class="w-full bg-transparent font-semibold text-navy-900 outline-none placeholder:font-normal placeholder:text-navy-300">
      </span>
    </label>
    <label class="flex flex-col justify-center rounded-2xl px-4 py-3 hover:bg-paper md:border-l md:border-line">
      <span class="text-[11px] font-bold uppercase tracking-wider text-muted">Rodzaj</span>
      <select name="typ" class="cursor-pointer bg-transparent font-semibold outline-none" data-hs-type>
        <option value="">Wszystkie</option>
        <% P.TYPES.forEach(function(t){ %><option value="<%= t.key %>" <%= t.key === 'mieszkanie' ? 'selected' : '' %>><%= t.plural %></option><% }) %>
      </select>
    </label>
    <label class="flex flex-col justify-center rounded-2xl px-4 py-3 hover:bg-paper md:border-l md:border-line">
      <span class="text-[11px] font-bold uppercase tracking-wider text-muted" data-hs-price-label>Cena do</span>
      <select name="cena_do" class="cursor-pointer bg-transparent font-semibold outline-none num" data-hs-price
        data-sale="300000,400000,500000,700000,900000,1200000,1500000,2000000,3000000"
        data-rent="1500,2000,2500,3000,4000,5000,7000,10000"><option value="">Dowolna</option><% [300000,400000,500000,700000,900000,1200000,1500000,2000000,3000000].forEach(function(v){ %><option value="<%= v %>"><%= fmt.shortPrice(v) %> zł</option><% }) %></select>
    </label>
    <label class="flex flex-col justify-center rounded-2xl px-4 py-3 hover:bg-paper md:border-l md:border-line">
      <span class="text-[11px] font-bold uppercase tracking-wider text-muted">Pokoje</span>
      <select name="pokoje_od" class="cursor-pointer bg-transparent font-semibold outline-none">
        <option value="">Dowolnie</option><option value="1">1+</option><option value="2">2+</option><option value="3">3+</option><option value="4">4+</option>
      </select>
    </label>
    <button class="btn btn-accent btn-lg rounded-2xl"><%- icon('search', 'ico') %>Szukaj</button>
  </div>
  <datalist id="cityList">
    <option value="Trójmiasto"></option>
    <% LOC.CITIES.forEach(function(c){ %><option value="<%= c.name %>"></option><% }) %>
  </datalist>
</form>

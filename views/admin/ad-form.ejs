<%
  var has = function (arr, v) { return (arr || []).map(String).indexOf(String(v)) !== -1; };
  var area = ad.area || {};
  var sortedCities = LOC.CITIES.slice().sort(function(x,y){ return x.name.localeCompare(y.name, 'pl'); });
%>
<a href="/admin/reklamy" class="text-sm font-semibold text-muted hover:text-navy-900">← Kampanie</a>
<div class="mt-2 flex flex-wrap items-end justify-between gap-3">
  <h1 class="font-display text-3xl font-extrabold"><%= isNew ? 'Nowa kampania' : ad.name %></h1>
  <% if (!isNew) { %><p class="text-sm text-muted num"><%= fmt.num(ad.impressions || 0) %> wyświetleń · <%= fmt.num(ad.clicks || 0) %> kliknięć</p><% } %>
</div>

<form method="post" action="<%= isNew ? '/admin/reklamy/nowa' : '/admin/reklamy/' + ad._id %>" enctype="multipart/form-data" class="mt-6 grid gap-6 xl:grid-cols-[1fr_340px]" data-ad-form>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="grid content-start gap-6">

    <section class="card card-pad grid gap-4">
      <h2 class="flex items-center gap-2 font-display text-lg font-bold"><span class="grid h-7 w-7 place-items-center rounded-lg bg-navy-800 text-sm text-white">1</span>Kampania i kreacja</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        <div><label class="label" for="ad-name">Nazwa kampanii</label><input id="ad-name" name="name" required class="input" value="<%= ad.name || '' %>"></div>
        <div><label class="label" for="ad-adv">Reklamodawca</label><input id="ad-adv" name="advertiser" class="input" value="<%= ad.advertiser || '' %>"></div>
        <div><label class="label" for="ad-mail">E-mail reklamodawcy</label><input id="ad-mail" name="advertiserEmail" type="email" class="input" value="<%= ad.advertiserEmail || '' %>"></div>
      </div>
      <div><label class="label" for="ad-url">Adres docelowy</label><input id="ad-url" name="url" type="url" class="input" value="<%= ad.url || '' %>" placeholder="https://"></div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div><label class="label">Grafika</label><% if (ad.image) { %><img src="<%= ad.image %>" alt="" class="mb-2 max-h-32 rounded-2xl"><label class="mb-2 flex items-center gap-2 text-sm"><input type="checkbox" name="removeImage" value="1" class="check">Usuń grafikę (użyj banera tekstowego)</label><% } %><input type="file" name="image" accept="image/*" class="text-sm"><input name="imageUrl" class="input mt-2 text-sm" placeholder="…lub adres grafiki https://"></div>
        <div><label class="label">Grafika na telefon (opcjonalnie)</label><% if (ad.imageMobile) { %><img src="<%= ad.imageMobile %>" alt="" class="mb-2 max-h-32 rounded-2xl"><% } %><input type="file" name="imageMobile" accept="image/*" class="text-sm"><p class="hint">Rozmiary miejsc są podane przy każdym miejscu poniżej.</p></div>
      </div>
      <p class="text-sm text-muted">Bez grafiki wyświetli się baner tekstowy z pól poniżej. W miejscu „Przy racie kredytu” najlepiej działa krótki tekst.</p>
      <div class="grid gap-4 sm:grid-cols-3">
        <div><label class="label" for="ad-h">Nagłówek</label><input id="ad-h" name="headline" class="input" value="<%= ad.headline || '' %>" placeholder="Rata od 3 900 zł"></div>
        <div><label class="label" for="ad-t">Tekst</label><input id="ad-t" name="text" class="input" value="<%= ad.text || '' %>" placeholder="Sprawdź zdolność w 15 minut"></div>
        <div><label class="label" for="ad-c">Przycisk</label><input id="ad-c" name="cta" class="input" value="<%= ad.cta || '' %>" placeholder="Sprawdź"></div>
      </div>
    </section>

    <section class="card card-pad">
      <div class="flex flex-wrap items-center justify-between gap-2"><h2 class="flex items-center gap-2 font-display text-lg font-bold"><span class="grid h-7 w-7 place-items-center rounded-lg bg-navy-800 text-sm text-white">2</span>Gdzie wyświetlać</h2><p class="text-sm text-muted">wybrano <b data-ad-count><%= (ad.placements || []).length %></b> z <%= Object.keys(P.AD_PLACEMENTS).length %> miejsc</p></div>
      <div class="mt-4 grid gap-5">
        <% P.AD_GROUPS.forEach(function(g){ var keys = Object.keys(P.AD_PLACEMENTS).filter(function(k){ return P.AD_PLACEMENTS[k].group === g; }); %>
        <div>
          <p class="mb-2 text-[11px] font-bold uppercase tracking-widest text-muted"><%= g %></p>
          <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            <% keys.forEach(function(k){ var on = has(ad.placements, k); %>
            <label class="flex cursor-pointer items-start gap-3 rounded-[14px] border border-line bg-white p-3 transition has-[:checked]:border-orange-500 has-[:checked]:bg-orange-50">
              <input type="checkbox" name="placements" value="<%= k %>" class="check mt-0.5" <%= on ? 'checked' : '' %>>
              <span><span class="block text-sm font-semibold leading-snug"><%= P.AD_PLACEMENTS[k].short %></span><span class="block text-xs text-muted"><%= P.AD_PLACEMENTS[k].size %></span></span>
            </label>
            <% }) %>
          </div>
        </div>
        <% }) %>
      </div>
    </section>

    <section class="card card-pad grid gap-5">
      <h2 class="flex items-center gap-2 font-display text-lg font-bold"><span class="grid h-7 w-7 place-items-center rounded-lg bg-navy-800 text-sm text-white">3</span>Komu wyświetlać</h2>
      <div>
        <p class="label">Obszar na mapie</p>
        <div class="overflow-hidden rounded-[16px] border border-line"><div data-ad-area-map class="h-[340px] w-full"></div></div>
        <div class="mt-3 grid gap-3 sm:grid-cols-[1fr_140px_auto] sm:items-end">
          <div><label class="label" for="ad-area-city">Środek obszaru (miasto)</label><select id="ad-area-city" class="select" data-ad-area-city><option value="">– kliknij na mapie albo wybierz miasto –</option><% sortedCities.forEach(function(c){ %><option value="<%= c.slug %>"><%= c.name %></option><% }) %></select></div>
          <div><label class="label" for="ad-area-km">Promień (km)</label><input id="ad-area-km" name="areaRadius" type="number" min="1" max="300" class="input" value="<%= area.radiusKm || '' %>"></div>
          <button type="button" class="btn btn-outline" data-ad-area-clear>Bez obszaru</button>
        </div>
        <input type="hidden" name="areaLat" value="<%= area.lat || '' %>"><input type="hidden" name="areaLng" value="<%= area.lng || '' %>"><input type="hidden" name="areaLabel" value="<%= area.label || '' %>">
        <p class="hint" data-ad-area-info></p>
      </div>
      <div class="grid gap-5 lg:grid-cols-2">
        <div><span class="label">Województwa (puste = oba)</span><div class="flex flex-wrap gap-4 text-sm"><% ['pomorskie','zachodniopomorskie'].forEach(function(v){ %><label class="flex items-center gap-2"><input type="checkbox" name="voivodeships" value="<%= v %>" class="check" <%= has(ad.voivodeships, v) ? 'checked' : '' %>><%= v %></label><% }) %></div></div>
        <div><span class="label">Transakcja (puste = obie)</span><div class="flex flex-wrap gap-4 text-sm"><% [['sprzedaz','Sprzedaż'],['wynajem','Wynajem']].forEach(function(t){ %><label class="flex items-center gap-2"><input type="checkbox" name="transactions" value="<%= t[0] %>" class="check" <%= has(ad.transactions, t[0]) ? 'checked' : '' %>><%= t[1] %></label><% }) %></div></div>
        <div class="lg:col-span-2"><span class="label">Rodzaj nieruchomości (puste = wszystkie)</span><div class="flex flex-wrap gap-x-5 gap-y-2 text-sm"><% P.TYPES.forEach(function(t){ %><label class="flex items-center gap-2"><input type="checkbox" name="types" value="<%= t.key %>" class="check" <%= has(ad.types, t.key) ? 'checked' : '' %>><%= t.plural %></label><% }) %></div></div>
        <div><span class="label">Rynek (puste = oba)</span><div class="flex flex-wrap gap-4 text-sm"><% [['pierwotny','Pierwotny'],['wtorny','Wtórny']].forEach(function(t){ %><label class="flex items-center gap-2"><input type="checkbox" name="markets" value="<%= t[0] %>" class="check" <%= has(ad.markets, t[0]) ? 'checked' : '' %>><%= t[1] %></label><% }) %></div></div>
        <div><span class="label">Urządzenia (puste = wszystkie)</span><div class="flex flex-wrap gap-4 text-sm"><% [['desktop','Komputer'],['mobile','Telefon']].forEach(function(t){ %><label class="flex items-center gap-2"><input type="checkbox" name="devices" value="<%= t[0] %>" class="check" <%= has(ad.devices, t[0]) ? 'checked' : '' %>><%= t[1] %></label><% }) %></div></div>
        <div class="grid grid-cols-2 gap-3"><div><label class="label" for="ad-pmin">Cena oferty od (zł)</label><input id="ad-pmin" name="priceMin" inputmode="numeric" class="input" value="<%= ad.priceMin || '' %>"></div><div><label class="label" for="ad-pmax">do (zł)</label><input id="ad-pmax" name="priceMax" inputmode="numeric" class="input" value="<%= ad.priceMax || '' %>"></div></div>
        <div><label class="label" for="ad-cities">Konkretne miasta (puste = wszystkie)</label><select id="ad-cities" name="cities" multiple size="6" class="select"><% sortedCities.forEach(function(c){ %><option value="<%= c.slug %>" <%= has(ad.cities, c.slug) ? 'selected' : '' %>><%= c.name %></option><% }) %></select></div>
      </div>
      <p class="hint">Rodzaj, transakcja, rynek i cena działają tam, gdzie strona je zna: w ogłoszeniu i w wynikach wyszukiwania. Kampania z takim kierowaniem nie pojawi się na stronie głównej.</p>
    </section>
  </div>

  <div class="grid content-start gap-6">
    <section class="card card-pad grid gap-4">
      <h2 class="font-display text-lg font-bold">Harmonogram</h2>
      <div class="grid grid-cols-2 gap-3"><div><label class="label" for="ad-s">Start</label><input id="ad-s" name="startsAt" type="date" class="input" value="<%= fmt.inputDate(ad.startsAt) %>"></div><div><label class="label" for="ad-e">Koniec</label><input id="ad-e" name="endsAt" type="date" class="input" value="<%= fmt.inputDate(ad.endsAt) %>"></div></div>
      <div><span class="label">Dni tygodnia (puste = codziennie)</span><div class="flex flex-wrap gap-2 text-sm"><% P.AD_DAYS.forEach(function(d){ %><label class="flex items-center gap-1.5 rounded-full border border-line bg-white px-3 py-1.5 has-[:checked]:border-navy-800 has-[:checked]:bg-navy-800 has-[:checked]:text-white"><input type="checkbox" name="days" value="<%= d[0] %>" class="sr-only" <%= has(ad.days, d[0]) ? 'checked' : '' %>><%= d[1] %></label><% }) %></div></div>
      <div class="grid grid-cols-2 gap-3"><div><label class="label" for="ad-hf">Od godziny</label><input id="ad-hf" name="hourFrom" type="number" min="0" max="23" class="input" value="<%= ad.hourFrom === undefined || ad.hourFrom === null ? '' : ad.hourFrom %>" placeholder="np. 6"></div><div><label class="label" for="ad-ht">Do godziny</label><input id="ad-ht" name="hourTo" type="number" min="1" max="24" class="input" value="<%= ad.hourTo === undefined || ad.hourTo === null ? '' : ad.hourTo %>" placeholder="np. 23"></div></div>
    </section>
    <section class="card card-pad grid gap-4">
      <h2 class="font-display text-lg font-bold">Limity i priorytet</h2>
      <div><label class="label" for="ad-cap">Maks. wyświetleń na osobę dziennie</label><input id="ad-cap" name="maxPerDayPerVisitor" type="number" min="1" max="100" class="input" value="<%= ad.maxPerDayPerVisitor || '' %>" placeholder="bez limitu"></div>
      <div><label class="label" for="ad-max">Limit wyświetleń kampanii</label><input id="ad-max" name="maxImpressions" type="number" min="1" class="input" value="<%= ad.maxImpressions || '' %>" placeholder="bez limitu"></div>
      <div><label class="label" for="ad-pr">Priorytet w rotacji (1–10)</label><input id="ad-pr" name="priority" type="number" min="1" max="10" class="input" value="<%= ad.priority || 1 %>"><p class="hint">Gdy w jednym miejscu jest kilka kampanii, wyższy priorytet wyświetla się częściej.</p></div>
    </section>
    <section class="card card-pad grid gap-4">
      <h2 class="font-display text-lg font-bold">Rozliczenie</h2>
      <div><label class="label" for="ad-bill">Model</label><select id="ad-bill" name="billing" class="select"><% Object.keys(P.AD_BILLING).forEach(function(b){ %><option value="<%= b %>" <%= (ad.billing || 'flat') === b ? 'selected' : '' %>><%= P.AD_BILLING[b] %></option><% }) %></select></div>
      <div><label class="label" for="ad-price">Cena (zł)</label><input id="ad-price" name="price" inputmode="decimal" class="input" value="<%= ad.price || '' %>" placeholder="np. 450"></div>
      <div><label class="label" for="ad-notes">Notatki (umowa, faktury)</label><textarea id="ad-notes" name="notes" class="textarea !min-h-[80px]"><%= ad.notes || '' %></textarea></div>
    </section>
    <section class="rounded-xl bg-navy-800 p-5 text-white">
      <label class="flex items-center gap-2 text-sm font-semibold"><input type="checkbox" name="active" class="check" <%= ad.active ? 'checked' : '' %>>Kampania aktywna</label>
      <div class="mt-4 grid gap-2">
        <button class="btn btn-accent w-full" name="action" value="save"><%- icon('check', 'ico-sm') %>Zapisz kampanię</button>
        <button class="btn btn-white w-full" name="action" value="save-stay">Zapisz i zostań</button>
        <% if (!isNew) { %>
        <button name="action" value="reset-stats" class="btn btn-ghost w-full !text-white/80" data-confirm="Wyzerować wyświetlenia i kliknięcia tej kampanii?">Wyzeruj statystyki</button>
        <button name="action" value="delete" class="btn btn-ghost w-full !text-red-300" data-confirm="Usunąć kampanię?">Usuń kampanię</button>
        <% } %>
      </div>
    </section>
  </div>
</form>

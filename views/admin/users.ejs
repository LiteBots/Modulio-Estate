<div class="flex flex-wrap items-end justify-between gap-4"><h1 class="font-display text-3xl font-extrabold">Użytkownicy</h1>
  <form method="get" class="flex flex-wrap gap-2"><select name="rola" class="select !w-auto text-sm" data-autosubmit-field><option value="">Każda rola</option><option value="user" <%= query.rola === 'user' ? 'selected' : '' %>>Użytkownik</option><option value="agent" <%= query.rola === 'agent' ? 'selected' : '' %>>Agent biura</option><option value="admin" <%= query.rola === 'admin' ? 'selected' : '' %>>Administrator</option></select><input name="q" class="input min-w-0 flex-1 text-sm sm:!w-56 sm:flex-none" placeholder="E-mail lub nazwisko" value="<%= query.q || '' %>"><button class="btn btn-outline btn-sm"><%- icon('search', 'ico-sm') %></button></form></div>
<div class="card mt-6 overflow-hidden"><div class="table-wrap"><table class="table">
  <thead><tr><th>Użytkownik</th><th>Biuro</th><th>Logowanie</th><th>Rejestracja</th><th>Rola / blokada</th></tr></thead>
  <tbody><% users.forEach(function(u){ %>
    <tr><td><p class="font-semibold"><%= u.name || '–' %></p><p class="text-xs text-muted select-all"><%= u.email %></p></td><td class="text-sm"><%= u.agency ? u.agency.name : '–' %></td><td class="text-sm text-muted"><%= u.googleId ? 'Google' : '' %><%= u.googleId && u.passwordHash ? ' + ' : '' %><%= u.passwordHash ? 'hasło' : '' %><br><%= u.lastLoginAt ? fmt.timeAgo(u.lastLoginAt) : '' %></td><td class="whitespace-nowrap text-sm text-muted"><%= fmt.dateShort(u.createdAt) %></td>
      <td><form method="post" action="/admin/uzytkownicy/<%= u._id %>" class="flex items-center gap-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="role" class="select !w-auto !py-1.5 text-sm" aria-label="Rola"><option value="user" <%= u.role === 'user' ? 'selected' : '' %>>użytkownik</option><option value="agent" <%= u.role === 'agent' ? 'selected' : '' %>>agent</option><option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option></select><label class="flex items-center gap-1 text-xs"><input type="checkbox" name="blocked" class="check" <%= u.blocked ? 'checked' : '' %>>blokada</label><button class="btn btn-outline btn-sm">Zapisz</button></form></td></tr>
  <% }) %></tbody>
</table></div></div>

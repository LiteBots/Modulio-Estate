<%
  var imgs = l.images || [];
  var specs = [];
  if (l.area) specs.push(['ruler', 'Powierzchnia', fmt.num(l.area, l.area % 1 ? 1 : 0) + ' m²']);
  if (l.rooms) specs.push(['door', 'Pokoje', l.rooms]);
  if (l.floor !== undefined && l.floor !== null) specs.push(['layers', 'Piętro', fmt.floorLabel(l.floor, l.floorsTotal)]);
  if (l.yearBuilt) specs.push(['calendar', 'Rok budowy', l.yearBuilt]);
  if (l.plotArea) specs.push(['trees', 'Działka', fmt.num(l.plotArea) + ' m²']);
  if (l.rentExtra) specs.push(['banknote', l.transaction === 'wynajem' ? 'Opłaty' : 'Czynsz', fmt.num(l.rentExtra) + ' zł/mc']);
  var details = [
    ['Rodzaj', t.label], ['Transakcja', l.transaction === 'wynajem' ? 'Wynajem' : 'Sprzedaż'], ['Rynek', P.MARKETS[l.market]],
    ['Typ budynku', l.buildingType], ['Stan', l.condition], ['Ogrzewanie', l.heating], ['Forma własności', l.ownership], ['Rodzaj działki', l.plotType],
    ['Kaucja', l.deposit ? fmt.num(l.deposit) + ' zł' : null], ['Dostępne od', l.availableFrom ? fmt.date(l.availableFrom) : null],
    ['Numer oferty', l.num + (l.refNumber ? ' / ' + l.refNumber : '')], ['Dodano', fmt.date(l.publishedAt || l.createdAt)], ['Aktualizacja', fmt.date(l.updatedAt)]
  ].filter(function(d){ return d[1]; });
  var inactive = l.status !== 'active' && l.status !== 'reserved';
  var ytId = l.videoUrl && (l.videoUrl.match(/(?:youtu\.be\/|v=|shorts\/)([\w-]{11})/) || [])[1];
%>
<div class="wrap pt-6">
  <%- include('../partials/breadcrumbs') %>

  <% if (canManage) { %>
  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-navy-800 px-4 py-3 text-sm text-white">
    <span class="flex items-center gap-2"><%- icon('eye', 'ico-sm') %>Podgląd Twojej oferty · status: <b><%= P.LISTING_STATUS[l.status].label %></b> · <span class="num"><%= fmt.num(l.views) %></span> wyświetleń</span>
    <a href="<%= l.agency ? '/biuro-panel/ogloszenia/' + l._id + '/edytuj' : '/panel/ogloszenia/' + l._id + '/edytuj' %>" class="btn btn-white btn-sm"><%- icon('edit', 'ico-sm') %>Edytuj</a>
  </div>
  <% } %>
  <% if (inactive) { %>
  <div class="alert alert-info mt-4"><%- icon('info', 'ico') %><span>To ogłoszenie jest nieaktualne (<%= P.LISTING_STATUS[l.status].label.toLowerCase() %>). Zobacz <a href="/<%= l.transaction %>/<%= t.slug %>/<%= l.city %>" class="font-semibold underline">podobne oferty w <%= city ? city.loc : l.cityName %></a>.</span></div>
  <% } %>

  <!-- GALERIA -->
  <section class="mt-5 grid gap-2 overflow-hidden rounded-[2rem] md:h-[520px] md:grid-cols-4 md:grid-rows-2" data-gallery>
    <% if (imgs.length) { %>
      <% imgs.slice(0, 5).forEach(function(im, i){ %>
      <button type="button" data-gallery-open="<%= i %>" class="group relative overflow-hidden bg-sand <%= i === 0 ? 'aspect-[4/3] md:col-span-2 md:row-span-2 md:aspect-auto' : 'hidden md:block' %>">
        <img src="<%= im.url %>" alt="<%= l.title %> – zdjęcie <%= i + 1 %>" <%= i ? 'loading="lazy"' : 'fetchpriority="high"' %> class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]">
        <% if (i === 4 && imgs.length > 5) { %><span class="absolute inset-0 grid place-items-center bg-navy-950/55 font-display text-xl font-bold text-white">+<%= imgs.length - 5 %> zdjęć</span><% } %>
      </button>
      <% }) %>
    <% } else { %>
      <div class="scene aspect-[4/3] md:col-span-4 md:row-span-2 md:aspect-auto"><%- art.sceneFor(l) %></div>
    <% } %>
  </section>
  <% if (imgs.length) { %>
  <div class="mt-3 flex gap-2">
    <button type="button" data-gallery-open="0" class="btn btn-outline btn-sm"><%- icon('camera', 'ico-sm') %>Wszystkie zdjęcia (<%= imgs.length %>)</button>
    <% if (l.virtualTourUrl) { %><a href="<%= l.virtualTourUrl %>" target="_blank" rel="noopener" class="btn btn-outline btn-sm"><%- icon('compass', 'ico-sm') %>Spacer 3D</a><% } %>
    <% if (ytId) { %><a href="#wideo" class="btn btn-outline btn-sm"><%- icon('play', 'ico-sm') %>Wideo</a><% } %>
  </div>
  <% } %>
</div>

<div class="wrap grid gap-8 pb-16 pt-8 lg:grid-cols-[1fr_380px]">
  <article class="min-w-0">
    <div class="flex flex-wrap gap-2">
      <span class="badge tone-info"><%= l.transaction === 'wynajem' ? 'Wynajem' : 'Sprzedaż' %></span>
      <span class="badge tone-teal"><%= t.label %></span>
      <% if (l.market === 'pierwotny') { %><span class="badge tone-orange">Rynek pierwotny</span><% } %>
      <% if (l.noCommission) { %><span class="badge tone-good">Bez prowizji</span><% } %>
      <% if (l.status === 'reserved') { %><span class="badge tone-warn">Rezerwacja</span><% } %>
      <% if (l.isFeatured) { %><span class="badge bg-sun-100 text-sun-600"><%- icon('star', 'ico-sm') %>Wyróżnione</span><% } %>
    </div>
    <h1 class="mt-4 font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl"><%= l.title %></h1>
    <p class="mt-2 flex items-center gap-1.5 text-muted"><%- icon('map-pin', 'ico-sm') %><a href="/miasto/<%= l.city %>" class="hover:text-navy-900"><%= l.cityName %></a><%= l.district ? ', ' + l.district : '' %><%= l.showExactAddress && l.street ? ', ' + l.street : '' %> · woj. <%= l.voivodeship %></p>

    <div class="mt-6 flex flex-wrap items-end justify-between gap-4 rounded-3xl bg-white p-5 ring-1 ring-line sm:p-6">
      <div>
        <p class="font-display text-4xl font-extrabold num"><%= fmt.price(l.price, l.transaction) %></p>
        <p class="mt-1 text-sm text-muted num"><% if (l.pricePerM2) { %><%= fmt.num(l.pricePerM2) %> zł/m²<% } %><%= l.negotiable ? ' · do negocjacji' : '' %></p>
      </div>
      <div class="flex gap-2">
        <button type="button" data-fav="<%= l._id %>" aria-pressed="<%= isFav %>" class="btn btn-outline <%= isFav ? 'text-orange-500' : '' %>"><%- icon('heart', 'ico-sm', isFav ? 'fill="currentColor"' : '') %><span data-fav-label><%= isFav ? 'Zapisano' : 'Zapisz' %></span></button>
        <button type="button" data-share class="btn btn-outline" aria-label="Kopiuj link"><%- icon('link', 'ico-sm') %>Udostępnij</button>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
      <% specs.forEach(function(s){ %>
      <div class="rounded-2xl border border-line bg-white p-4"><p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-muted"><%- icon(s[0], 'ico-sm text-teal-500') %><%= s[1] %></p><p class="mt-1 font-display text-lg font-bold num"><%= s[2] %></p></div>
      <% }) %>
    </div>

    <section class="mt-10">
      <h2 class="font-display text-2xl font-bold">Opis</h2>
      <div class="prose-me mt-3"><%- fmt.paragraphs(l.description) %></div>
    </section>

    <% if (l.features && l.features.length) { %>
    <section class="mt-10">
      <h2 class="font-display text-2xl font-bold">Udogodnienia</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        <% l.features.forEach(function(ft){ if (featureLabels[ft]) { %><li class="flex items-center gap-2.5"><span class="grid h-6 w-6 place-items-center rounded-full bg-teal-50 text-teal-600"><%- icon('check', 'ico-sm') %></span><%= featureLabels[ft] %></li><% } }) %>
      </ul>
    </section>
    <% } %>

    <section class="mt-10">
      <h2 class="font-display text-2xl font-bold">Szczegóły</h2>
      <dl class="mt-4 grid overflow-hidden rounded-3xl border border-line bg-white sm:grid-cols-2">
        <% details.forEach(function(d){ %><div class="flex justify-between gap-4 border-b border-line px-5 py-3 text-sm sm:odd:border-r"><dt class="text-muted"><%= d[0] %></dt><dd class="text-right font-semibold"><%= d[1] %></dd></div><% }) %>
      </dl>
    </section>

    <% if (ytId) { %>
    <section id="wideo" class="mt-10">
      <h2 class="font-display text-2xl font-bold">Wideo</h2>
      <div class="mt-4 aspect-video overflow-hidden rounded-3xl bg-navy-900"><iframe src="https://www.youtube-nocookie.com/embed/<%= ytId %>" title="Wideo oferty" loading="lazy" allowfullscreen class="h-full w-full"></iframe></div>
    </section>
    <% } %>

    <section class="mt-10">
      <h2 class="font-display text-2xl font-bold">Lokalizacja</h2>
      <p class="mt-2 text-muted"><%= l.cityName %><%= l.district ? ', ' + l.district : '' %><%= l.showExactAddress && l.street ? ', ' + l.street : '' %> (<%= l.voivodeship %>)</p>
      <% if (l.lat && l.lng) { var d = l.showExactAddress ? 0.006 : 0.02; %>
      <div class="mt-4 aspect-[16/9] overflow-hidden rounded-3xl border border-line"><iframe title="Mapa lokalizacji" loading="lazy" class="h-full w-full" src="https://www.openstreetmap.org/export/embed.html?bbox=<%= (l.lng - d) %>%2C<%= (l.lat - d * 0.6) %>%2C<%= (l.lng + d) %>%2C<%= (l.lat + d * 0.6) %>&layer=mapnik<%= l.showExactAddress ? '&marker=' + l.lat + '%2C' + l.lng : '' %>"></iframe></div>
      <% } else if (city && city.lat) { var d2 = 0.05; %>
      <div class="mt-4 aspect-[16/9] overflow-hidden rounded-3xl border border-line"><iframe title="Mapa miejscowości" loading="lazy" class="h-full w-full" src="https://www.openstreetmap.org/export/embed.html?bbox=<%= city.lng - d2 %>%2C<%= city.lat - d2 * 0.6 %>%2C<%= city.lng + d2 %>%2C<%= city.lat + d2 * 0.6 %>&layer=mapnik"></iframe></div>
      <% } %>
    </section>

    <% if (l.transaction === 'sprzedaz') { %>
    <section class="mt-10 rounded-[1.75rem] bg-navy-800 p-6 text-white sm:p-8" data-calc data-price="<%= l.price %>">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div><p class="text-xs font-bold uppercase tracking-widest text-sun-300">Kalkulator raty</p><h2 class="mt-1 font-display text-2xl font-bold text-white">Ile wyniesie rata?</h2></div>
        <p class="font-display text-4xl font-extrabold num" data-calc-out>–</p>
      </div>
      <div class="mt-6 grid gap-5 sm:grid-cols-3">
        <label class="text-sm"><span class="flex justify-between text-white/70">Wkład własny <b class="text-white" data-calc-v="down"></b></span><input type="range" min="10" max="60" value="20" data-calc-in="down" class="mt-2 w-full"></label>
        <label class="text-sm"><span class="flex justify-between text-white/70">Okres <b class="text-white" data-calc-v="years"></b></span><input type="range" min="5" max="35" value="25" data-calc-in="years" class="mt-2 w-full"></label>
        <label class="text-sm"><span class="flex justify-between text-white/70">Oprocentowanie <b class="text-white" data-calc-v="rate"></b></span><input type="range" min="3" max="11" step="0.05" value="6.9" data-calc-in="rate" class="mt-2 w-full"></label>
      </div>
      <p class="mt-4 text-xs text-white/50">Symulacja poglądowa, raty równe. <a href="/kalkulator-kredytowy?cena=<%= l.price %>" class="underline">Pełny kalkulator</a></p>
    </section>
    <% } %>
  </article>

  <!-- PANEL BOCZNY -->
  <aside class="min-w-0">
    <div class="sticky top-24 grid gap-4">
      <div id="kontakt" class="card overflow-hidden">
        <div class="flex items-center gap-4 border-b border-line p-5">
          <% if (seller.kind === 'agency') { %>
          <a href="<%= seller.url %>" class="grid h-14 w-14 shrink-0 place-items-center overflow-hidden rounded-2xl bg-paper font-display font-bold text-navy-800"><% if (seller.logo) { %><img src="<%= seller.logo %>" alt="<%= seller.name %>" class="h-full w-full object-contain p-1"><% } else { %><%= seller.name.slice(0,2).toUpperCase() %><% } %></a>
          <div class="min-w-0"><a href="<%= seller.url %>" class="block truncate font-semibold hover:text-teal-600"><%= seller.name %></a><p class="text-sm text-muted"><%= seller.person ? seller.person + ' · ' : '' %>Biuro nieruchomości</p></div>
          <% } else { %>
          <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-teal-50 text-teal-600"><%- icon('user', 'ico-lg') %></span>
          <div class="min-w-0"><p class="truncate font-semibold"><%= seller.name %></p><p class="text-sm text-muted">Oferta prywatna<%= seller.since ? ' · konto od ' + new Date(seller.since).getFullYear() : '' %></p></div>
          <% } %>
        </div>
        <div class="grid gap-2 p-5">
          <% if (seller.phone) { %>
          <button type="button" data-phone="<%= l._id %>" class="btn btn-primary w-full"><%- icon('phone', 'ico-sm') %><span data-phone-out><%= seller.phone.slice(0, 6) %>··· Pokaż numer</span></button>
          <% } %>
          <a href="#formularz-zapytania" class="btn btn-outline w-full"><%- icon('mail', 'ico-sm') %>Napisz wiadomość</a>
        </div>
        <form id="formularz-zapytania" method="post" action="/oferta/<%= l.num %>/zapytanie" class="grid gap-3 border-t border-line p-5">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true">
          <div class="flex gap-2 text-sm">
            <label class="flex-1 cursor-pointer"><input type="radio" name="topic" value="oferta" class="peer sr-only" checked><span class="block rounded-xl border border-line py-2 text-center font-semibold peer-checked:border-navy-800 peer-checked:bg-navy-800 peer-checked:text-white">Pytanie</span></label>
            <label class="flex-1 cursor-pointer"><input type="radio" name="topic" value="prezentacja" class="peer sr-only"><span class="block rounded-xl border border-line py-2 text-center font-semibold peer-checked:border-navy-800 peer-checked:bg-navy-800 peer-checked:text-white">Prezentacja</span></label>
          </div>
          <label class="sr-only" for="iq-name">Imię i nazwisko</label><input id="iq-name" name="name" required class="input" placeholder="Imię i nazwisko" value="<%= user ? user.name : '' %>">
          <label class="sr-only" for="iq-email">E-mail</label><input id="iq-email" name="email" type="email" required class="input" placeholder="E-mail" value="<%= user ? user.email : '' %>">
          <label class="sr-only" for="iq-phone">Telefon</label><input id="iq-phone" name="phone" class="input" placeholder="Telefon (opcjonalnie)" value="<%= user && user.phone ? user.phone : '' %>">
          <label class="sr-only" for="iq-msg">Wiadomość</label><textarea id="iq-msg" name="message" required class="textarea !min-h-[110px]">Dzień dobry, jestem zainteresowany/a ofertą nr <%= l.num %> (<%= l.title %>). Proszę o kontakt.</textarea>
          <label class="flex items-start gap-2 text-xs text-muted"><input type="checkbox" name="consent" value="1" required class="check mt-0.5">Zgadzam się na przekazanie moich danych ogłoszeniodawcy w celu odpowiedzi na zapytanie. <a href="/polityka-prywatnosci" class="underline">Polityka prywatności</a></label>
          <button class="btn btn-accent w-full"><%- icon('send', 'ico-sm') %>Wyślij zapytanie</button>
        </form>
      </div>

      <%- include('../partials/ad-slot', { ad: adSlots.listing_sidebar, placement: 'listing_sidebar', shape: 'tile' }) %>

      <div class="flex items-center justify-between px-2 text-xs text-muted">
        <span class="flex items-center gap-1"><%- icon('eye', 'ico-sm') %><span class="num"><%= fmt.num(l.views) %></span> wyświetleń</span>
        <details class="relative">
          <summary class="flex cursor-pointer list-none items-center gap-1 hover:text-navy-900"><%- icon('flag', 'ico-sm') %>Zgłoś ogłoszenie</summary>
          <form method="post" action="/oferta/<%= l.num %>/zgloszenie" class="absolute bottom-7 right-0 z-20 grid w-72 gap-2 rounded-2xl border border-line bg-white p-4 shadow-lift">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <label class="label" for="rp-reason">Powód zgłoszenia</label>
            <select id="rp-reason" name="reason" class="select text-sm"><option value="oszustwo">Podejrzenie oszustwa</option><option value="nieaktualne">Oferta nieaktualna</option><option value="bledne_dane">Błędne dane</option><option value="duplikat">Duplikat</option><option value="nielegalne">Treść niezgodna z prawem</option><option value="inne">Inne</option></select>
            <textarea name="details" class="textarea !min-h-[80px] text-sm" placeholder="Opisz problem"></textarea>
            <input name="email" type="email" class="input text-sm" placeholder="Twój e-mail (opcjonalnie)">
            <button class="btn btn-primary btn-sm">Wyślij zgłoszenie</button>
          </form>
        </details>
      </div>
    </div>
  </aside>
</div>

<% if (similar.length) { %>
<section class="border-t border-line bg-white py-14">
  <div class="wrap">
    <div class="mb-6 flex items-end justify-between gap-4"><h2 class="font-display text-2xl font-bold">Podobne oferty w okolicy</h2><a href="/<%= l.transaction %>/<%= t.slug %>/<%= l.city %>" class="hidden items-center gap-2 font-semibold hover:gap-3 sm:flex">Więcej: <%= l.cityName %> <%- icon('arrow-right', 'ico-sm') %></a></div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4"><% similar.forEach(function(s){ %><%- include('../partials/listing-card', { l: s }) %><% }) %></div>
  </div>
</section>
<% } %>

<% if (imgs.length) { %>
<div id="lightbox" class="fixed inset-0 z-[80] flex items-center justify-center bg-navy-950/95 p-4" hidden data-images='<%- JSON.stringify(imgs.map(function(i){ return i.url; })).replace(/'/g, "&#39;") %>'>
  <button type="button" class="absolute right-4 top-4 grid h-11 w-11 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20" data-lb-close aria-label="Zamknij"><%- icon('x', 'ico') %></button>
  <button type="button" class="absolute left-4 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20" data-lb-prev aria-label="Poprzednie"><%- icon('chevron-left', 'ico-lg') %></button>
  <img src="" alt="Zdjęcie oferty" class="max-h-[86vh] max-w-full rounded-2xl object-contain" data-lb-img>
  <button type="button" class="absolute right-4 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20" data-lb-next aria-label="Następne"><%- icon('chevron-right', 'ico-lg') %></button>
  <p class="absolute bottom-5 left-1/2 -translate-x-1/2 text-sm text-white/70 num" data-lb-count></p>
</div>
<% } %>

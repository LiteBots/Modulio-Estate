<%
  var popular = [
    ['trojmiasto','Trójmiasto','Gdańsk · Gdynia · Sopot','sea','dusk'],['slupsk','Słupsk','Pomorze Środkowe','loft','dawn'],['szczecin','Szczecin','Zachodniopomorskie','office','day'],['koszalin','Koszalin','Zachodniopomorskie','block','teal'],
    ['gdynia','Gdynia','Trójmiasto','sea','day'],['ustka','Ustka','Nad morzem','sea','dawn'],['kolobrzeg','Kołobrzeg','Uzdrowisko','sea','teal'],['chojnice','Chojnice','Bory Tucholskie','house','day'],['bytow','Bytów','Kaszuby','house','dawn']
  ];
  var cnt = function(slug){ if (slug === 'trojmiasto') return ['gdansk','gdynia','sopot'].reduce(function(s,k){ return s + ((byCity[k]||{}).count||0); }, 0); return (byCity[slug]||{}).count || 0; };
  var preview = featured.slice(0, 3);
  var marquee = ['Gdańsk','Gdynia','Sopot','Słupsk','Ustka','Bytów','Miastko','Chojnice','Lębork','Koszalin','Kołobrzeg','Szczecin','Świnoujście','Łeba','Mielno'];
%>

<!-- ═══ HERO ═══ -->
<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute -right-40 -top-40 h-[560px] w-[560px] rounded-full bg-orange-100/60 blur-3xl"></div>
  <p class="ghost-word absolute -bottom-6 left-0 hidden text-[220px] lg:block" aria-hidden="true">POMORZE</p>
  <div class="wrap relative grid items-center gap-12 pb-16 pt-12 lg:grid-cols-[1.15fr_1fr] lg:pb-24 lg:pt-16">
    <div class="min-w-0">
      <span class="pill"><span class="h-2 w-2 rounded-full bg-teal-500"></span>Pomorskie · Zachodniopomorskie</span>
      <h1 class="mt-6 font-display font-bold leading-[.98]" style="font-size: clamp(42px, 6vw, 82px); letter-spacing: -0.06em">Twoje miejsce<br>nad Bałtykiem.<br><span class="serif-accent text-navy-500">Znajdź je spokojnie.</span></h1>
      <p class="mt-6 max-w-xl text-[17px] leading-relaxed text-muted">Mieszkania, domy i działki od Szczecina po Gdańsk – w jednym, przejrzystym serwisie. Od właścicieli, lokalnych biur i deweloperów.</p>
      <div class="mt-8 max-w-3xl"><%- include('../partials/search-hero') %></div>
      <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
        <span class="flex items-center gap-1.5"><%- icon('check-circle', 'ico-sm text-orange-500') %>Tylko oferty z regionu</span>
        <span class="flex items-center gap-1.5"><%- icon('check-circle', 'ico-sm text-orange-500') %>Bez opłat dla kupujących</span>
        <span class="flex items-center gap-1.5"><%- icon('check-circle', 'ico-sm text-orange-500') %>Powiadomienia o nowych ofertach</span>
      </div>
    </div>

    <!-- podgląd ofert w stylu „okna aplikacji” Modulio -->
    <div class="relative hidden lg:block">
      <div class="absolute -inset-8 rounded-full border border-dashed border-navy-200"></div>
      <div class="relative rounded-[24px] border border-line bg-white p-5 shadow-lift">
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2 text-sm font-bold"><img src="/img/logo-mark.png" alt="" class="h-6 w-auto">Nowe na rynku</span>
          <span class="text-[10px] font-bold uppercase tracking-[.16em] text-muted">dziś</span>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-3">
          <div class="rounded-[16px] border border-line p-4"><p class="text-[11px] text-muted">Ogłoszenia w regionie</p><p class="mt-1 font-display text-2xl font-bold num" style="letter-spacing:-0.04em"><%= fmt.num(counts.total) %></p><p class="mt-1 text-[11px] text-teal-600">pomorskie <%= fmt.num(counts.pomorskie) %> · zach. <%= fmt.num(counts.zachodnie) %></p></div>
          <div class="rounded-[16px] border border-line p-4"><p class="text-[11px] text-muted">Biura partnerskie</p><p class="mt-1 font-display text-2xl font-bold num" style="letter-spacing:-0.04em"><%= fmt.num(counts.agencies) %></p><p class="mt-1 text-[11px] text-muted"><%= LOC.CITIES.length %> miejscowości</p></div>
        </div>
        <div class="mt-3 grid gap-2">
          <% preview.forEach(function(l){ %>
          <a href="<%= l.url %>" class="flex items-center gap-3 rounded-[14px] border border-line p-2.5 transition hover:border-navy-300">
            <span class="scene h-12 w-16 shrink-0 overflow-hidden rounded-[10px]"><% if (l.images && l.images[0]) { %><img src="<%= l.images[0].url %>" alt=""><% } else { %><%- art.sceneFor(l) %><% } %></span>
            <span class="min-w-0 flex-1"><span class="block truncate text-[13px] font-bold"><%= l.title %></span><span class="text-[11px] text-muted"><%= l.cityName %></span></span>
            <span class="shrink-0 rounded-full bg-orange-50 px-2.5 py-1 text-[11px] font-bold text-orange-700 num"><%= fmt.shortPrice(l.price) %><%= l.transaction === 'wynajem' ? ' zł/mc' : ' zł' %></span>
          </a>
          <% }) %>
        </div>
      </div>
      <div class="floaty absolute -bottom-7 -left-10 flex items-center gap-2.5 rounded-[16px] border border-line bg-white px-3.5 py-2.5 shadow-lift">
        <span class="grid h-9 w-9 place-items-center rounded-[11px] bg-orange-100 text-orange-600"><%- icon('bell', 'ico-sm') %></span>
        <span class="text-xs leading-tight"><b class="block">Nowa oferta w Ustce</b><span class="text-muted">pasuje do Twojego wyszukiwania</span></span>
      </div>
      <div class="absolute -right-4 bottom-10 grid h-4 w-4 place-items-center rounded-full bg-orange-500 pulse-dot"></div>
    </div>
  </div>
</section>

<!-- pasek miast (jak pasek modułów w Modulio) -->
<div class="overflow-hidden border-y border-line py-4" aria-hidden="true">
  <div class="marquee gap-10 text-[12px] font-bold uppercase tracking-[.14em] text-navy-600">
    <% for (var k = 0; k < 2; k++) { marquee.forEach(function(m){ %><span class="flex items-center gap-10 whitespace-nowrap"><span class="flex items-center gap-2"><%- icon('map-pin', 'ico-sm text-orange-500') %><%= m %></span><span class="text-navy-300">•</span></span><% }) } %>
  </div>
</div>

<!-- liczby -->
<section class="wrap pt-14">
  <div class="grid grid-cols-2 gap-px overflow-hidden rounded-[22px] border border-line bg-line lg:grid-cols-4">
    <div class="bg-white p-5 sm:p-6"><p class="stat-num num"><%= fmt.num(counts.total) %></p><p class="mt-2 text-sm text-muted">aktualnych ogłoszeń mieszkań, domów i działek</p></div>
    <div class="bg-white p-5 sm:p-6"><p class="stat-num num"><%= LOC.CITIES.length %><b>+</b></p><p class="mt-2 text-sm text-muted">miejscowości z dwóch województw</p></div>
    <div class="bg-white p-5 sm:p-6"><p class="stat-num">0<b> zł</b></p><p class="mt-2 text-sm text-muted">dla kupujących i najemców</p></div>
    <div class="bg-white p-5 sm:p-6"><p class="stat-num">24<b>/</b>7</p><p class="mt-2 text-sm text-muted">powiadomienia o nowych ofertach</p></div>
  </div>
</section>

<!-- 01 lokalizacje -->
<section class="wrap py-20">
  <div class="grid items-end gap-6 lg:grid-cols-[1.2fr_1fr]">
    <div><p class="eyebrow">01 / Lokalizacje</p><h2 class="section-title mt-4">Szukaj tam,<br><span class="serif-accent">gdzie chcesz mieszkać.</span></h2></div>
    <p class="max-w-md text-muted lg:justify-self-end">Najpopularniejsze miasta Pomorza i Pomorza Zachodniego. Na stronie każdego miasta zobaczysz średnie ceny, dzielnice i lokalne biura.</p>
  </div>
  <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4">
    <% popular.forEach(function(p, i){ %>
    <a href="/sprzedaz/mieszkania/<%= p[0] %>" class="group relative block aspect-[4/3.4] overflow-hidden rounded-[22px] <%= i === 0 ? 'md:col-span-2 md:row-span-2 md:aspect-auto' : '' %>">
      <div class="scene absolute inset-0 transition duration-700 group-hover:scale-105"><%- art.scene(p[3], p[4], 60 + i) %></div>
      <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-navy-950/10 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 p-5 text-white">
        <div><p class="font-display <%= i === 0 ? 'text-3xl' : 'text-xl' %> font-bold" style="letter-spacing:-0.04em"><%= p[1] %></p><p class="text-sm text-white/75"><%= p[2] %> · <span class="num"><%= fmt.num(cnt(p[0])) %></span> ofert</p></div>
        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-[12px] bg-white/15 backdrop-blur transition group-hover:bg-orange-500 group-hover:text-ink"><%- icon('arrow-up-right', 'ico-sm') %></span>
      </div>
    </a>
    <% }) %>
  </div>
</section>

<!-- 02 ogłoszenia -->
<section class="border-y border-line bg-teal-100/60 py-20">
  <div class="wrap">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div><p class="eyebrow">02 / Ogłoszenia</p><h2 class="section-title mt-4">Świeże oferty.<br><span class="serif-accent">Sprawdzone źródła.</span></h2></div>
      <a href="/sprzedaz" class="btn btn-primary w-fit">Wszystkie ogłoszenia <%- icon('arrow-right', 'ico-sm') %></a>
    </div>
    <% if (featured.length) { %>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><% featured.slice(0, 8).forEach(function(l){ %><%- include('../partials/listing-card', { l: l }) %><% }) %></div>
    <% } else { %>
    <p class="mt-10 rounded-[22px] border border-dashed border-navy-200 bg-white p-10 text-center text-muted">Pierwsze ogłoszenia pojawią się wkrótce. <a href="/panel/ogloszenia/nowe" class="link">Dodaj swoje</a></p>
    <% } %>
  </div>
</section>

<% if (adSlots.home_billboard) { %><section class="wrap pt-14"><%- include('../partials/ad-slot', { ad: adSlots.home_billboard, placement: 'home_billboard' }) %></section><% } %>

<!-- 03 kategorie -->
<section class="wrap py-20">
  <div class="grid items-end gap-6 lg:grid-cols-[1.2fr_1fr]">
    <div><p class="eyebrow">03 / Kategorie</p><h2 class="section-title mt-4">Czego szukasz?<br><span class="serif-accent">Zacznij od rodzaju.</span></h2></div>
  </div>
  <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <% P.TYPES.forEach(function(t){ var c = typeCounts[t.key] || { all: 0 }; %>
    <a href="/<%= t.key === 'pokoj' ? 'wynajem' : 'sprzedaz' %>/<%= t.slug %>" class="group flex items-center justify-between gap-3 rounded-[20px] border border-line bg-white p-4 transition hover:-translate-y-1 hover:shadow-lift">
      <span class="flex min-w-0 items-center gap-3"><span class="icon-box group-hover:border-orange-200 group-hover:text-orange-600"><%- icon(t.icon, 'ico') %></span><span class="min-w-0"><span class="block truncate font-bold"><%= t.plural %></span><span class="text-xs text-muted num"><%= fmt.num(c.all) %> ofert</span></span></span>
      <%- icon('arrow-right', 'ico-sm shrink-0 text-navy-300 transition group-hover:translate-x-1 group-hover:text-orange-500') %>
    </a>
    <% }) %>
  </div>
</section>

<!-- 04 dla biur (ciemna sekcja jak „Panel klienta” w Modulio) -->
<section class="dark-band py-20 text-white">
  <div class="wrap grid items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow !text-white/60">04 / Dla biur nieruchomości</p>
      <h2 class="section-title mt-4 !text-white">Twoje biuro.<br><span class="serif-accent text-white/70">Na lokalnym rynku.</span></h2>
      <p class="mt-5 max-w-lg text-white/70">Panel dla biur z CRM zapytań, kontami dla agentów i własną stroną biura w serwisie. Warunki współpracy ustalamy indywidualnie – bez gotowych pakietów.</p>
      <div class="mt-7 grid gap-2.5">
        <% [['inbox','Zapytania w jednym miejscu','Etapy od pierwszej wiadomości do transakcji.'],['users','Zespół i role','Właściciel, manager i agenci z własnymi ofertami.'],['layout','Strona biura','Logo, zespół, oferty i formularz wyceny pod jednym adresem.']].forEach(function(f){ %>
        <div class="dark-card flex items-center gap-4"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-[12px] bg-orange-500/15 text-orange-400"><%- icon(f[0], 'ico-sm') %></span><span><b class="block text-sm text-white"><%= f[1] %></b><span class="text-[13px] text-white/60"><%= f[2] %></span></span></div>
        <% }) %>
      </div>
      <div class="mt-8 flex flex-wrap gap-2.5"><a href="/zostan-partnerem" class="btn btn-accent btn-lg">Zostań partnerem <%- icon('arrow-up-right', 'ico-sm') %></a><a href="/biura" class="btn btn-lg border border-white/20 text-white hover:bg-white/10">Biura w serwisie</a></div>
    </div>
    <div class="hidden rounded-[24px] bg-white p-4 text-ink shadow-lift lg:block">
      <div class="grid grid-cols-[150px_1fr] gap-4">
        <div class="grid content-start gap-1 rounded-[16px] bg-paper p-2 text-[12px]">
          <span class="flex items-center gap-2 px-2 pb-2 pt-1 text-[13px] font-bold"><img src="/img/logo-mark.png" alt="" class="h-5 w-auto">Panel biura</span>
          <% ['Pulpit','Ogłoszenia','Zapytania','Zespół','Strona biura'].forEach(function(x, i){ %><span class="rounded-[10px] px-2.5 py-1.5 <%= i === 2 ? 'bg-white font-bold shadow-soft' : 'text-muted' %>"><%= x %></span><% }) %>
        </div>
        <div class="min-w-0">
          <p class="text-sm font-bold">Zapytania – CRM</p>
          <div class="mt-3 grid grid-cols-3 gap-2 text-[11px]">
            <% [['Nowe','bg-orange-50 text-orange-700',['Marta K.','Piotr Z.']],['Prezentacja','bg-teal-100 text-teal-700',['Anna W.']],['Transakcja','bg-navy-50 text-navy-700',['Ewa L.']]].forEach(function(c){ %>
            <div class="rounded-[12px] border border-line p-2"><span class="rounded-full px-2 py-0.5 font-bold <%= c[1] %>"><%= c[0] %></span>
              <% c[2].forEach(function(n){ %><div class="mt-2 rounded-[10px] border border-line p-2"><b class="block"><%= n %></b><span class="text-muted">3 pokoje, Ustka</span></div><% }) %>
            </div>
            <% }) %>
          </div>
          <div class="mt-3 flex items-center justify-between rounded-[12px] border border-line px-3 py-2 text-[12px]"><span>Wyświetlenia ofert (30 dni)</span><b class="num">1 840</b></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 05 FAQ -->
<section class="wrap grid gap-10 py-20 lg:grid-cols-[1fr_1.3fr]">
  <div>
    <p class="eyebrow">05 / Pytania</p>
    <h2 class="section-title mt-4">Masz pytanie?<br><span class="serif-accent">Mamy odpowiedź.</span></h2>
    <a href="/pomoc" class="btn btn-primary mt-8"><%- icon('message', 'ico-sm') %>Centrum pomocy</a>
  </div>
  <div class="divide-y divide-line border-y border-line">
    <% faq.forEach(function(f){ %>
    <details class="group py-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold [&::-webkit-details-marker]:hidden"><%= f[0] %><span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line bg-white transition group-open:rotate-45"><%- icon('plus', 'ico-sm') %></span></summary>
      <p class="mt-3 max-w-2xl text-muted"><%= f[1] %></p>
    </details>
    <% }) %>
  </div>
</section>

<!-- tekst SEO -->
<section class="wrap pb-6 text-sm text-muted">
  <h2 class="font-display text-base font-bold text-ink">Ogłoszenia nieruchomości – Pomorskie i Zachodniopomorskie</h2>
  <p class="mt-2 max-w-4xl leading-relaxed">ModulioEstate to regionalny portal z ofertami mieszkań, domów, działek i lokali na sprzedaż i wynajem. Znajdziesz tu ogłoszenia z <a href="/miasto/trojmiasto" class="underline hover:text-ink">Trójmiasta</a>, <a href="/miasto/slupsk" class="underline hover:text-ink">Słupska</a>, <a href="/miasto/ustka" class="underline hover:text-ink">Ustki</a>, <a href="/miasto/bytow" class="underline hover:text-ink">Bytowa</a>, <a href="/miasto/miastko" class="underline hover:text-ink">Miastka</a>, <a href="/miasto/chojnice" class="underline hover:text-ink">Chojnic</a>, <a href="/miasto/koszalin" class="underline hover:text-ink">Koszalina</a>, <a href="/miasto/kolobrzeg" class="underline hover:text-ink">Kołobrzegu</a> i <a href="/miasto/szczecin" class="underline hover:text-ink">Szczecina</a> – od właścicieli, biur nieruchomości i deweloperów.</p>
</section>

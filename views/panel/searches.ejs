<h1 class="font-display text-3xl font-extrabold">Zapisane wyszukiwania</h1>
<p class="mt-1 max-w-2xl text-muted">Wyślemy e-mail, gdy pojawi się nowa oferta pasująca do filtrów. Wyszukiwanie zapiszesz przyciskiem „Zapisz i powiadamiaj” na liście wyników.</p>
<% if (searches.length) { %>
<div class="mt-6 grid gap-3">
  <% searches.forEach(function(s){ %>
  <form method="post" action="/panel/wyszukiwania/<%= s._id %>" class="card flex flex-col gap-3 p-4 sm:flex-row sm:items-center">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-teal-50 text-teal-600"><%- icon('search', 'ico') %></span>
    <div class="min-w-0 flex-1"><input name="name" value="<%= s.name %>" class="w-full bg-transparent font-semibold outline-none" aria-label="Nazwa wyszukiwania"><a href="<%= s.url %>" class="block truncate text-sm text-teal-600"><%= s.url %></a></div>
    <select name="notify" class="select !w-auto text-sm" aria-label="Powiadomienia"><option value="instant" <%= s.notify === 'instant' ? 'selected' : '' %>>Od razu</option><option value="daily" <%= s.notify === 'daily' ? 'selected' : '' %>>Raz dziennie</option><option value="off" <%= s.notify === 'off' ? 'selected' : '' %>>Wyłączone</option></select>
    <div class="flex gap-2"><button class="btn btn-outline btn-sm">Zapisz</button><button name="action" value="delete" class="btn btn-ghost btn-sm text-red-600" data-confirm="Usunąć to wyszukiwanie?"><%- icon('trash', 'ico-sm') %></button></div>
  </form>
  <% }) %>
</div>
<% } else { %>
<div class="card mt-6 p-10 text-center"><p class="font-display text-xl font-bold">Brak zapisanych wyszukiwań</p><a href="/sprzedaz" class="btn btn-primary mt-5">Przejdź do wyszukiwarki</a></div>
<% } %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <h2 class="font-display text-2xl font-bold">Oferty biura</h2>
  <div class="flex rounded-full bg-paper p-1 text-sm font-semibold">
    <a href="/biuro/<%= a.slug %>#oferty" class="rounded-full px-4 py-1.5 <%= !tr ? 'bg-white shadow-sm' : 'text-muted' %>">Wszystkie</a>
    <a href="/biuro/<%= a.slug %>?t=sprzedaz#oferty" class="rounded-full px-4 py-1.5 <%= tr === 'sprzedaz' ? 'bg-white shadow-sm' : 'text-muted' %>">Sprzedaż <span class="num"><%= counts.sale %></span></a>
    <a href="/biuro/<%= a.slug %>?t=wynajem#oferty" class="rounded-full px-4 py-1.5 <%= tr === 'wynajem' ? 'bg-white shadow-sm' : 'text-muted' %>">Wynajem <span class="num"><%= counts.rent %></span></a>
  </div>
</div>
<% if (listings.length) { %>
<div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"><% listings.forEach(function(l){ l.agency = { name: a.name }; %><%- include('listing-card', { l: l }) %><% }) %></div>
<% } else { %><p class="mt-6 rounded-xl border-2 border-dashed border-line p-8 text-center text-muted">Biuro nie ma obecnie aktywnych ofert w tej kategorii.</p><% } %>

<%
  var img = l.images && l.images[0] ? l.images[0].url : null;
  var fav = favIds.has(String(l._id));
  var badge = l.isFeatured ? ['Wyróżnione', 'bg-sun-400 text-navy-900'] : l.market === 'pierwotny' ? ['Rynek pierwotny', 'bg-white text-navy-800'] : l.noCommission ? ['Bez prowizji', 'bg-white text-navy-800'] : null;
%>
<article class="group relative flex flex-col overflow-hidden rounded-xl border border-line bg-white transition hover:shadow-soft">
  <div class="scene relative aspect-[4/3]">
    <% if (img) { %><img src="<%= img %>" alt="<%= l.title %>" loading="lazy"><% } else { %><%- art.sceneFor(l) %><% } %>
    <% if (badge) { %><span class="absolute left-3 top-3 rounded-md px-2 py-1 text-xs font-semibold <%= badge[1] %>"><%= badge[0] %></span><% } %>
  </div>
  <button type="button" data-fav="<%= l._id %>" aria-pressed="<%= fav %>" aria-label="<%= fav ? 'Usuń z obserwowanych' : 'Obserwuj' %>" class="absolute right-3 top-3 z-10 grid h-9 w-9 place-items-center rounded-full bg-white/95 shadow-sm transition hover:text-orange-500 <%= fav ? 'text-orange-500' : 'text-navy-800' %>">
    <%- icon('heart', 'ico-sm', fav ? 'fill="currentColor"' : '') %>
  </button>
  <div class="flex flex-1 flex-col p-4">
    <p class="font-display text-xl font-bold num"><%= fmt.price(l.price, l.transaction) %></p>
    <h3 class="mt-1 line-clamp-2 text-[15px] font-medium leading-snug text-navy-900"><a href="<%= l.url %>" class="after:absolute after:inset-0 after:content-['']"><%= l.title %></a></h3>
    <p class="mt-1 truncate text-sm text-muted"><%= l.cityName %><%= l.district ? ', ' + l.district : '' %></p>
    <p class="mt-3 text-sm text-navy-700 num"><%- include('listing-params', { l: l }) %></p>
  </div>
</article>

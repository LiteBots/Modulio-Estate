<section class="wrap py-8">
  <%- include('../partials/breadcrumbs') %>
  <h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight">Pomoc</h1>
  <p class="mt-2 max-w-2xl text-muted">Odpowiedzi na najczęstsze pytania. Nie znalazłeś odpowiedzi? <a href="/kontakt" class="font-semibold text-teal-600">Napisz do nas</a>.</p>
</section>
<section class="wrap grid gap-8 pb-16 lg:grid-cols-[1.5fr_1fr]">
  <div class="divide-y divide-line rounded-xl border border-line bg-white">
    <% faq.forEach(function(f, i){ %>
    <details class="group px-6 py-5" <%= i === 0 ? 'open' : '' %>>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-bold [&::-webkit-details-marker]:hidden"><%= f[0] %><span class="transition group-open:rotate-45"><%- icon('plus', 'ico') %></span></summary>
      <p class="mt-3 text-muted"><%= f[1] %></p>
    </details>
    <% }) %>
  </div>
  <aside class="grid content-start gap-4">
    <a href="/panel" class="card card-pad hover:shadow-soft"><%- icon('dashboard', 'ico-lg text-teal-500') %><p class="mt-3 font-display text-lg font-bold">Mój panel</p><p class="text-sm text-muted">Ogłoszenia, wiadomości, ulubione.</p></a>
    <a href="/poradnik" class="card card-pad hover:shadow-soft"><%- icon('file', 'ico-lg text-teal-500') %><p class="mt-3 font-display text-lg font-bold">Poradnik</p><p class="text-sm text-muted">Kupno, sprzedaż i najem krok po kroku.</p></a>
  </aside>
</section>

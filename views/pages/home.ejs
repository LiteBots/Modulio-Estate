<%
  var popular = [
    ['trojmiasto','Trójmiasto','sea','dusk'],['slupsk','Słupsk','loft','dawn'],['szczecin','Szczecin','office','day'],['koszalin','Koszalin','block','teal'],
    ['gdansk','Gdańsk','block','day'],['gdynia','Gdynia','sea','day'],['kolobrzeg','Kołobrzeg','sea','teal'],['ustka','Ustka','sea','dawn']
  ];
  var cnt = function(slug){ if (slug === 'trojmiasto') return ['gdansk','gdynia','sopot'].reduce(function(s,k){ return s + ((byCity[k]||{}).count||0); }, 0); return (byCity[slug]||{}).count || 0; };
%>

<!-- Hero z wyszukiwarką -->
<section class="relative">
  <div class="scene absolute inset-0 bg-navy-900"><%- art.heroCoast() %></div>
  <div class="absolute inset-0 bg-navy-950/45"></div>
  <div class="wrap relative pb-16 pt-14 sm:pb-24 sm:pt-20">
    <h1 class="max-w-2xl font-display text-[2rem] font-bold leading-tight text-white sm:text-5xl">Nieruchomości na Pomorzu i Pomorzu Zachodnim</h1>
    <p class="mt-3 text-lg text-white/85"><span class="num"><%= fmt.num(counts.total) %></span> <%= fmt.plural(counts.total, 'ogłoszenie', 'ogłoszenia', 'ogłoszeń') %> mieszkań, domów i działek</p>
    <div class="mt-8 max-w-4xl"><%- include('../partials/search-hero') %></div>
  </div>
</section>

<!-- Popularne lokalizacje -->
<section class="wrap py-12">
  <div class="mb-5 flex items-end justify-between gap-4"><h2 class="h-section">Popularne lokalizacje</h2><a href="/miasta" class="text-sm font-semibold text-teal-600 hover:text-teal-700">Wszystkie miasta</a></div>
  <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
    <% popular.forEach(function(p, i){ %>
    <a href="/sprzedaz/mieszkania/<%= p[0] %>" class="group relative block aspect-[16/10] overflow-hidden rounded-xl">
      <div class="scene absolute inset-0 transition duration-500 group-hover:scale-105"><%- art.scene(p[2], p[3], 60 + i) %></div>
      <div class="absolute inset-0 bg-gradient-to-t from-navy-950/75 to-transparent"></div>
      <div class="absolute bottom-0 p-4 text-white"><p class="font-display text-lg font-bold"><%= p[1] %></p><p class="text-sm text-white/80 num"><%= fmt.num(cnt(p[0])) %> ofert</p></div>
    </a>
    <% }) %>
  </div>
</section>

<!-- Najnowsze ogłoszenia -->
<section class="border-y border-line bg-paper py-12">
  <div class="wrap">
    <div class="mb-5 flex items-end justify-between gap-4"><h2 class="h-section"><%= featured.length && featured[0].isFeatured ? 'Polecane ogłoszenia' : 'Najnowsze ogłoszenia' %></h2><a href="/sprzedaz" class="text-sm font-semibold text-teal-600 hover:text-teal-700">Zobacz wszystkie</a></div>
    <% if (featured.length) { %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><% featured.slice(0, 8).forEach(function(l){ %><%- include('../partials/listing-card', { l: l }) %><% }) %></div>
    <% } else { %>
    <p class="rounded-xl border border-dashed border-line bg-white p-8 text-center text-muted">Pierwsze ogłoszenia pojawią się wkrótce. <a href="/panel/ogloszenia/nowe" class="font-semibold text-teal-600">Dodaj swoje</a></p>
    <% } %>
  </div>
</section>

<% if (adSlots.home_billboard) { %><section class="wrap pt-12"><%- include('../partials/ad-slot', { ad: adSlots.home_billboard, placement: 'home_billboard' }) %></section><% } %>

<!-- Kategorie -->
<section class="wrap py-12">
  <h2 class="h-section">Czego szukasz?</h2>
  <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <% P.TYPES.forEach(function(t){ var c = typeCounts[t.key] || { all: 0 }; %>
    <a href="/<%= t.key === 'pokoj' ? 'wynajem' : 'sprzedaz' %>/<%= t.slug %>" class="flex items-center gap-3 rounded-xl border border-line p-4 transition hover:border-navy-300 hover:shadow-soft">
      <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-teal-50 text-teal-600"><%- icon(t.icon, 'ico') %></span>
      <span><span class="block font-semibold"><%= t.plural %></span><span class="text-sm text-muted num"><%= fmt.num(c.all) %> ofert</span></span>
    </a>
    <% }) %>
  </div>
</section>

<!-- Dwa wezwania do działania -->
<section class="wrap grid gap-4 pb-14 md:grid-cols-2">
  <div class="flex flex-col justify-between gap-5 rounded-xl bg-navy-800 p-7 text-white sm:flex-row sm:items-center">
    <div><h2 class="font-display text-xl font-bold text-white">Sprzedajesz lub wynajmujesz?</h2><p class="mt-1 text-white/75">Dodaj ogłoszenie w kilka minut.</p></div>
    <a href="/panel/ogloszenia/nowe" class="btn btn-accent shrink-0">Dodaj ogłoszenie</a>
  </div>
  <div class="flex flex-col justify-between gap-5 rounded-xl border border-line bg-paper p-7 sm:flex-row sm:items-center">
    <div><h2 class="font-display text-xl font-bold">Prowadzisz biuro nieruchomości?</h2><p class="mt-1 text-muted">Panel dla biur i strona firmowa w serwisie.</p></div>
    <a href="/zostan-partnerem" class="btn btn-primary shrink-0">Zostań partnerem</a>
  </div>
</section>

<!-- Tekst SEO -->
<section class="border-t border-line">
  <div class="wrap py-10 text-sm text-muted">
    <h2 class="font-display text-base font-semibold text-navy-900">Ogłoszenia nieruchomości – Pomorskie i Zachodniopomorskie</h2>
    <p class="mt-2 max-w-4xl leading-relaxed">ModulioEstate to regionalny portal z ofertami mieszkań, domów, działek i lokali na sprzedaż i wynajem. Znajdziesz tu ogłoszenia z <a href="/miasto/trojmiasto" class="underline hover:text-navy-900">Trójmiasta</a>, <a href="/miasto/slupsk" class="underline hover:text-navy-900">Słupska</a>, <a href="/miasto/ustka" class="underline hover:text-navy-900">Ustki</a>, <a href="/miasto/bytow" class="underline hover:text-navy-900">Bytowa</a>, <a href="/miasto/miastko" class="underline hover:text-navy-900">Miastka</a>, <a href="/miasto/chojnice" class="underline hover:text-navy-900">Chojnic</a>, <a href="/miasto/koszalin" class="underline hover:text-navy-900">Koszalina</a>, <a href="/miasto/kolobrzeg" class="underline hover:text-navy-900">Kołobrzegu</a> i <a href="/miasto/szczecin" class="underline hover:text-navy-900">Szczecina</a> – od właścicieli, biur nieruchomości i deweloperów.</p>
  </div>
</section>

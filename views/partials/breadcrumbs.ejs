<% if (breadcrumbs && breadcrumbs.length > 1) { %>
<nav aria-label="Ścieżka nawigacji" class="text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    <% breadcrumbs.forEach(function(b, i){ %>
      <li class="flex items-center gap-1.5 <%= i === breadcrumbs.length - 1 ? 'min-w-0' : '' %>">
        <% if (i < breadcrumbs.length - 1) { %><a href="<%= b.url %>" class="hover:text-navy-800"><%= b.name %></a><%- icon('chevron-right', 'ico-sm opacity-50') %><% } else { %><span class="truncate text-navy-700" aria-current="page"><%= b.name %></span><% } %>
      </li>
    <% }) %>
  </ol>
</nav>
<% } %>

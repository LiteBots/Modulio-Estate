<div class="flex flex-wrap items-end justify-between gap-4"><div><h1 class="font-display text-3xl font-extrabold">Reklamy</h1><p class="mt-1 text-muted">Kampanie w <%= Object.keys(P.AD_PLACEMENTS).length %> miejscach serwisu z targetowaniem na miasta i województwa.</p></div><a href="/admin/reklamy/nowa" class="btn btn-accent"><%- icon('plus', 'ico-sm') %>Nowa reklama</a></div>
<div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
  <% Object.keys(P.AD_PLACEMENTS).forEach(function(k){ var n = ads.filter(function(a){ return a.placement === k && a.active; }).length; %>
  <a href="/admin/reklamy/nowa?miejsce=<%= k %>" class="card p-4 hover:shadow-soft"><p class="text-sm font-semibold"><%= P.AD_PLACEMENTS[k].label %></p><p class="text-xs text-muted"><%= P.AD_PLACEMENTS[k].size %></p><p class="mt-2 text-sm"><span class="badge <%= n ? 'tone-good' : 'tone-muted' %>"><%= n ? n + ' aktywne' : 'wolne' %></span></p></a>
  <% }) %>
</div>
<div class="card mt-6 overflow-hidden"><div class="table-wrap"><table class="table num">
  <thead><tr><th>Reklama</th><th>Miejsce</th><th>Okres</th><th>Kierowanie</th><th class="!text-right">Wyśw.</th><th class="!text-right">Klik.</th><th class="!text-right">CTR</th><th>Status</th></tr></thead>
  <tbody><% ads.forEach(function(a){ %>
    <tr><td><a href="/admin/reklamy/<%= a._id %>" class="font-semibold hover:text-orange-600"><%= a.name %></a><p class="text-xs text-muted"><%= a.advertiser || '' %></p></td><td class="text-sm"><%= P.AD_PLACEMENTS[a.placement].label %></td><td class="whitespace-nowrap text-sm"><%= a.startsAt ? fmt.dateShort(a.startsAt) : '–' %> → <%= a.endsAt ? fmt.dateShort(a.endsAt) : '–' %></td><td class="max-w-[200px] text-sm text-muted"><%= (a.cities.length ? a.cities.map(cityName).join(', ') : '') || (a.voivodeships.length ? a.voivodeships.join(', ') : 'cały region') %></td><td class="text-right"><%= fmt.num(a.impressions) %></td><td class="text-right"><%= fmt.num(a.clicks) %></td><td class="text-right"><%= a.impressions ? (a.clicks / a.impressions * 100).toFixed(2).replace('.', ',') : '0' %>%</td><td><span class="badge <%= a.active ? 'tone-good' : 'tone-muted' %>"><%= a.active ? 'aktywna' : 'wstrzymana' %></span></td></tr>
  <% }) %><% if (!ads.length) { %><tr><td colspan="8" class="py-10 text-center text-muted">Brak reklam. Puste miejsca reklamowe wyświetlają zachętę „Twoja reklama w tym miejscu”.</td></tr><% } %></tbody>
</table></div></div>

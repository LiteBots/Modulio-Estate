<% var a = agency; var ms = a.microsite || {}; %>
<h1 class="font-display text-3xl font-extrabold">Strona biura w serwisie</h1>
<p class="mt-1 max-w-2xl text-muted">Rozbudowana strona firmowa pod adresem <span class="font-semibold text-navy-900"><%= site.url %>/biuro/<%= a.slug %></span> – z okładką, kolorem marki, zespołem, statystykami i formularzem kontaktu. Indeksowana w Google.</p>
<% if (!a.plan.microsite) { %>
<div class="card mt-6 grid items-center gap-6 overflow-hidden md:grid-cols-[1fr_280px]">
  <div class="p-6 sm:p-8">
    <span class="badge tone-orange"><%- icon('lock', 'ico-sm') %>Niedostępne w obecnym planie</span>
    <h2 class="mt-4 font-display text-2xl font-bold">Aktywuj stronę biura</h2>
    <p class="mt-2 text-muted">Strona biura jest elementem indywidualnej umowy partnerskiej. Skontaktuj się z opiekunem – włączymy ją dla Twojego biura.</p>
    <ul class="mt-4 grid gap-2 text-sm"><% ['Własny kolor marki, logo i zdjęcie w tle','Sekcja zespołu z opisami agentów','Statystyki i wyróżniki biura','Formularz wyceny i kontaktu prosto do CRM','Własny tytuł i opis SEO'].forEach(function(x){ %><li class="flex gap-2"><%- icon('check', 'ico-sm text-teal-500 mt-0.5') %><%= x %></li><% }) %></ul>
    <a href="/biuro-panel/wspolpraca" class="btn btn-accent mt-6">Skontaktuj się z opiekunem</a>
  </div>
  <div class="mosaic-band hidden h-full min-h-[260px] md:block"><%- art.mosaic(4, 6, 99) %></div>
</div>
<% } else { %>
<form method="post" action="/biuro-panel/strona" class="mt-6 grid gap-6 xl:grid-cols-[1fr_340px]">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="grid content-start gap-6">
    <section class="card card-pad grid gap-4">
      <label class="flex items-center justify-between gap-4 rounded-2xl bg-paper p-4"><span><span class="block font-semibold">Strona opublikowana</span><span class="text-sm text-muted">Gdy wyłączona, pod adresem biura widoczny jest podstawowy profil.</span></span><input type="checkbox" name="enabled" class="check !h-6 !w-6" <%= ms.enabled ? 'checked' : '' %>></label>
      <div><label class="label" for="ms-head">Nagłówek</label><input id="ms-head" name="headline" maxlength="120" class="input" value="<%= ms.headline || '' %>" placeholder="<%= a.name %> – Twoje biuro nieruchomości w <%= (LOC.getCity(a.city) || {}).loc || 'regionie' %>"></div>
      <div><label class="label" for="ms-sub">Podtytuł</label><textarea id="ms-sub" name="subheadline" maxlength="300" class="textarea !min-h-[90px]"><%= ms.subheadline || '' %></textarea></div>
      <div><label class="label" for="ms-hl">Wyróżniki (jeden w linii, maks. 6)</label><textarea id="ms-hl" name="highlights" class="textarea !min-h-[120px]" placeholder="15 lat na rynku&#10;Ponad 600 transakcji&#10;Bezpłatna wycena"><%= (ms.highlights || []).join('\n') %></textarea></div>
      <div class="grid gap-3 sm:grid-cols-3">
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="showStats" class="check" <%= ms.showStats !== false ? 'checked' : '' %>>Statystyki</label>
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="showTeam" class="check" <%= ms.showTeam !== false ? 'checked' : '' %>>Zespół</label>
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="showContact" class="check" <%= ms.showContact !== false ? 'checked' : '' %>>Formularz kontaktu</label>
      </div>
    </section>
    <section class="card card-pad grid gap-4">
      <h2 class="font-display text-lg font-bold">SEO</h2>
      <div><label class="label" for="ms-slug">Adres strony</label><div class="flex items-center gap-2"><span class="shrink-0 text-sm text-muted">/biuro/</span><input id="ms-slug" name="slug" class="input" value="<%= a.slug %>"></div></div>
      <div><label class="label" for="ms-st">Tytuł w Google (do 70 znaków)</label><input id="ms-st" name="seoTitle" maxlength="70" class="input" value="<%= ms.seoTitle || '' %>" data-count="70"><p class="hint" data-count-out></p></div>
      <div><label class="label" for="ms-sd">Opis w Google (do 170 znaków)</label><textarea id="ms-sd" name="seoDescription" maxlength="170" class="textarea !min-h-[80px]" data-count="170"><%= ms.seoDescription || '' %></textarea><p class="hint" data-count-out></p></div>
    </section>
  </div>
  <aside class="grid content-start gap-4">
    <div class="card overflow-hidden"><div class="h-24" style="background: <%= a.brandColor %>"></div><div class="p-4 text-sm"><p class="font-semibold">Wygląd</p><p class="mt-1 text-muted">Logo, okładkę i kolor marki zmienisz w <a href="/biuro-panel/profil" class="font-semibold text-teal-600">profilu biura</a>.</p></div></div>
    <button class="btn btn-primary btn-lg">Zapisz stronę</button>
    <a href="/biuro/<%= a.slug %>" target="_blank" class="btn btn-outline"><%- icon('external', 'ico-sm') %>Podgląd</a>
  </aside>
</form>
<% } %>

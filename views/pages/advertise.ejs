<section class="wrap pt-6">
  <%- include('../partials/breadcrumbs') %>
  <div class="relative mt-4 overflow-hidden rounded-[2rem] bg-orange-500 text-white">
    <div class="mosaic-band absolute inset-y-0 right-0 hidden w-2/5 overflow-hidden opacity-35 md:block"><%- art.mosaic(6, 6, 51) %></div>
    <div class="relative max-w-3xl p-6 sm:p-12">
      <p class="text-xs font-bold uppercase tracking-[.16em] text-white/80">Reklama</p>
      <h1 class="mt-3 font-display text-4xl font-extrabold text-white sm:text-5xl">Reklamuj się tam, gdzie szuka się domu</h1>
      <p class="mt-4 text-lg text-white/90">Banki, doradcy kredytowi, deweloperzy, firmy wykończeniowe, przeprowadzkowe i meblowe – dotrzyj do osób kupujących i wynajmujących nieruchomości na Pomorzu i Pomorzu Zachodnim. Kampanie możesz kierować na wybrane miasta.</p>
      <a href="#formularz" class="btn btn-white btn-lg mt-7">Zapytaj o ofertę</a>
    </div>
  </div>
</section>
<section class="wrap py-16">
  <h2 class="h-section">Miejsca reklamowe</h2>
  <p class="mt-2 text-muted">Ceny i dostępność ustalamy indywidualnie, w zależności od miast, czasu emisji i formatu.</p>
  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% Object.keys(P.AD_PLACEMENTS).forEach(function(k, i){ var p = P.AD_PLACEMENTS[k]; %>
    <div class="card overflow-hidden">
      <div class="relative h-36 bg-paper p-4">
        <div class="grid h-full grid-cols-4 gap-1.5 opacity-60"><% for (var j = 0; j < 8; j++) { %><span class="rounded-md bg-white"></span><% } %></div>
        <span class="absolute <%= k.indexOf('tile') > -1 || k.indexOf('sidebar') > -1 ? 'right-4 top-4 bottom-4 w-1/4' : k.indexOf('inline') > -1 ? 'left-1/3 top-4 bottom-4 w-1/4' : 'inset-x-4 top-4 h-1/3' %> grid place-items-center rounded-lg bg-orange-500 text-[10px] font-bold uppercase tracking-wider text-white">Reklama</span>
      </div>
      <div class="p-5"><p class="font-display font-bold"><%= p.label %></p><p class="mt-1 text-sm text-muted">Grafika: <%= p.size %> · targetowanie na miasta</p></div>
    </div>
    <% }) %>
  </div>
</section>
<section id="formularz" class="wrap grid gap-10 pb-16 lg:grid-cols-[1fr_1.3fr]">
  <div>
    <h2 class="h-section">Zapytaj o kampanię</h2>
    <p class="mt-3 text-muted">Przygotujemy propozycję z wybranymi miejscami, miastami i terminem emisji.</p>
    <p class="mt-6 flex items-center gap-3"><span class="grid h-11 w-11 place-items-center rounded-full bg-orange-50 text-orange-600"><%- icon('mail', 'ico') %></span><span class="select-all font-semibold"><%= site.contact.adsEmail %></span></p>
  </div>
  <div class="card card-pad sm:p-8"><%- include('../partials/request-form', { kind: 'reklama', action: '/reklama' }) %></div>
</section>

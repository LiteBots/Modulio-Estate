<% var pm = LOC.MAJOR.filter(function(c){ return c.voivodeship === 'pomorskie'; }).slice(0, 14); var zm = LOC.MAJOR.filter(function(c){ return c.voivodeship === 'zachodniopomorskie'; }).slice(0, 14); %>
<footer class="mt-auto bg-navy-900 text-white/70">
  <div class="mosaic-band h-3 overflow-hidden"><%- art.mosaic(64, 1, 3) %></div>
  <div class="wrap pb-10 pt-14">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <%- include('logo', { dark: true }) %>
        <p class="mt-5 max-w-sm leading-relaxed">Regionalny portal ogłoszeń nieruchomości dla województwa pomorskiego i zachodniopomorskiego. Od Ustki i Słupska, przez Trójmiasto, po Koszalin i Szczecin.</p>
        <div class="mt-6 grid gap-2 text-sm">
          <span class="flex items-center gap-2"><%- icon('mail', 'ico-sm') %><span class="select-all"><%= site.contact.email %></span></span>
          <span class="flex items-center gap-2"><%- icon('phone', 'ico-sm') %><span class="select-all"><%= site.contact.phone %></span></span>
          <span class="flex items-center gap-2"><%- icon('clock', 'ico-sm') %><%= site.contact.hours %></span>
        </div>
        <div class="mt-6 flex gap-2">
          <% [['facebook','Facebook'],['instagram','Instagram'],['linkedin','LinkedIn'],['tiktok','TikTok'],['youtube','YouTube']].forEach(function(s){ %>
          <a href="<%= site.socials[s[0]] %>" target="_blank" rel="noopener" aria-label="<%= s[1] %>" class="grid h-10 w-10 place-items-center rounded-full bg-white/10 text-white transition hover:bg-orange-500"><%- icon(s[0], 'ico-sm') %></a>
          <% }) %>
        </div>
      </div>
      <div class="md:col-span-2">
        <p class="mb-4 font-display font-semibold text-white">Nieruchomości</p>
        <ul class="grid gap-2.5 text-sm">
          <% P.TYPES.slice(0,6).forEach(function(t){ %><li><a href="/sprzedaz/<%= t.slug %>" class="hover:text-white"><%= t.sale %></a></li><% }) %>
          <li><a href="/wynajem/mieszkania" class="hover:text-white">Mieszkania do wynajęcia</a></li>
          <li><a href="/sprzedaz/mieszkania?rynek=pierwotny" class="hover:text-white">Rynek pierwotny</a></li>
        </ul>
      </div>
      <div class="md:col-span-2">
        <p class="mb-4 font-display font-semibold text-white">Pomorskie</p>
        <ul class="grid gap-2.5 text-sm">
          <li><a href="/miasto/trojmiasto" class="hover:text-white">Trójmiasto</a></li>
          <% pm.forEach(function(c){ %><li><a href="/miasto/<%= c.slug %>" class="hover:text-white"><%= c.name %></a></li><% }) %>
        </ul>
      </div>
      <div class="md:col-span-2">
        <p class="mb-4 font-display font-semibold text-white">Zachodniopomorskie</p>
        <ul class="grid gap-2.5 text-sm">
          <% zm.forEach(function(c){ %><li><a href="/miasto/<%= c.slug %>" class="hover:text-white"><%= c.name %></a></li><% }) %>
          <li><a href="/miasta" class="font-semibold text-sun-300 hover:text-sun-200">Wszystkie miejscowości</a></li>
        </ul>
      </div>
      <div class="md:col-span-2">
        <p class="mb-4 font-display font-semibold text-white">Serwis</p>
        <ul class="grid gap-2.5 text-sm">
          <li><a href="/o-nas" class="hover:text-white">O nas</a></li>
          <li><a href="/zostan-partnerem" class="hover:text-white">Zostań partnerem</a></li>
          <li><a href="/reklama" class="hover:text-white">Reklama</a></li>
          <li><a href="/biura" class="hover:text-white">Biura nieruchomości</a></li>
          <li><a href="/raport-cen" class="hover:text-white">Raport cen</a></li>
          <li><a href="/kalkulator-kredytowy" class="hover:text-white">Kalkulator kredytowy</a></li>
          <li><a href="/poradnik" class="hover:text-white">Poradnik</a></li>
          <li><a href="/pomoc" class="hover:text-white">Pomoc</a></li>
          <li><a href="/kontakt" class="hover:text-white">Kontakt</a></li>
          <li><a href="/mapa-strony" class="hover:text-white">Mapa strony</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-6 text-sm text-white/45 md:flex-row md:items-center md:justify-between">
      <p>© <%= new Date().getFullYear() %> <%= site.name %> · <%= site.company.name %><%= site.company.nip && site.company.nip !== '[NIP]' ? ' · NIP ' + site.company.nip : '' %></p>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <a href="/regulamin" class="hover:text-white">Regulamin</a>
        <a href="/polityka-prywatnosci" class="hover:text-white">Polityka prywatności</a>
        <a href="/cookies" class="hover:text-white">Cookies</a>
        <a href="/kontakt#zgloszenia" class="hover:text-white">Zgłoś nielegalne treści</a>
      </div>
    </div>
  </div>
</footer>

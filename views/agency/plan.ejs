<% var a = agency; var p = a.plan; %>
<h1 class="font-display text-3xl font-extrabold">Współpraca i limity</h1>
<p class="mt-1 max-w-2xl text-muted">Warunki współpracy ustalamy indywidualnie. Jeśli potrzebujesz większych limitów, strony biura lub importu ofert – napisz do opiekuna.</p>
<div class="mt-6 grid gap-6 xl:grid-cols-[1fr_360px]">
  <div class="card overflow-hidden">
    <div class="flex items-center justify-between bg-navy-800 p-6 text-white"><div><p class="text-sm text-white/60">Plan</p><p class="font-display text-2xl font-bold text-white"><%= p.name %></p></div><% if (p.validUntil) { %><p class="text-sm text-white/70">ważny do <b class="text-white"><%= fmt.date(p.validUntil) %></b></p><% } %></div>
    <dl class="divide-y divide-line">
      <% [['Ogłoszenia (aktywne + szkice)', u.listings + ' / ' + p.maxListings],['Konta w zespole', a.members.length + ' / ' + p.maxAgents],['Sloty wyróżnień', u.featured + ' / ' + p.featuredSlots],['Podbicia w miesiącu', u.bumpsUsed + ' / ' + p.bumpsPerMonth],['Strona biura', p.microsite ? 'aktywna w planie' : 'niedostępna'],['Import XML', p.xmlImport ? 'aktywny' : 'niedostępny']].forEach(function(r){ %>
      <div class="flex justify-between gap-4 px-6 py-4"><dt class="text-muted"><%= r[0] %></dt><dd class="font-semibold num"><%= r[1] %></dd></div>
      <% }) %>
    </dl>
    <% if (p.notes) { %><p class="border-t border-line bg-paper px-6 py-4 text-sm text-muted"><%= p.notes %></p><% } %>
  </div>
  <div class="card card-pad">
    <span class="grid h-12 w-12 place-items-center rounded-2xl bg-orange-500 text-white"><%- icon('handshake', 'ico-lg') %></span>
    <h2 class="mt-5 font-display text-xl font-bold">Opiekun partnera</h2>
    <p class="mt-2 text-sm text-muted">Zmiana limitów, aktywacja strony biura, import XML, kampanie reklamowe.</p>
    <p class="mt-4 flex items-center gap-2 text-sm"><%- icon('mail', 'ico-sm text-teal-500') %><span class="select-all font-semibold"><%= site.contact.partnersEmail %></span></p>
    <p class="mt-1 flex items-center gap-2 text-sm"><%- icon('phone', 'ico-sm text-teal-500') %><span class="select-all font-semibold"><%= site.contact.phone %></span></p>
  </div>
</div>

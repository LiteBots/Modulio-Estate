<div class="mb-6 inline-flex rounded-lg border border-line p-1">
  <a href="/panel/obserwowane" class="rounded-md px-4 py-2 text-sm font-semibold <%= tab === 'ogloszenia' ? 'bg-navy-800 text-white' : 'text-muted' %>">Ogłoszenia (<%= listings.length %>)</a>
  <a href="/panel/obserwowane?tab=wyszukiwania" class="rounded-md px-4 py-2 text-sm font-semibold <%= tab === 'wyszukiwania' ? 'bg-navy-800 text-white' : 'text-muted' %>">Wyszukiwania (<%= searches.length %>)</a>
</div>

<% if (tab === 'ogloszenia') { %>
  <% if (listings.length) { %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><% listings.forEach(function(l){ %><div class="<%= ['active','reserved'].includes(l.status) ? '' : 'opacity-60' %>"><%- include('../partials/listing-card', { l: l }) %></div><% }) %></div>
  <% } else { %>
  <div class="rounded-xl border border-dashed border-line p-10 text-center">
    <%- icon('heart', 'ico-lg mx-auto text-muted') %>
    <p class="mt-3 font-semibold">Nie obserwujesz jeszcze żadnych ogłoszeń</p>
    <p class="mt-1 text-sm text-muted">Kliknij serce przy ogłoszeniu, aby je tu zapisać.</p>
    <a href="/sprzedaz/mieszkania" class="btn btn-primary mt-5">Przeglądaj ogłoszenia</a>
  </div>
  <% } %>
<% } else { %>
  <% if (searches.length) { %>
  <div class="grid gap-3">
    <% searches.forEach(function(s){ %>
    <form method="post" action="/panel/wyszukiwania/<%= s._id %>" class="flex flex-col gap-3 rounded-xl border border-line p-4 sm:flex-row sm:items-center">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="min-w-0 flex-1"><a href="<%= s.url %>" class="font-semibold hover:text-orange-600"><%= s.name %></a><p class="text-sm text-muted">Powiadomienia e-mail: <%= s.notify === 'off' ? 'wyłączone' : s.notify === 'instant' ? 'od razu' : 'raz dziennie' %></p></div>
      <select name="notify" class="select !w-auto text-sm" aria-label="Powiadomienia" data-autosubmit-field><option value="daily" <%= s.notify === 'daily' ? 'selected' : '' %>>Raz dziennie</option><option value="instant" <%= s.notify === 'instant' ? 'selected' : '' %>>Od razu</option><option value="off" <%= s.notify === 'off' ? 'selected' : '' %>>Wyłączone</option></select>
      <a href="<%= s.url %>" class="btn btn-outline btn-sm">Pokaż wyniki</a>
      <button name="action" value="delete" class="btn btn-ghost btn-sm" data-confirm="Usunąć to wyszukiwanie?" aria-label="Usuń"><%- icon('trash', 'ico-sm') %></button>
    </form>
    <% }) %>
  </div>
  <% } else { %>
  <div class="rounded-xl border border-dashed border-line p-10 text-center">
    <%- icon('bell', 'ico-lg mx-auto text-muted') %>
    <p class="mt-3 font-semibold">Brak zapisanych wyszukiwań</p>
    <p class="mt-1 text-sm text-muted">Na liście wyników kliknij „Zapisz wyszukiwanie”, a powiadomimy Cię o nowych ofertach.</p>
    <a href="/sprzedaz/mieszkania" class="btn btn-primary mt-5">Przejdź do wyszukiwarki</a>
  </div>
  <% } %>
<% } %>

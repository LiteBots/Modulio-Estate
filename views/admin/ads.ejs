<div class="flex flex-wrap items-end justify-between gap-4">
  <div><p class="text-sm text-muted">Reklamy</p><h1 class="font-display text-3xl font-extrabold">Kampanie reklamowe</h1><p class="mt-1 text-muted"><%= occupancy.length %> miejsc reklamowych · kierowanie na obszar z mapy, miasta, rodzaj oferty, cenę i urządzenie.</p></div>
  <a href="/admin/reklamy/nowa" class="btn btn-accent"><%- icon('plus', 'ico-sm') %>Nowa kampania</a>
</div>

<div class="mt-6 grid grid-cols-2 gap-3 xl:grid-cols-4">
  <div class="kpi"><p class="text-sm text-muted">Aktywne kampanie</p><p class="kpi-value"><%= fmt.num(k.live) %></p><p class="text-xs text-muted"><%= fmt.num(k.advertisers) %> reklamodawców</p></div>
  <div class="kpi"><p class="text-sm text-muted">Wyświetlenia (łącznie)</p><p class="kpi-value"><%= fmt.num(k.impressions) %></p></div>
  <div class="kpi"><p class="text-sm text-muted">Kliknięcia · CTR</p><p class="kpi-value"><%= fmt.num(k.clicks) %> · <%= k.impressions ? (k.clicks / k.impressions * 100).toFixed(2).replace('.', ',') : '0' %>%</p></div>
  <div class="kpi !border-navy-800 !bg-navy-800 text-white"><p class="text-sm text-white/70">Przychód z abonamentów reklam / mies.</p><p class="kpi-value !text-orange-400"><%= fmt.num(k.monthly) %> zł</p><p class="text-xs text-white/70">zajęte miejsca: <%= k.occupied %> z <%= occupancy.length %></p></div>
</div>

<div class="mt-8 flex items-center justify-between gap-3"><h2 class="font-display text-lg font-bold">Zajętość miejsc reklamowych</h2><p class="text-sm text-muted">Kliknij miejsce, aby utworzyć w nim kampanię.</p></div>
<div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
  <% occupancy.forEach(function(o){ %>
  <a href="/admin/reklamy/nowa?miejsce=<%= o.key %>" class="card p-4 transition hover:shadow-soft">
    <p class="text-[11px] font-bold uppercase tracking-widest text-muted"><%= o.group %></p>
    <p class="mt-1 font-semibold leading-snug"><%= o.short %></p>
    <p class="text-xs text-muted"><%= o.size %></p>
    <p class="mt-2 text-sm"><% if (o.count) { %><span class="badge tone-orange"><%= o.count === 1 ? 'zajęte' : o.count + ' w rotacji' %><%= o.endsAt ? ' do ' + fmt.dateShort(o.endsAt) : '' %></span><% } else { %><span class="badge tone-good">wolne</span><% } %></p>
  </a>
  <% }) %>
</div>

<div class="mt-8 flex flex-wrap gap-2">
  <% [['', 'Wszystkie', total], ['live', 'Aktywne', counts.live || 0], ['planned', 'Zaplanowane', counts.planned || 0], ['paused', 'Wstrzymane', counts.paused || 0], ['limit', 'Limit osiągnięty', counts.limit || 0], ['ended', 'Zakończone', counts.ended || 0]].forEach(function(f){ %>
  <a href="/admin/reklamy<%= f[0] ? '?status=' + f[0] : '' %>" class="rounded-full px-4 py-1.5 text-sm font-semibold ring-1 ring-line <%= filter === f[0] ? 'bg-navy-800 text-white' : 'bg-white text-muted hover:text-ink' %>"><%= f[1] %> (<%= f[2] %>)</a>
  <% }) %>
</div>

<div class="card mt-3 overflow-hidden"><div class="table-wrap"><table class="table num">
  <thead><tr><th>Kampania</th><th>Miejsca</th><th>Kierowanie</th><th>Okres</th><th class="!text-right">Wyśw.</th><th class="!text-right">Klik.</th><th class="!text-right">CTR</th><th class="!text-right">Przychód</th><th>Status</th><th></th></tr></thead>
  <tbody><% ads.forEach(function(a){ %>
    <tr>
      <td><div class="flex items-center gap-3"><% if (a.image) { %><img src="<%= a.image %>" alt="" class="h-9 w-14 shrink-0 rounded-md object-cover"><% } %><div><a href="/admin/reklamy/<%= a._id %>" class="font-semibold hover:text-orange-600"><%= a.name %></a><p class="text-xs text-muted"><%= a.advertiser || '' %></p></div></div></td>
      <td><div class="flex max-w-[220px] flex-wrap gap-1"><% a.placementsList.forEach(function(p){ %><span class="badge tone-info"><%= (P.AD_PLACEMENTS[p] || {}).short || p %></span><% }) %></div></td>
      <td><div class="flex max-w-[260px] flex-wrap gap-1"><% a.targeting.forEach(function(t){ %><span class="badge tone-muted"><%= t %></span><% }) %></div></td>
      <td class="whitespace-nowrap text-sm"><%= a.startsAt ? fmt.dateShort(a.startsAt) : '–' %> → <%= a.endsAt ? fmt.dateShort(a.endsAt) : '–' %></td>
      <td class="text-right"><%= fmt.num(a.impressions) %><% if (a.maxImpressions) { %><span class="block text-xs text-muted">/ <%= fmt.num(a.maxImpressions) %></span><% } %></td>
      <td class="text-right"><%= fmt.num(a.clicks) %></td>
      <td class="text-right"><%= a.impressions ? (a.clicks / a.impressions * 100).toFixed(2).replace('.', ',') : '0' %>%</td>
      <td class="text-right"><%= a.revenue ? fmt.num(a.revenue) + ' zł' : '–' %><% if (a.billing && a.billing !== 'flat' && a.price) { %><span class="block text-xs text-muted"><%= a.billing === 'cpm' ? fmt.num(a.price) + ' zł / 1000' : fmt.num(a.price) + ' zł / klik' %></span><% } %></td>
      <td><span class="badge <%= a.status.tone %>"><%= a.status.label %></span></td>
      <td><form method="post" action="/admin/reklamy/<%= a._id %>/przelacz"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="<%= filter %>"><button class="btn btn-outline btn-sm"><%= a.active ? 'Wstrzymaj' : 'Włącz' %></button></form></td>
    </tr>
  <% }) %><% if (!ads.length) { %><tr><td colspan="10" class="py-10 text-center text-muted">Brak kampanii w tym widoku. Puste miejsca reklamowe pokazują zachętę „Twoja reklama w tym miejscu”.</td></tr><% } %></tbody>
</table></div></div>

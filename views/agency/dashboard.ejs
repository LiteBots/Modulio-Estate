<% var a = agency; var pct = function(x, y){ return y ? Math.min(100, Math.round(x / y * 100)) : 0; }; %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div><p class="text-sm text-muted"><%= a.name %></p><h1 class="font-display text-3xl font-extrabold">Pulpit biura</h1></div>
  <div class="flex gap-2"><a href="/biuro-panel/zapytania" class="btn btn-outline"><%- icon('inbox', 'ico-sm') %>Zapytania<% if (newLeads) { %><span class="badge bg-orange-500 text-white"><%= newLeads %></span><% } %></a><a href="/biuro-panel/ogloszenia/nowe" class="btn btn-accent"><%- icon('plus', 'ico-sm') %>Dodaj ogłoszenie</a></div>
</div>

<div class="mt-6 grid grid-cols-2 gap-3 xl:grid-cols-4">
  <div class="kpi"><p class="text-sm text-muted">Wyświetlenia (30 dni)</p><p class="kpi-value"><%= fmt.num(kpi.views) %></p><div class="mt-2"><%- sparks.views %></div></div>
  <div class="kpi"><p class="text-sm text-muted">Odsłony telefonu</p><p class="kpi-value"><%= fmt.num(kpi.phone) %></p><div class="mt-2"><%- sparks.phone %></div></div>
  <div class="kpi"><p class="text-sm text-muted">Zapytania</p><p class="kpi-value"><%= fmt.num(kpi.inquiries) %></p><div class="mt-2"><%- sparks.inquiries %></div></div>
  <div class="kpi"><p class="text-sm text-muted">Konwersja wyśw. → kontakt</p><p class="kpi-value"><%= kpi.views ? ((kpi.phone + kpi.inquiries) / kpi.views * 100).toFixed(1).replace('.', ',') : '0' %>%</p><p class="mt-2 text-xs text-muted">telefony + zapytania</p></div>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-[1.6fr_1fr]">
  <div class="card card-pad min-w-0">
    <div class="flex flex-wrap items-center justify-between gap-3"><h2 class="font-display text-lg font-bold">Aktywność ofert – 30 dni</h2>
      <div class="flex gap-3 text-xs"><span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-teal-500"></span>Wyświetlenia</span><span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-orange-500"></span>Telefony</span><span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-navy-800"></span>Zapytania</span></div></div>
    <div class="mt-4 overflow-x-auto"><div class="min-w-[520px]"><%- chart %></div></div>
  </div>
  <div class="card card-pad">
    <h2 class="font-display text-lg font-bold">Wykorzystanie planu</h2>
    <div class="mt-5 grid gap-5">
      <div><div class="flex justify-between text-sm"><span>Ogłoszenia</span><b class="num"><%= u.listings %> / <%= a.plan.maxListings %></b></div><div class="mt-2 h-2.5 overflow-hidden rounded-full bg-paper"><div class="h-full rounded-full bg-navy-800" style="width: <%= pct(u.listings, a.plan.maxListings) %>%"></div></div></div>
      <div><div class="flex justify-between text-sm"><span>Wyróżnienia</span><b class="num"><%= u.featured %> / <%= a.plan.featuredSlots %></b></div><div class="mt-2 h-2.5 overflow-hidden rounded-full bg-paper"><div class="h-full rounded-full bg-sun-400" style="width: <%= pct(u.featured, a.plan.featuredSlots) %>%"></div></div></div>
      <div><div class="flex justify-between text-sm"><span>Podbicia w tym miesiącu</span><b class="num"><%= u.bumpsUsed %> / <%= a.plan.bumpsPerMonth %></b></div><div class="mt-2 h-2.5 overflow-hidden rounded-full bg-paper"><div class="h-full rounded-full bg-teal-500" style="width: <%= pct(u.bumpsUsed, a.plan.bumpsPerMonth) %>%"></div></div></div>
      <div><div class="flex justify-between text-sm"><span>Konta w zespole</span><b class="num"><%= a.members.length %> / <%= a.plan.maxAgents %></b></div><div class="mt-2 h-2.5 overflow-hidden rounded-full bg-paper"><div class="h-full rounded-full bg-orange-500" style="width: <%= pct(a.members.length, a.plan.maxAgents) %>%"></div></div></div>
    </div>
    <a href="/biuro-panel/wspolpraca" class="btn btn-outline btn-sm mt-6">Potrzebujesz więcej? Napisz do opiekuna</a>
  </div>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-3">
  <div class="card card-pad xl:col-span-2">
    <div class="flex items-center justify-between"><h2 class="font-display text-lg font-bold">Najnowsze zapytania</h2><a href="/biuro-panel/zapytania" class="text-sm font-semibold text-teal-600">CRM</a></div>
    <% if (leads.length) { %>
    <div class="table-wrap mt-3"><table class="table"><thead><tr><th>Klient</th><th>Oferta</th><th>Status</th><th>Kiedy</th></tr></thead><tbody>
      <% leads.forEach(function(ld){ var st = P.LEAD_STATUS[ld.status]; %>
      <tr><td><a href="/biuro-panel/zapytania/<%= ld._id %>" class="font-semibold hover:text-teal-600"><%= ld.name %></a><p class="text-xs text-muted"><%= ld.email %></p></td><td class="max-w-[260px] truncate text-sm"><%= ld.listing ? ld.listing.title : 'Strona biura' %></td><td><span class="badge tone-<%= st.tone %>"><%= st.label %></span></td><td class="whitespace-nowrap text-sm text-muted"><%= fmt.timeAgo(ld.createdAt) %></td></tr>
      <% }) %></tbody></table></div>
    <% } else { %><p class="mt-4 text-sm text-muted">Brak zapytań. Pojawią się po opublikowaniu ofert.</p><% } %>
  </div>
  <div class="card card-pad">
    <h2 class="font-display text-lg font-bold">Lejek sprzedaży</h2>
    <div class="mt-4 grid gap-2">
      <% Object.keys(P.LEAD_STATUS).forEach(function(k){ var n = pipeline[k] || 0; %>
      <a href="/biuro-panel/zapytania" class="flex items-center justify-between rounded-xl bg-paper px-3 py-2.5 text-sm hover:bg-navy-50"><span class="badge tone-<%= P.LEAD_STATUS[k].tone %>"><%= P.LEAD_STATUS[k].label %></span><b class="num"><%= n %></b></a>
      <% }) %>
    </div>
  </div>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-2">
  <div class="card card-pad">
    <h2 class="font-display text-lg font-bold">Najczęściej oglądane</h2>
    <% if (top.length) { %><ul class="mt-3 divide-y divide-line"><% top.forEach(function(l){ %><li class="flex items-center justify-between gap-3 py-3"><a href="<%= l.url %>" target="_blank" class="min-w-0 truncate font-semibold hover:text-teal-600"><%= l.title %></a><span class="shrink-0 text-sm text-muted num"><%= fmt.num(l.views) %> wyśw.</span></li><% }) %></ul><% } else { %><p class="mt-3 text-sm text-muted">Brak danych.</p><% } %>
  </div>
  <div class="card card-pad">
    <h2 class="font-display text-lg font-bold">Wygasają w ciągu 7 dni</h2>
    <% if (expiring.length) { %><ul class="mt-3 divide-y divide-line"><% expiring.forEach(function(l){ %><li class="flex items-center justify-between gap-3 py-3"><span class="min-w-0 truncate font-semibold"><%= l.title %></span><form method="post" action="/biuro-panel/ogloszenia/<%= l._id %>/akcja"><input type="hidden" name="_csrf" value="<%= csrf %>"><button name="action" value="active" class="btn btn-outline btn-sm">Przedłuż</button></form></li><% }) %></ul><% } else { %><p class="mt-3 text-sm text-muted">Żadna oferta nie wygasa w najbliższym tygodniu.</p><% } %>
  </div>
</div>

<header class="sticky-top sticky z-50 border-b border-line bg-white/95 backdrop-blur-xl">
  <div class="flex h-16 items-center justify-between gap-4 px-4 lg:px-6">
    <div class="flex items-center gap-3">
      <button type="button" class="btn-icon lg:hidden" data-toggle="#dashSide" aria-label="Menu panelu" aria-expanded="false"><%- icon('menu', 'ico') %></button>
      <%- include('logo') %>
      <span class="hidden rounded-full bg-paper px-3 py-1 text-xs font-bold uppercase tracking-widest text-muted sm:inline"><%= area %></span>
    </div>
    <div class="flex items-center gap-2">
      <a href="/" class="btn btn-ghost btn-sm hidden sm:inline-flex"><%- icon('external', 'ico-sm') %>Serwis</a>
      <% if (user.agency && area !== 'Panel biura') { %><a href="/biuro-panel" class="btn btn-ghost btn-sm hidden md:inline-flex"><%- icon('briefcase', 'ico-sm') %>Panel biura</a><% } %>
      <% if (area !== 'Mój panel') { %><a href="/panel" class="btn btn-ghost btn-sm hidden md:inline-flex"><%- icon('user', 'ico-sm') %>Mój panel</a><% } %>
      <% if (user.role === 'admin' && area !== 'Administracja') { %><a href="/admin" class="btn btn-ghost btn-sm hidden md:inline-flex"><%- icon('shield', 'ico-sm') %>Admin</a><% } %>
      <form method="post" action="/wyloguj"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline btn-sm"><%- icon('logout', 'ico-sm') %><span class="hidden sm:inline">Wyloguj</span></button></form>
    </div>
  </div>
</header>

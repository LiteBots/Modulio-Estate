<% var a = agency; %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div><h1 class="font-display text-3xl font-extrabold">Ogłoszenia biura</h1><p class="mt-1 text-sm text-muted num">Aktywne i szkice: <%= u.listings %> / <%= a.plan.maxListings %> · wyróżnienia: <%= u.featured %> / <%= a.plan.featuredSlots %> · podbicia: <%= u.bumpsUsed %> / <%= a.plan.bumpsPerMonth %></p></div>
  <a href="/biuro-panel/ogloszenia/nowe" class="btn btn-accent"><%- icon('plus', 'ico-sm') %>Dodaj ogłoszenie</a>
</div>
<div class="mt-5 flex flex-wrap items-center justify-between gap-3">
  <div class="flex max-w-full gap-1 overflow-x-auto rounded-full bg-white p-1 ring-1 ring-line hide-scrollbar">
    <% [['','Bieżące'],['active','Aktywne'],['draft','Szkice'],['reserved','Rezerwacje'],['sold','Sprzedane'],['archived','Archiwum'],['wszystkie','Wszystkie']].forEach(function(x){ %>
    <a href="/biuro-panel/ogloszenia<%= x[0] ? '?status=' + x[0] : '' %>" class="whitespace-nowrap rounded-full px-3.5 py-1.5 text-sm font-semibold <%= st === x[0] ? 'bg-navy-800 text-white' : 'text-muted hover:text-navy-900' %>"><%= x[1] %><% if (x[0] && counts[x[0]]) { %> <span class="opacity-70 num"><%= counts[x[0]] %></span><% } %></a>
    <% }) %>
  </div>
  <form method="get" class="flex flex-wrap gap-2"><% if (st) { %><input type="hidden" name="status" value="<%= st %>"><% } %>
    <select name="agent" class="select !w-auto text-sm" aria-label="Agent" data-autosubmit-field><option value="">Wszyscy agenci</option><% a.members.forEach(function(m){ if (m.user) { %><option value="<%= m.user._id %>" <%= query.agent === String(m.user._id) ? 'selected' : '' %>><%= m.user.name || m.user.email %></option><% } }) %></select>
    <input name="q" class="input min-w-0 flex-1 text-sm sm:!w-48 sm:flex-none" placeholder="Tytuł lub nr ref." value="<%= query.q || '' %>"><button class="btn btn-outline btn-sm"><%- icon('search', 'ico-sm') %></button></form>
</div>

<% if (listings.length) { %>
<div class="card mt-5 overflow-hidden">
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Oferta</th><th>Status</th><th class="!text-right">Cena</th><th class="!text-right">Statystyki</th><th>Agent</th><th class="!text-right">Akcje</th></tr></thead>
    <tbody>
      <% listings.forEach(function(l){ var featured = l.featuredUntil && new Date(l.featuredUntil) > new Date(); %>
      <tr>
        <td class="min-w-[280px]"><div class="flex items-center gap-3">
          <a href="<%= l.url %>" target="_blank" class="scene h-12 w-16 shrink-0 overflow-hidden rounded-lg"><% if (l.images && l.images[0]) { %><img src="<%= l.images[0].url %>" alt=""><% } else { %><%- art.sceneFor(l) %><% } %></a>
          <div class="min-w-0"><a href="/biuro-panel/ogloszenia/<%= l._id %>/edytuj" class="block max-w-[320px] truncate font-semibold hover:text-teal-600"><%= l.title %></a><p class="text-xs text-muted">nr <%= l.num %><%= l.refNumber ? ' · ' + l.refNumber : '' %> · <%= l.cityName %><%= featured ? ' · ' : '' %><% if (featured) { %><span class="font-semibold text-sun-600">wyróżnione do <%= fmt.dateShort(l.featuredUntil) %></span><% } %></p></div>
        </div></td>
        <td><%- include('../partials/status-badge', { s: l.status }) %></td>
        <td class="whitespace-nowrap text-right font-semibold num"><%= fmt.price(l.price, l.transaction) %></td>
        <td class="whitespace-nowrap text-right text-sm text-muted num"><%= fmt.num(l.views) %> · <%= l.phoneReveals %> · <%= l.inquiriesCount %></td>
        <td class="whitespace-nowrap text-sm"><%= l.agent ? l.agent.name : '–' %></td>
        <td class="text-right">
          <form method="post" action="/biuro-panel/ogloszenia/<%= l._id %>/akcja" class="flex justify-end gap-1">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <a href="/biuro-panel/ogloszenia/<%= l._id %>/edytuj" class="btn btn-ghost btn-sm" title="Edytuj"><%- icon('edit', 'ico-sm') %></a>
            <% if (l.status === 'active') { %>
              <button name="action" value="bump" class="btn btn-ghost btn-sm" title="Podbij na górę"><%- icon('rotate', 'ico-sm') %></button>
              <button name="action" value="feature" class="btn btn-ghost btn-sm <%= featured ? 'text-sun-500' : '' %>" title="<%= featured ? 'Zdejmij wyróżnienie' : 'Wyróżnij na 14 dni' %>"><%- icon('star', 'ico-sm', featured ? 'fill="currentColor"' : '') %></button>
            <% } %>
            <details class="relative"><summary class="btn btn-ghost btn-sm list-none [&::-webkit-details-marker]:hidden"><%- icon('chevron-down', 'ico-sm') %></summary>
              <div class="absolute right-0 z-20 mt-1 grid w-48 gap-0.5 rounded-2xl border border-line bg-white p-1.5 text-left shadow-lift">
                <% if (l.status !== 'active') { %><button name="action" value="active" class="side-link !py-2 text-sm">Publikuj</button><% } %>
                <% if (l.status !== 'reserved') { %><button name="action" value="reserved" class="side-link !py-2 text-sm">Rezerwacja</button><% } %>
                <% if (l.status !== 'sold') { %><button name="action" value="sold" class="side-link !py-2 text-sm">Sprzedane / wynajęte</button><% } %>
                <% if (l.status !== 'archived') { %><button name="action" value="archived" class="side-link !py-2 text-sm">Archiwizuj</button><% } %>
                <button name="action" value="duplicate" class="side-link !py-2 text-sm">Duplikuj</button>
                <% if (isManager) { %><button name="action" value="delete" class="side-link !py-2 text-sm text-red-600" data-confirm="Usunąć ogłoszenie na stałe?">Usuń</button><% } %>
              </div>
            </details>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table></div>
</div>
<p class="mt-3 text-xs text-muted">Statystyki: wyświetlenia · odsłony telefonu · zapytania (łącznie).</p>
<% } else { %>
<div class="card mt-6 p-10 text-center"><p class="font-display text-xl font-bold">Brak ogłoszeń w tym widoku</p><a href="/biuro-panel/ogloszenia/nowe" class="btn btn-accent mt-5">Dodaj ogłoszenie</a></div>
<% } %>

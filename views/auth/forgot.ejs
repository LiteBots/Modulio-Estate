<%- include('../partials/auth-shell-start') %>
  <h1 class="font-display text-3xl font-extrabold">Reset hasła</h1>
  <% if (sent) { %>
  <div class="alert alert-success mt-6"><%- icon('check-circle', 'ico mt-px') %><span>Jeśli konto z tym adresem istnieje, wysłaliśmy link do ustawienia nowego hasła. Sprawdź skrzynkę (także folder spam). Link jest ważny przez godzinę.</span></div>
  <a href="/logowanie" class="btn btn-outline mt-6">Wróć do logowania</a>
  <% } else { %>
  <p class="mt-2 text-muted">Podaj e-mail konta – wyślemy link do ustawienia nowego hasła.</p>
  <form method="post" action="/zapomnialem-hasla" class="mt-8 grid gap-4">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div><label class="label" for="email">E-mail</label><input id="email" name="email" type="email" required class="input"></div>
    <button class="btn btn-primary btn-lg w-full">Wyślij link</button>
    <a href="/logowanie" class="text-center text-sm font-semibold text-muted hover:text-navy-900">Wróć do logowania</a>
  </form>
  <% } %>
<%- include('../partials/auth-shell-end') %>

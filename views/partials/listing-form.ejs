<%
  var v = function(k){ return l[k] === undefined || l[k] === null ? '' : l[k]; };
  var feats = (l.features || []).map(String);
  var isAgency = mode === 'agency';
  var allDistricts = {}; LOC.CITIES.forEach(function(c){ if (c.districts.length) allDistricts[c.slug] = c.districts; });
%>
<form method="post" action="<%= action %>" enctype="multipart/form-data" class="grid gap-6" data-listing-form data-districts='<%- JSON.stringify(allDistricts).replace(/'/g, "&#39;") %>'>
  <input type="hidden" name="_csrf" value="<%= csrf %>">

  <% if (errors && errors.length) { %>
  <div class="alert alert-error"><%- icon('alert', 'ico mt-px') %><ul class="grid gap-1"><% errors.forEach(function(e){ %><li><%= e %></li><% }) %></ul></div>
  <% } %>

  <section class="card card-pad">
    <h2 class="flex items-center gap-2 font-display text-lg font-bold"><span class="grid h-7 w-7 place-items-center rounded-full bg-navy-800 text-xs text-white">1</span>Podstawowe informacje</h2>
    <div class="mt-5 grid gap-5">
      <div class="grid gap-3 sm:grid-cols-2">
        <div><span class="label">Transakcja</span><div class="grid grid-cols-2 gap-2">
          <% [['sprzedaz','Sprzedaż'],['wynajem','Wynajem']].forEach(function(o){ %><label class="cursor-pointer"><input type="radio" name="transaction" value="<%= o[0] %>" class="peer sr-only" <%= v('transaction') === o[0] ? 'checked' : '' %> data-tr><span class="block rounded-2xl border border-line py-3 text-center font-semibold peer-checked:border-navy-800 peer-checked:bg-navy-800 peer-checked:text-white"><%= o[1] %></span></label><% }) %>
        </div></div>
        <div><span class="label">Rynek</span><div class="grid grid-cols-2 gap-2">
          <% [['wtorny','Wtórny'],['pierwotny','Pierwotny']].forEach(function(o){ %><label class="cursor-pointer"><input type="radio" name="market" value="<%= o[0] %>" class="peer sr-only" <%= v('market') === o[0] ? 'checked' : '' %>><span class="block rounded-2xl border border-line py-3 text-center font-semibold peer-checked:border-teal-500 peer-checked:bg-teal-500 peer-checked:text-white"><%= o[1] %></span></label><% }) %>
        </div></div>
      </div>
      <div><span class="label">Rodzaj nieruchomości</span>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
          <% P.TYPES.forEach(function(t){ %><label class="cursor-pointer"><input type="radio" name="type" value="<%= t.key %>" class="peer sr-only" <%= v('type') === t.key ? 'checked' : '' %> data-type><span class="flex items-center gap-2 rounded-2xl border border-line px-3 py-3 text-sm font-semibold peer-checked:border-navy-800 peer-checked:bg-navy-50"><%- icon(t.icon, 'ico-sm text-teal-500') %><%= t.label %></span></label><% }) %>
        </div></div>
      <div><label class="label" for="lf-title">Tytuł ogłoszenia</label><input id="lf-title" name="title" required maxlength="140" class="input" value="<%= v('title') %>" placeholder="np. 3 pokoje z balkonem, 10 min do plaży – Ustka" data-count="140"><p class="hint" data-count-out></p></div>
    </div>
  </section>

  <section class="card card-pad">
    <h2 class="flex items-center gap-2 font-display text-lg font-bold"><span class="grid h-7 w-7 place-items-center rounded-full bg-navy-800 text-xs text-white">2</span>Cena</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-3">
      <div><label class="label" for="lf-price"><span data-price-label>Cena (zł)</span></label><input id="lf-price" name="price" required inputmode="numeric" class="input num" value="<%= v('price') %>"></div>
      <div><label class="label" for="lf-rent">Czynsz / opłaty (zł/mc)</label><input id="lf-rent" name="rentExtra" inputmode="numeric" class="input num" value="<%= v('rentExtra') %>"></div>
      <div data-rent-only><label class="label" for="lf-dep">Kaucja (zł)</label><input id="lf-dep" name="deposit" inputmode="numeric" class="input num" value="<%= v('deposit') %>"></div>
    </div>
    <div class="mt-4 flex flex-wrap gap-5 text-sm">
      <label class="flex items-center gap-2"><input type="checkbox" name="negotiable" class="check" <%= l.negotiable ? 'checked' : '' %>>Cena do negocjacji</label>
      <label class="flex items-center gap-2"><input type="checkbox" name="noCommission" class="check" <%= l.noCommission || (!isAgency && isNew) ? 'checked' : '' %>>Bez prowizji dla kupującego / najemcy</label>
    </div>
  </section>

  <section class="card card-pad">
    <h2 class="flex items-center gap-2 font-display text-lg font-bold"><span class="grid h-7 w-7 place-items-center rounded-full bg-navy-800 text-xs text-white">3</span>Parametry</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div><label class="label" for="lf-area">Powierzchnia (m²)</label><input id="lf-area" name="area" inputmode="decimal" class="input num" value="<%= v('area') %>"></div>
      <div data-hide-for="dzialka,garaz,magazyn"><label class="label" for="lf-rooms">Liczba pokoi</label><input id="lf-rooms" name="rooms" inputmode="numeric" class="input num" value="<%= v('rooms') %>"></div>
      <div data-hide-for="dzialka,dom,garaz"><label class="label" for="lf-floor">Piętro (0 = parter)</label><input id="lf-floor" name="floor" inputmode="numeric" class="input num" value="<%= v('floor') %>"></div>
      <div data-hide-for="dzialka,garaz"><label class="label" for="lf-floors">Liczba pięter w budynku</label><input id="lf-floors" name="floorsTotal" inputmode="numeric" class="input num" value="<%= v('floorsTotal') %>"></div>
      <div data-hide-for="dzialka"><label class="label" for="lf-year">Rok budowy</label><input id="lf-year" name="yearBuilt" inputmode="numeric" class="input num" value="<%= v('yearBuilt') %>"></div>
      <div data-show-for="dom,dzialka,magazyn"><label class="label" for="lf-plot">Powierzchnia działki (m²)</label><input id="lf-plot" name="plotArea" inputmode="numeric" class="input num" value="<%= v('plotArea') %>"></div>
      <div data-show-for="dzialka"><label class="label" for="lf-plottype">Rodzaj działki</label><select id="lf-plottype" name="plotType" class="select"><option value="">–</option><% P.OPTIONS.plotType.forEach(function(o){ %><option <%= v('plotType') === o ? 'selected' : '' %>><%= o %></option><% }) %></select></div>
      <div data-hide-for="dzialka"><label class="label" for="lf-bt">Typ budynku</label><select id="lf-bt" name="buildingType" class="select"><option value="">–</option><% P.OPTIONS.buildingType.forEach(function(o){ %><option <%= v('buildingType') === o ? 'selected' : '' %>><%= o %></option><% }) %></select></div>
      <div data-hide-for="dzialka"><label class="label" for="lf-cond">Stan</label><select id="lf-cond" name="condition" class="select"><option value="">–</option><% P.OPTIONS.condition.forEach(function(o){ %><option <%= v('condition') === o ? 'selected' : '' %>><%= o %></option><% }) %></select></div>
      <div data-hide-for="dzialka,garaz"><label class="label" for="lf-heat">Ogrzewanie</label><select id="lf-heat" name="heating" class="select"><option value="">–</option><% P.OPTIONS.heating.forEach(function(o){ %><option <%= v('heating') === o ? 'selected' : '' %>><%= o %></option><% }) %></select></div>
      <div><label class="label" for="lf-own">Forma własności</label><select id="lf-own" name="ownership" class="select"><option value="">–</option><% P.OPTIONS.ownership.forEach(function(o){ %><option <%= v('ownership') === o ? 'selected' : '' %>><%= o %></option><% }) %></select></div>
      <div><label class="label" for="lf-avail">Dostępne od</label><input id="lf-avail" name="availableFrom" type="date" class="input" value="<%= fmt.inputDate(l.availableFrom) %>"></div>
    </div>
    <p class="label mt-6">Udogodnienia</p>
    <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      <% P.FEATURES.forEach(function(ft){ %><label class="flex items-center gap-2.5 rounded-xl border border-line px-3 py-2.5 text-sm has-[:checked]:border-teal-400 has-[:checked]:bg-teal-50"><input type="checkbox" name="features" value="<%= ft[0] %>" class="check" <%= feats.includes(ft[0]) ? 'checked' : '' %>><%= ft[1] %></label><% }) %>
    </div>
  </section>

  <section class="card card-pad">
    <h2 class="flex items-center gap-2 font-display text-lg font-bold"><span class="grid h-7 w-7 place-items-center rounded-full bg-navy-800 text-xs text-white">4</span>Lokalizacja</h2>
    <p class="mt-1 text-sm text-muted">Serwis obejmuje województwo pomorskie i zachodniopomorskie.</p>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <div><label class="label" for="lf-city">Miejscowość</label>
        <select id="lf-city" name="city" required class="select" data-city>
          <option value="">Wybierz…</option>
          <optgroup label="Pomorskie"><% LOC.CITIES.filter(function(c){ return c.voivodeship === 'pomorskie'; }).sort(function(a,b){ return a.name.localeCompare(b.name, 'pl'); }).forEach(function(c){ %><option value="<%= c.slug %>" <%= v('city') === c.slug ? 'selected' : '' %>><%= c.name %></option><% }) %></optgroup>
          <optgroup label="Zachodniopomorskie"><% LOC.CITIES.filter(function(c){ return c.voivodeship === 'zachodniopomorskie'; }).sort(function(a,b){ return a.name.localeCompare(b.name, 'pl'); }).forEach(function(c){ %><option value="<%= c.slug %>" <%= v('city') === c.slug ? 'selected' : '' %>><%= c.name %></option><% }) %></optgroup>
        </select>
        <p class="hint">Nie ma Twojej miejscowości? Wybierz najbliższą i wpisz nazwę wsi w polu „Dzielnica / osiedle”.</p></div>
      <div><label class="label" for="lf-district">Dzielnica / osiedle / wieś</label><input id="lf-district" name="district" list="districtList" class="input" value="<%= v('district') %>"><datalist id="districtList"></datalist></div>
      <div><label class="label" for="lf-street">Ulica</label><input id="lf-street" name="street" class="input" value="<%= v('street') %>"></div>
      <div class="grid grid-cols-2 gap-2"><div><label class="label" for="lf-lat">Szer. geogr.</label><input id="lf-lat" name="lat" inputmode="decimal" class="input num" value="<%= v('lat') %>" placeholder="54.464"></div><div><label class="label" for="lf-lng">Dł. geogr.</label><input id="lf-lng" name="lng" inputmode="decimal" class="input num" value="<%= v('lng') %>" placeholder="17.028"></div></div>
    </div>
    <label class="mt-4 flex items-center gap-2 text-sm"><input type="checkbox" name="showExactAddress" class="check" <%= l.showExactAddress ? 'checked' : '' %>>Pokaż dokładny adres i pinezkę na mapie (domyślnie widoczna tylko okolica)</label>
  </section>

  <section class="card card-pad">
    <h2 class="flex items-center gap-2 font-display text-lg font-bold"><span class="grid h-7 w-7 place-items-center rounded-full bg-navy-800 text-xs text-white">5</span>Zdjęcia i multimedia</h2>
    <% if (l.images && l.images.length) { %>
    <p class="mt-4 text-sm text-muted">Odznacz zdjęcia do usunięcia. Wybierz zdjęcie główne.</p>
    <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">
      <% l.images.forEach(function(im, i){ %>
      <div class="overflow-hidden rounded-2xl border border-line bg-white">
        <img src="<%= im.url %>" alt="" class="aspect-[4/3] w-full object-cover">
        <div class="grid gap-1 p-2 text-xs">
          <label class="flex items-center gap-1.5"><input type="checkbox" name="keepImages" value="<%= im.url %>" checked class="check">Zachowaj</label>
          <label class="flex items-center gap-1.5"><input type="radio" name="cover" value="<%= im.url %>" <%= i === 0 ? 'checked' : '' %> class="accent-orange-500">Główne</label>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
    <label class="mt-4 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-3xl border-2 border-dashed border-navy-200 bg-paper px-6 py-10 text-center transition hover:border-teal-400 hover:bg-teal-50" data-dropzone>
      <%- icon('upload', 'ico-lg text-teal-500') %>
      <span class="font-semibold">Dodaj zdjęcia</span>
      <span class="text-sm text-muted">JPG, PNG, WEBP · do 10 MB · maks. <%= isAgency ? 40 : 30 %> zdjęć. Pierwsze zdjęcie będzie główne.</span>
      <input type="file" name="images" accept="image/jpeg,image/png,image/webp,image/avif" multiple class="sr-only" data-file-input>
    </label>
    <div class="mt-3 grid grid-cols-3 gap-2 sm:grid-cols-6" data-file-preview></div>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <div><label class="label" for="lf-video">Film (YouTube)</label><input id="lf-video" name="videoUrl" type="url" class="input" value="<%= v('videoUrl') %>" placeholder="https://www.youtube.com/watch?v=…"></div>
      <div><label class="label" for="lf-tour">Wirtualny spacer 3D</label><input id="lf-tour" name="virtualTourUrl" type="url" class="input" value="<%= v('virtualTourUrl') %>" placeholder="https://…"></div>
    </div>
  </section>

  <section class="card card-pad">
    <h2 class="flex items-center gap-2 font-display text-lg font-bold"><span class="grid h-7 w-7 place-items-center rounded-full bg-navy-800 text-xs text-white">6</span>Opis</h2>
    <textarea name="description" required class="textarea mt-5 !min-h-[240px]" maxlength="12000" data-count="12000" placeholder="Opisz układ, stan, okolicę (szkoła, przystanek, sklepy, odległość od morza), koszty utrzymania i stan prawny. Listę wypunktujesz, zaczynając linie od myślnika."><%= v('description') %></textarea>
    <p class="hint" data-count-out></p>
  </section>

  <section class="card card-pad">
    <h2 class="flex items-center gap-2 font-display text-lg font-bold"><span class="grid h-7 w-7 place-items-center rounded-full bg-navy-800 text-xs text-white">7</span>Kontakt</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-3">
      <% if (isAgency) { %>
      <div><label class="label" for="lf-agent">Opiekun oferty</label><select id="lf-agent" name="agent" class="select"><% agents.forEach(function(a){ %><option value="<%= a.id %>" <%= String(l.agent && l.agent._id ? l.agent._id : l.agent) === a.id ? 'selected' : '' %>><%= a.name %></option><% }) %></select></div>
      <div><label class="label" for="lf-ref">Nr oferty w biurze</label><input id="lf-ref" name="refNumber" class="input" value="<%= v('refNumber') %>"></div>
      <div><label class="label" for="lf-cphone">Telefon (nadpisuje telefon agenta)</label><input id="lf-cphone" name="contactPhone" class="input" value="<%= v('contactPhone') %>"></div>
      <% } else { %>
      <div><label class="label" for="lf-cname">Imię</label><input id="lf-cname" name="contactName" class="input" value="<%= v('contactName') %>"></div>
      <div><label class="label" for="lf-cphone">Telefon</label><input id="lf-cphone" name="contactPhone" class="input" value="<%= v('contactPhone') %>"></div>
      <div><label class="label" for="lf-cmail">E-mail do powiadomień</label><input id="lf-cmail" name="contactEmail" type="email" class="input" value="<%= v('contactEmail') %>"></div>
      <% } %>
    </div>
  </section>

  <div class="sticky bottom-0 z-20 -mx-4 flex flex-wrap items-center justify-between gap-3 border-t border-line bg-white/95 px-4 py-4 backdrop-blur lg:mx-0 lg:rounded-3xl lg:border" style="padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px))">
    <p class="text-sm text-muted">Publikując, potwierdzasz zgodność z <a href="/regulamin" class="underline" target="_blank">regulaminem</a>.</p>
    <div class="flex gap-2">
      <% if (isNew || l.status === 'draft') { %><button name="saveAs" value="draft" class="btn btn-outline">Zapisz szkic</button><% } %>
      <button name="saveAs" value="publish" class="btn btn-accent"><%- icon('check', 'ico-sm') %><%= isNew ? 'Opublikuj ogłoszenie' : 'Zapisz zmiany' %></button>
    </div>
  </div>
</form>

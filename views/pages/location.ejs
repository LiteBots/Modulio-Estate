<%
  var isV = loc.kind === 'voivodeship';
  var heading = isV ? 'Nieruchomości – ' + loc.full : 'Nieruchomości ' + loc.name;
  var tc = function(k){ return typeCounts[k] || { sprzedaz: 0, wynajem: 0 }; };
%>
<section class="border-b border-line bg-paper">
  <div class="wrap py-8">
    <%- include('../partials/breadcrumbs') %>
    <h1 class="mt-3 font-display text-3xl font-bold sm:text-4xl"><%= heading %></h1>
    <p class="mt-3 max-w-3xl text-[17px] leading-relaxed text-navy-700"><%= intro %></p>
    <div class="mt-6 flex flex-wrap gap-2">
      <a href="/sprzedaz/mieszkania/<%= loc.slug %>" class="btn btn-accent">Mieszkania na sprzedaż</a>
      <a href="/wynajem/mieszkania/<%= loc.slug %>" class="btn btn-outline">Mieszkania na wynajem</a>
      <a href="/sprzedaz/domy/<%= loc.slug %>" class="btn btn-outline">Domy</a>
      <a href="/sprzedaz/dzialki/<%= loc.slug %>" class="btn btn-outline">Działki</a>
    </div>
  </div>
</section>

<section class="wrap grid grid-cols-2 gap-3 py-8 md:grid-cols-4">
  <div class="kpi"><p class="text-sm text-muted">Ogłoszenia</p><p class="kpi-value"><%= fmt.num(total) %></p></div>
  <div class="kpi"><p class="text-sm text-muted">Sprzedaż / wynajem</p><p class="kpi-value"><%= fmt.num(sale) %> / <%= fmt.num(rent) %></p></div>
  <div class="kpi"><p class="text-sm text-muted">Średnia cena m² mieszkań</p><p class="kpi-value"><%= avgM2 ? fmt.num(Math.round(avgM2 / 10) * 10) + ' zł' : '–' %></p></div>
  <div class="kpi"><p class="text-sm text-muted">Średni czynsz najmu</p><p class="kpi-value"><%= avgRent ? fmt.num(Math.round(avgRent / 10) * 10) + ' zł' : '–' %></p></div>
</section>

<section class="wrap pb-12">
  <div class="mb-5 flex items-end justify-between gap-4"><h2 class="h-section">Najnowsze ogłoszenia</h2><a href="/sprzedaz/nieruchomosci/<%= loc.slug %>" class="text-sm font-bold text-ink underline decoration-orange-500 decoration-2 underline-offset-4">Zobacz wszystkie</a></div>
  <% if (newest.length) { %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><% newest.forEach(function(l){ %><%- include('../partials/listing-card', { l: l }) %><% }) %></div>
  <% } else { %>
  <p class="rounded-xl border border-dashed border-line p-8 text-center text-muted">Nie ma jeszcze ogłoszeń w <%= loc.loc %>. <a href="/panel/ogloszenia/nowe" class="font-semibold text-teal-600">Dodaj pierwsze</a>.</p>
  <% } %>
</section>

<% if (adSlots.city_banner) { %><section class="wrap pb-12"><%- include('../partials/ad-slot', { ad: adSlots.city_banner, placement: 'city_banner' }) %></section><% } %>

<section class="border-t border-line bg-paper py-12">
  <div class="wrap grid gap-6 lg:grid-cols-[1.4fr_1fr]">
    <div class="card card-pad min-w-0">
      <h2 class="font-display text-lg font-bold">Średnia cena m² mieszkań – 12 miesięcy</h2>
      <% if (chart) { %><div class="mt-4 overflow-x-auto"><div class="min-w-[480px]"><%- chart %></div></div><p class="mt-2 text-xs text-muted">Ceny ofertowe z ogłoszeń w ModulioEstate.</p>
      <% } else { %><p class="mt-3 text-muted">Wykres pojawi się, gdy w tej lokalizacji będzie więcej ogłoszeń.</p><% } %>
    </div>
    <div class="card card-pad">
      <h2 class="font-display text-lg font-bold">Ogłoszenia według rodzaju</h2>
      <ul class="mt-3 divide-y divide-line text-[15px]">
        <% P.TYPES.forEach(function(t){ var c = tc(t.key); %>
        <li class="flex items-center justify-between gap-3 py-2"><span><%= t.plural %></span><span class="flex gap-3 text-sm"><a href="/sprzedaz/<%= t.slug %>/<%= loc.slug %>" class="text-teal-600 hover:underline">sprzedaż (<%= c.sprzedaz %>)</a><a href="/wynajem/<%= t.slug %>/<%= loc.slug %>" class="text-teal-600 hover:underline">wynajem (<%= c.wynajem %>)</a></span></li>
        <% }) %>
      </ul>
    </div>
  </div>
</section>

<section class="wrap grid gap-8 py-12 text-sm md:grid-cols-3">
  <% if (loc.districts && loc.districts.length) { %>
  <div><h2 class="font-display text-base font-bold">Dzielnice</h2><div class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5"><% loc.districts.forEach(function(d){ %><a href="/sprzedaz/nieruchomosci/<%= loc.slug %>?dzielnica=<%= encodeURIComponent(d) %>" class="text-navy-600 hover:text-orange-600"><%= d %></a><% }) %></div></div>
  <% } %>
  <% if (subCities.length) { %>
  <div class="md:col-span-2"><h2 class="font-display text-base font-bold"><%= isV ? 'Miejscowości' : 'Miasta' %></h2><div class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5"><% subCities.forEach(function(c){ %><a href="/miasto/<%= c.slug %>" class="text-navy-600 hover:text-orange-600 <%= c.major ? 'font-semibold' : '' %>"><%= c.name %></a><% }) %></div></div>
  <% } %>
  <% if (nearby.length) { %>
  <div><h2 class="font-display text-base font-bold">W pobliżu</h2><div class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5"><% nearby.forEach(function(c){ %><a href="/miasto/<%= c.slug %>" class="text-navy-600 hover:text-orange-600"><%= c.name %><% if (c.km && isFinite(c.km)) { %> <span class="text-muted">(<%= c.km %> km)</span><% } %></a><% }) %></div></div>
  <% } %>
  <% if (agencies.length) { %>
  <div><h2 class="font-display text-base font-bold">Biura nieruchomości</h2><ul class="mt-3 grid gap-1.5"><% agencies.forEach(function(a){ %><li><a href="/biuro/<%= a.slug %>" class="text-navy-600 hover:text-orange-600"><%= a.name %></a></li><% }) %></ul></div>
  <% } %>
</section>

<%
  var megaCities = ['trojmiasto','gdansk','gdynia','sopot','slupsk','ustka','bytow','miastko','chojnice','szczecin','koszalin','kolobrzeg','swinoujscie','stargard'];
  var cityLabel = function(s){ return s === 'trojmiasto' ? 'Trójmiasto' : cityName(s); };
%>
<div class="bg-navy-900 text-[13px] text-white/75">
  <div class="wrap flex h-9 items-center justify-between gap-4">
    <p class="flex min-w-0 items-center gap-2 truncate"><%- icon('map-pin', 'ico-sm text-sun-400') %><span class="truncate">Portal nieruchomości województwa <b class="font-semibold text-white">pomorskiego</b> i <b class="font-semibold text-white">zachodniopomorskiego</b></span></p>
    <div class="hidden items-center gap-5 md:flex">
      <a href="/raport-cen" class="hover:text-white">Raport cen</a>
      <a href="/kalkulator-kredytowy" class="hover:text-white">Kalkulator kredytu</a>
      <a href="/poradnik" class="hover:text-white">Poradnik</a>
      <a href="/zostan-partnerem" class="font-semibold text-sun-300 hover:text-sun-200">Zostań partnerem</a>
      <span class="flex items-center gap-3 border-l border-white/15 pl-5">
        <a href="<%= site.socials.facebook %>" target="_blank" rel="noopener" aria-label="Facebook" class="hover:text-white"><%- icon('facebook', 'ico-sm') %></a>
        <a href="<%= site.socials.instagram %>" target="_blank" rel="noopener" aria-label="Instagram" class="hover:text-white"><%- icon('instagram', 'ico-sm') %></a>
        <a href="<%= site.socials.linkedin %>" target="_blank" rel="noopener" aria-label="LinkedIn" class="hover:text-white"><%- icon('linkedin', 'ico-sm') %></a>
        <a href="<%= site.socials.tiktok %>" target="_blank" rel="noopener" aria-label="TikTok" class="hover:text-white"><%- icon('tiktok', 'ico-sm') %></a>
        <a href="<%= site.socials.youtube %>" target="_blank" rel="noopener" aria-label="YouTube" class="hover:text-white"><%- icon('youtube', 'ico-sm') %></a>
      </span>
    </div>
  </div>
</div>

<header class="sticky-top sticky z-50 border-b border-line bg-white/95 backdrop-blur-xl">
  <div class="wrap flex h-[74px] items-center justify-between gap-4">
    <%- include('logo') %>

    <nav class="hidden items-center gap-0.5 text-[15px] font-semibold text-navy-600 xl:flex" aria-label="Główne menu">
      <% [['sprzedaz','Sprzedaż'],['wynajem','Wynajem']].forEach(function(tr){ %>
      <div class="group relative">
        <a href="/<%= tr[0] %>" class="flex items-center gap-1 rounded-full px-3.5 py-2 hover:bg-navy-50 hover:text-navy-900 <%= isActive('/' + tr[0]) ? 'text-navy-900 bg-navy-50' : '' %>"><%= tr[1] %> <%- icon('chevron-down', 'ico-sm opacity-60') %></a>
        <div class="invisible absolute left-0 top-full w-[680px] translate-y-2 pt-3 opacity-0 transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
          <div class="grid grid-cols-[1fr_1.4fr] gap-6 rounded-3xl border border-line bg-white p-6 shadow-lift">
            <div>
              <p class="eyebrow mb-3">Rodzaj</p>
              <ul class="grid gap-1 text-[15px] font-medium">
                <% P.TYPES.forEach(function(t){ %>
                <li><a href="/<%= tr[0] %>/<%= t.slug %>" class="flex items-center gap-2.5 rounded-xl px-2 py-1.5 text-navy-700 hover:bg-paper hover:text-navy-900"><%- icon(t.icon, 'ico-sm text-teal-500') %><%= t.plural %></a></li>
                <% }) %>
              </ul>
            </div>
            <div>
              <p class="eyebrow mb-3">Popularne lokalizacje</p>
              <ul class="grid grid-cols-2 gap-x-4 gap-y-1 text-[15px] font-medium">
                <% megaCities.forEach(function(c){ %>
                <li><a href="/<%= tr[0] %>/nieruchomosci/<%= c %>" class="block rounded-xl px-2 py-1.5 text-navy-700 hover:bg-paper hover:text-navy-900"><%= cityLabel(c) %></a></li>
                <% }) %>
              </ul>
              <div class="mt-4 flex gap-2 border-t border-line pt-4 text-sm">
                <a href="/<%= tr[0] %>/nieruchomosci/pomorskie" class="chip">Całe pomorskie</a>
                <a href="/<%= tr[0] %>/nieruchomosci/zachodniopomorskie" class="chip">Całe zachodniopomorskie</a>
              </div>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
      <a href="/sprzedaz/mieszkania?rynek=pierwotny" class="rounded-full px-3.5 py-2 hover:bg-navy-50 hover:text-navy-900">Rynek pierwotny</a>
      <a href="/miasta" class="rounded-full px-3.5 py-2 hover:bg-navy-50 hover:text-navy-900 <%= isActive('/miasta') || isActive('/miasto') ? 'bg-navy-50 text-navy-900' : '' %>">Miasta</a>
      <a href="/biura" class="rounded-full px-3.5 py-2 hover:bg-navy-50 hover:text-navy-900 <%= isActive('/biura') || isActive('/biuro') ? 'bg-navy-50 text-navy-900' : '' %>">Biura</a>
      <a href="/raport-cen" class="rounded-full px-3.5 py-2 hover:bg-navy-50 hover:text-navy-900 <%= isActive('/raport-cen') ? 'bg-navy-50 text-navy-900' : '' %>">Ceny</a>
    </nav>

    <div class="flex items-center gap-1.5">
      <a href="/panel/ulubione" class="btn-icon relative text-navy-800" aria-label="Ulubione">
        <%- icon('heart', 'ico') %>
        <span data-fav-count class="absolute -right-0.5 -top-0.5 grid h-5 min-w-[20px] place-items-center rounded-full bg-orange-500 px-1 text-[11px] font-bold text-white num" <%= user && user.favorites.length ? '' : 'hidden' %>><%= user ? user.favorites.length : 0 %></span>
      </a>
      <% if (user) { %>
      <details class="relative" data-dropdown>
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full py-1 pl-1 pr-2.5 hover:bg-navy-50 [&::-webkit-details-marker]:hidden">
          <% if (user.avatar) { %><img src="<%= user.avatar %>" alt="" class="h-9 w-9 rounded-full object-cover" referrerpolicy="no-referrer"><% } else { %><span class="grid h-9 w-9 place-items-center rounded-full bg-teal-500 text-sm font-bold text-white"><%= user.initials %></span><% } %>
          <span class="hidden max-w-[120px] truncate text-sm font-semibold sm:block"><%= (user.name || user.email).split(' ')[0] %></span><%- icon('chevron-down', 'ico-sm hidden sm:block') %>
        </summary>
        <div class="absolute right-0 mt-2 w-60 rounded-2xl border border-line bg-white p-2 shadow-lift">
          <a href="/panel" class="side-link"><%- icon('dashboard', 'ico') %>Mój panel</a>
          <a href="/panel/ogloszenia" class="side-link"><%- icon('list', 'ico') %>Moje ogłoszenia</a>
          <a href="/panel/wiadomosci" class="side-link"><%- icon('message', 'ico') %>Wiadomości</a>
          <% if (user.agency) { %><a href="/biuro-panel" class="side-link"><%- icon('briefcase', 'ico') %>Panel biura</a><% } %>
          <% if (user.role === 'admin') { %><a href="/admin" class="side-link"><%- icon('shield', 'ico') %>Administracja</a><% } %>
          <form method="post" action="/wyloguj" class="mt-1 border-t border-line pt-1"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="side-link w-full"><%- icon('logout', 'ico') %>Wyloguj</button></form>
        </div>
      </details>
      <% } else { %>
      <a href="/logowanie" class="btn btn-ghost hidden md:inline-flex"><%- icon('user', 'ico') %>Zaloguj</a>
      <% } %>
      <a href="<%= user && user.agency ? '/biuro-panel/ogloszenia/nowe' : '/panel/ogloszenia/nowe' %>" class="btn btn-accent hidden sm:inline-flex"><%- icon('plus', 'ico-sm') %>Dodaj ogłoszenie</a>
      <button type="button" class="btn-icon xl:hidden" data-toggle="#mobileMenu" aria-label="Menu" aria-expanded="false"><%- icon('menu', 'ico-lg') %></button>
    </div>
  </div>

  <div id="mobileMenu" class="max-h-[calc(100vh-74px)] overflow-y-auto border-t border-line bg-white xl:hidden" hidden>
    <div class="wrap grid gap-1 py-4">
      <a href="/sprzedaz" class="side-link"><%- icon('home', 'ico') %>Sprzedaż</a>
      <a href="/wynajem" class="side-link"><%- icon('key', 'ico') %>Wynajem</a>
      <a href="/sprzedaz/mieszkania?rynek=pierwotny" class="side-link"><%- icon('hammer', 'ico') %>Rynek pierwotny</a>
      <a href="/miasta" class="side-link"><%- icon('map-pin', 'ico') %>Miasta</a>
      <a href="/biura" class="side-link"><%- icon('briefcase', 'ico') %>Biura nieruchomości</a>
      <a href="/raport-cen" class="side-link"><%- icon('chart', 'ico') %>Raport cen</a>
      <a href="/kalkulator-kredytowy" class="side-link"><%- icon('calculator', 'ico') %>Kalkulator kredytu</a>
      <a href="/poradnik" class="side-link"><%- icon('file', 'ico') %>Poradnik</a>
      <a href="/zostan-partnerem" class="side-link"><%- icon('handshake', 'ico') %>Zostań partnerem</a>
      <div class="mt-3 grid grid-cols-2 gap-2 border-t border-line pt-4">
        <% if (!user) { %><a href="/logowanie" class="btn btn-outline">Zaloguj się</a><% } else { %><a href="/panel" class="btn btn-outline">Mój panel</a><% } %>
        <a href="/panel/ogloszenia/nowe" class="btn btn-accent">Dodaj ogłoszenie</a>
      </div>
    </div>
  </div>
</header>

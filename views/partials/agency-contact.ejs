<form method="post" action="/biuro/<%= a.slug %>/kontakt" class="grid gap-3">
  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true">
  <div class="flex gap-2 text-sm">
    <label class="flex-1 cursor-pointer"><input type="radio" name="topic" value="kontakt" class="peer sr-only" checked><span class="block rounded-xl border border-line bg-white py-2 text-center font-semibold peer-checked:border-navy-800 peer-checked:bg-navy-800 peer-checked:text-white">Pytanie</span></label>
    <label class="flex-1 cursor-pointer"><input type="radio" name="topic" value="wycena" class="peer sr-only"><span class="block rounded-xl border border-line bg-white py-2 text-center font-semibold peer-checked:border-navy-800 peer-checked:bg-navy-800 peer-checked:text-white">Chcę sprzedać / wycenić</span></label>
  </div>
  <div class="grid gap-3 sm:grid-cols-2">
    <input name="name" required class="input" placeholder="Imię i nazwisko" aria-label="Imię i nazwisko" value="<%= user ? user.name : '' %>">
    <input name="email" type="email" required class="input" placeholder="E-mail" aria-label="E-mail" value="<%= user ? user.email : '' %>">
  </div>
  <input name="phone" class="input" placeholder="Telefon" aria-label="Telefon">
  <textarea name="message" required class="textarea" placeholder="Wiadomość" aria-label="Wiadomość"></textarea>
  <label class="flex items-start gap-2 text-xs text-muted"><input type="checkbox" name="consent" value="1" required class="check mt-0.5">Zgadzam się na przekazanie danych biuru <%= a.name %> w celu odpowiedzi. <a href="/polityka-prywatnosci" class="underline">Polityka prywatności</a></label>
  <button class="btn btn-accent w-full sm:w-fit"><%- icon('send', 'ico-sm') %>Wyślij wiadomość</button>
</form>

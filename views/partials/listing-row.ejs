<%
  var img = l.images && l.images[0] ? l.images[0].url : null;
  var fav = favIds.has(String(l._id));
  var t = P.TYPE_BY_KEY[l.type] || {};
%>
<article class="group relative grid overflow-hidden rounded-[22px] border bg-white p-2 transition duration-300 hover:shadow-lift sm:grid-cols-[290px_1fr] <%= l.isFeatured ? 'border-orange-300' : 'border-line' %>">
  <div class="scene relative aspect-[4/3] overflow-hidden rounded-[16px] sm:aspect-auto sm:h-full sm:min-h-[200px]">
    <% if (img) { %><img src="<%= img %>" alt="<%= l.title %>" loading="lazy"><% } else { %><%- art.sceneFor(l) %><% } %>
    <% if (l.isFeatured) { %><span class="absolute left-3 top-3 rounded-full bg-orange-500 px-2.5 py-1 text-[11px] font-bold text-ink">Wyróżnione</span><% } %>
    <% if (l.images && l.images.length > 1) { %><span class="absolute bottom-3 left-3 flex items-center gap-1 rounded-md bg-navy-950/70 px-2 py-1 text-xs text-white"><%- icon('camera', 'ico-sm') %><%= l.images.length %></span><% } %>
  </div>
  <div class="flex min-w-0 flex-col p-4 sm:p-5">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <h3 class="line-clamp-2 text-base font-semibold leading-snug text-navy-900"><a href="<%= l.url %>" class="after:absolute after:inset-0 after:content-[''] group-hover:text-orange-600"><%= l.title %></a></h3>
        <p class="mt-1 flex items-center gap-1 truncate text-sm text-muted"><%- icon('map-pin', 'ico-sm shrink-0') %><%= l.cityName %><%= l.district ? ', ' + l.district : '' %></p>
      </div>
      <button type="button" data-fav="<%= l._id %>" aria-pressed="<%= fav %>" aria-label="<%= fav ? 'Usuń z obserwowanych' : 'Obserwuj' %>" class="relative z-10 grid h-9 w-9 shrink-0 place-items-center rounded-full border border-line transition hover:text-orange-500 <%= fav ? 'text-orange-500' : 'text-navy-800' %>"><%- icon('heart', 'ico-sm', fav ? 'fill="currentColor"' : '') %></button>
    </div>
    <div class="mt-3 flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <p class="font-display text-2xl font-bold num" style="letter-spacing:-0.04em"><%= fmt.price(l.price, l.transaction) %></p>
      <% if (l.pricePerM2 && l.transaction === 'sprzedaz') { %><p class="text-sm text-muted num"><%= fmt.num(l.pricePerM2) %> zł/m²</p><% } %>
      <% if (l.rentExtra) { %><p class="text-sm text-muted num">+ czynsz <%= fmt.num(l.rentExtra) %> zł</p><% } %>
      <% if (l.priceDrop) { %><span class="rounded-full bg-teal-100 px-2 py-0.5 text-[11px] font-bold text-teal-700">−<%= l.priceDrop %>%</span><% } %>
    </div>
    <p class="mt-2 text-[15px] text-navy-700 num"><%- include('listing-params', { l: l }) %></p>
    <% var tags = [l.market === 'pierwotny' ? 'Rynek pierwotny' : null, l.condition, l.buildingType, l.noCommission ? 'Bez prowizji' : null].filter(Boolean).slice(0, 4); if (tags.length) { %><div class="mt-2 flex flex-wrap gap-1.5"><% tags.forEach(function(t){ %><span class="rounded-full bg-paper px-2.5 py-0.5 text-xs text-navy-600"><%= t %></span><% }) %></div><% } %>
    <div class="mt-auto flex items-center justify-between gap-3 pt-4 text-sm text-muted">
      <span class="flex min-w-0 items-center gap-2"><span class="truncate"><%= l.agency && l.agency.name ? l.agency.name : (P.ADVERTISER[l.advertiserType] || 'Oferta prywatna') %></span><span class="hidden shrink-0 sm:inline">· <%= fmt.timeAgo(l.bumpedAt || l.publishedAt || l.createdAt) %></span></span>
      <button type="button" data-compare="<%= l.num %>" class="relative z-10 flex shrink-0 items-center gap-1 rounded-[10px] border border-line px-2.5 py-1 text-xs font-semibold text-ink hover:border-navy-300"><%- icon('layers', 'ico-sm') %><span data-compare-label>Porównaj</span></button>
    </div>
  </div>
</article>

<%
  var isV = loc.kind === 'voivodeship';
  var heroScene = loc.coastal || loc.slug === 'trojmiasto' ? 'sea' : loc.slug === 'szczecin' ? 'office' : isV ? 'house' : 'block';
  var heading = isV ? 'Nieruchomości – ' + loc.full : 'Nieruchomości ' + loc.name;
  var tc = function(k){ return typeCounts[k] || { sprzedaz: 0, wynajem: 0, all: 0 }; };
%>
<section class="wrap pt-6">
  <%- include('../partials/breadcrumbs') %>
  <div class="relative mt-4 overflow-hidden rounded-[2rem] bg-navy-900 text-white">
    <div class="scene absolute inset-0 opacity-80"><%- art.scene(heroScene, isV ? 'teal' : 'dusk', loc.slug.length * 31) %></div>
    <div class="absolute inset-0 bg-gradient-to-r from-navy-950/90 via-navy-950/60 to-navy-950/10"></div>
    <div class="mosaic-band absolute -bottom-6 right-8 hidden h-28 w-44 overflow-hidden rounded-2xl opacity-90 md:block"><%- art.mosaic(5, 3, loc.slug.length) %></div>
    <div class="relative max-w-3xl p-6 sm:p-10 lg:p-12">
      <p class="text-xs font-bold uppercase tracking-[.16em] text-sun-300"><%= isV ? 'Województwo' : (loc.voivodeship === 'pomorskie' ? 'Pomorskie' : 'Zachodniopomorskie') %><%= loc.coastal ? ' · nad morzem' : '' %></p>
      <h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight text-white sm:text-5xl"><%= heading %></h1>
      <p class="mt-4 text-lg text-white/80"><%= intro %></p>
      <div class="mt-7 flex flex-wrap gap-2">
        <a href="/sprzedaz/mieszkania/<%= loc.slug %>" class="btn btn-accent">Mieszkania na sprzedaż</a>
        <a href="/sprzedaz/domy/<%= loc.slug %>" class="btn btn-white">Domy</a>
        <a href="/sprzedaz/dzialki/<%= loc.slug %>" class="btn btn-white">Działki</a>
        <a href="/wynajem/mieszkania/<%= loc.slug %>" class="btn border border-white/30 text-white hover:bg-white/10">Wynajem</a>
      </div>
    </div>
  </div>
</section>

<section class="wrap mt-6 grid grid-cols-2 gap-3 md:grid-cols-4">
  <div class="kpi"><p class="text-sm text-muted">Aktywne ogłoszenia</p><p class="kpi-value"><%= fmt.num(total) %></p></div>
  <div class="kpi"><p class="text-sm text-muted">Na sprzedaż / wynajem</p><p class="kpi-value"><%= fmt.num(sale) %> <span class="text-lg text-muted">/ <%= fmt.num(rent) %></span></p></div>
  <div class="kpi"><p class="text-sm text-muted">Śr. cena m² mieszkań</p><p class="kpi-value"><%= avgM2 ? fmt.num(Math.round(avgM2 / 10) * 10) + ' zł' : '–' %></p></div>
  <div class="kpi"><p class="text-sm text-muted">Śr. czynsz najmu mieszkania</p><p class="kpi-value"><%= avgRent ? fmt.num(Math.round(avgRent / 10) * 10) + ' zł' : '–' %></p></div>
</section>

<section class="wrap py-12">
  <h2 class="h-section">Kategorie w <%= loc.loc %></h2>
  <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <% P.TYPES.forEach(function(t){ var c = tc(t.key); %>
    <div class="card p-4">
      <div class="flex items-center gap-3"><span class="grid h-10 w-10 place-items-center rounded-xl bg-teal-50 text-teal-600"><%- icon(t.icon, 'ico') %></span><p class="font-display font-bold"><%= t.plural %></p></div>
      <div class="mt-3 flex gap-2 text-sm">
        <a href="/sprzedaz/<%= t.slug %>/<%= loc.slug %>" class="flex-1 rounded-xl bg-paper px-3 py-2 font-semibold hover:bg-navy-50">Sprzedaż <span class="text-muted num"><%= c.sprzedaz %></span></a>
        <a href="/wynajem/<%= t.slug %>/<%= loc.slug %>" class="flex-1 rounded-xl bg-paper px-3 py-2 font-semibold hover:bg-navy-50">Wynajem <span class="text-muted num"><%= c.wynajem %></span></a>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<section class="border-y border-line bg-white py-14">
  <div class="wrap">
    <div class="mb-6 flex items-end justify-between gap-4"><h2 class="h-section">Najnowsze oferty</h2><a href="/sprzedaz/nieruchomosci/<%= loc.slug %>" class="flex items-center gap-2 font-semibold hover:gap-3">Wszystkie <%- icon('arrow-right', 'ico-sm') %></a></div>
    <% if (newest.length) { %>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4"><% newest.forEach(function(l){ %><%- include('../partials/listing-card', { l: l }) %><% }) %></div>
    <% } else { %>
    <div class="rounded-3xl border-2 border-dashed border-line p-10 text-center text-muted">Nie ma jeszcze ofert w <%= loc.loc %>. <a href="/panel/ogloszenia/nowe" class="font-semibold text-teal-600">Dodaj pierwsze ogłoszenie</a> albo <a href="/panel/wyszukiwania" class="font-semibold text-teal-600">ustaw powiadomienie</a>.</div>
    <% } %>
  </div>
</section>

<section class="wrap py-12"><%- include('../partials/ad-slot', { ad: adSlots.city_banner, placement: 'city_banner', shape: 'banner' }) %></section>

<section class="wrap grid gap-6 pb-14 lg:grid-cols-[1.4fr_1fr]">
  <div class="card card-pad min-w-0">
    <h2 class="font-display text-xl font-bold">Średnia cena ofertowa m² mieszkań – ostatnie 12 miesięcy</h2>
    <% if (chart) { %><div class="mt-4 overflow-x-auto"><div class="min-w-[480px]"><%- chart %></div></div><p class="mt-2 text-xs text-muted">Na podstawie ogłoszeń mieszkań na sprzedaż w ModulioEstate.</p>
    <% } else { %><p class="mt-4 text-muted">Za mało danych, by pokazać trend. Wykres pojawi się, gdy w serwisie będzie więcej ofert z tej lokalizacji.</p><% } %>
    <% if (coastalNote) { %><p class="mt-5 flex gap-2 rounded-2xl bg-teal-50 p-3 text-sm text-teal-800"><%- icon('info', 'ico-sm mt-0.5') %><%= coastalNote %></p><% } %>
  </div>
  <div class="card card-pad">
    <% if (loc.districts && loc.districts.length) { %>
      <h2 class="font-display text-xl font-bold">Dzielnice i osiedla</h2>
      <div class="mt-4 flex flex-wrap gap-2"><% loc.districts.forEach(function(d){ %><a href="/sprzedaz/nieruchomosci/<%= loc.slug %>?dzielnica=<%= encodeURIComponent(d) %>" class="chip"><%= d %></a><% }) %></div>
    <% } %>
    <% if (subCities.length) { %>
      <h2 class="font-display text-xl font-bold <%= loc.districts && loc.districts.length ? 'mt-8' : '' %>"><%= isV ? 'Miejscowości' : 'Miasta' %></h2>
      <div class="mt-4 flex flex-wrap gap-2"><% subCities.forEach(function(c){ %><a href="/miasto/<%= c.slug %>" class="chip <%= c.major ? 'font-semibold' : '' %>"><%= c.name %><% var n = (byCity[c.slug]||{}).count; if (n) { %><span class="text-xs text-muted num"><%= n %></span><% } %></a><% }) %></div>
    <% } %>
    <% if (nearby.length) { %>
      <h2 class="mt-8 font-display text-xl font-bold">W pobliżu</h2>
      <div class="mt-4 flex flex-wrap gap-2"><% nearby.forEach(function(c){ %><a href="/miasto/<%= c.slug %>" class="chip"><%= c.name %><% if (c.km && isFinite(c.km)) { %><span class="text-xs text-muted"><%= c.km %> km</span><% } %></a><% }) %></div>
    <% } %>
  </div>
</section>

<% if (primary.length) { %>
<section class="wrap pb-14">
  <h2 class="h-section">Rynek pierwotny</h2>
  <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4"><% primary.forEach(function(l){ %><%- include('../partials/listing-card', { l: l }) %><% }) %></div>
</section>
<% } %>

<% if (agencies.length) { %>
<section class="border-t border-line bg-white py-14">
  <div class="wrap">
    <h2 class="h-section">Biura nieruchomości – <%= isV ? loc.name : loc.name %></h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% agencies.forEach(function(a){ %>
      <a href="/biuro/<%= a.slug %>" class="flex items-center gap-4 rounded-3xl border border-line p-4 hover:shadow-soft">
        <span class="grid h-14 w-14 shrink-0 place-items-center overflow-hidden rounded-2xl bg-paper font-display font-bold"><% if (a.logo) { %><img src="<%= a.logo %>" alt="" class="h-full w-full object-contain p-1"><% } else { %><%= a.name.slice(0,2).toUpperCase() %><% } %></span>
        <span class="min-w-0"><span class="block truncate font-semibold"><%= a.name %></span><span class="line-clamp-2 text-sm text-muted"><%= a.shortDescription || cityName(a.city) %></span></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="wrap py-14">
  <div class="relative overflow-hidden rounded-[2rem] bg-orange-500 p-7 text-white sm:p-10">
    <div class="mosaic-band absolute inset-y-0 right-0 hidden w-1/3 overflow-hidden opacity-30 md:block"><%- art.mosaic(4, 6, 12) %></div>
    <div class="relative max-w-2xl">
      <h2 class="font-display text-3xl font-extrabold text-white">Masz nieruchomość w <%= loc.loc %>?</h2>
      <p class="mt-3 text-white/90">Dodaj ogłoszenie prywatne albo – jeśli prowadzisz biuro nieruchomości – dołącz do partnerów ModulioEstate.</p>
      <div class="mt-6 flex flex-wrap gap-3"><a href="/panel/ogloszenia/nowe" class="btn btn-white">Dodaj ogłoszenie</a><a href="/zostan-partnerem" class="btn border border-white/40 text-white hover:bg-white/10">Zostań partnerem</a></div>
    </div>
  </div>
</section>

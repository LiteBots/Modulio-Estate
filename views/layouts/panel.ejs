<!doctype html>
<html lang="pl">
<head><%- include('../partials/head') %></head>
<body class="flex min-h-screen flex-col">
<%- include('../partials/header') %>
<%
  var tabs = [
    ['/panel/ogloszenia', 'Moje ogłoszenia', 'list', 0],
    ['/panel/obserwowane', 'Obserwowane', 'heart', 0],
    ['/panel/wiadomosci', 'Wiadomości', 'message', unread],
    ['/panel/ustawienia', 'Ustawienia konta', 'settings', 0]
  ];
%>
<div class="border-b border-line bg-paper">
  <div class="wrap pt-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h1 class="font-display text-2xl font-bold">Moje konto</h1>
      <a href="/panel/ogloszenia/nowe" class="btn btn-accent btn-sm"><%- icon('plus', 'ico-sm') %>Dodaj ogłoszenie</a>
    </div>
    <nav class="mt-4 flex gap-1 overflow-x-auto hide-scrollbar" aria-label="Moje konto">
      <% tabs.forEach(function(t){ var on = path === t[0] || path.indexOf(t[0] + '/') === 0; %>
      <a href="<%= t[0] %>" class="-mb-px flex shrink-0 items-center gap-2 border-b-2 px-3 pb-3 text-[15px] font-semibold <%= on ? 'border-navy-800 text-navy-900' : 'border-transparent text-muted hover:text-navy-900' %>"><%- icon(t[2], 'ico-sm') %><%= t[1] %><% if (t[3]) { %><span class="grid h-5 min-w-[20px] place-items-center rounded-full bg-orange-500 px-1.5 text-[11px] font-bold text-white num"><%= t[3] %></span><% } %></a>
      <% }) %>
    </nav>
  </div>
</div>
<%- include('../partials/flash') %>
<main id="tresc" class="wrap flex-1 py-8"><%- body %></main>
<%- include('../partials/footer') %>
<div id="toast" class="fixed left-1/2 z-[70] flex -translate-x-1/2 items-center gap-2 rounded-lg bg-navy-900 px-5 py-3 text-sm font-medium text-white shadow-lift" style="bottom: calc(24px + env(safe-area-inset-bottom, 0px))" hidden></div>
<script src="/js/app.js?v=2" defer></script>
</body>
</html>

<h1 class="font-display text-3xl font-extrabold">Administracja platformy</h1>
<div class="mt-6 grid grid-cols-2 gap-3 xl:grid-cols-4">
  <div class="kpi"><p class="text-sm text-muted">Aktywne ogłoszenia</p><p class="kpi-value"><%= fmt.num(k.listings) %></p><p class="text-xs text-muted">+<%= k.listingsNew %> w 30 dni</p></div>
  <div class="kpi"><p class="text-sm text-muted">Użytkownicy</p><p class="kpi-value"><%= fmt.num(k.users) %></p><p class="text-xs text-muted">+<%= k.usersNew %> w 30 dni</p></div>
  <div class="kpi"><p class="text-sm text-muted">Biura partnerskie</p><p class="kpi-value"><%= fmt.num(k.agencies) %></p></div>
  <div class="kpi"><p class="text-sm text-muted">Zapytania (30 dni)</p><p class="kpi-value"><%= fmt.num(k.inquiries) %></p></div>
</div>
<div class="mt-6 grid gap-6 xl:grid-cols-[1.5fr_1fr]">
  <div class="card card-pad min-w-0"><h2 class="font-display text-lg font-bold">Nowe ogłoszenia dziennie</h2><div class="mt-4 overflow-x-auto"><div class="min-w-[520px]"><%- chart %></div></div></div>
  <div class="card card-pad">
    <h2 class="font-display text-lg font-bold">Reklamy (aktywne)</h2>
    <div class="mt-4 grid grid-cols-2 gap-3"><div class="rounded-2xl bg-paper p-4"><p class="text-xs text-muted">Wyświetlenia</p><p class="font-display text-2xl font-bold num"><%= fmt.num(k.adImpr) %></p></div><div class="rounded-2xl bg-paper p-4"><p class="text-xs text-muted">Kliknięcia</p><p class="font-display text-2xl font-bold num"><%= fmt.num(k.adClicks) %></p></div></div>
    <p class="mt-3 text-sm text-muted">CTR: <b class="num"><%= k.adImpr ? (k.adClicks / k.adImpr * 100).toFixed(2).replace('.', ',') : '0' %>%</b></p>
    <a href="/admin/reklamy" class="btn btn-outline btn-sm mt-4">Zarządzaj reklamami</a>
  </div>
</div>
<div class="card card-pad mt-6">
  <div class="flex items-center justify-between"><h2 class="font-display text-lg font-bold">Ostatnie zgłoszenia z formularzy</h2><a href="/admin/zgloszenia" class="text-sm font-semibold text-teal-600">Wszystkie</a></div>
  <div class="table-wrap mt-3"><table class="table"><thead><tr><th>Typ</th><th>Firma / osoba</th><th>Kontakt</th><th>Status</th><th>Data</th></tr></thead><tbody>
    <% partners.forEach(function(p){ %><tr><td><span class="badge tone-info"><%= p.kind %></span></td><td class="font-semibold"><%= p.company || p.name %></td><td class="text-sm"><%= p.email %></td><td><span class="badge <%= p.status === 'nowe' ? 'tone-orange' : 'tone-muted' %>"><%= p.status %></span></td><td class="text-sm text-muted"><%= fmt.dateShort(p.createdAt) %></td></tr><% }) %>
    <% if (!partners.length) { %><tr><td colspan="5" class="py-6 text-center text-muted">Brak zgłoszeń.</td></tr><% } %>
  </tbody></table></div>
</div>

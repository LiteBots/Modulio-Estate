<h1 class="font-display text-3xl font-extrabold">Zgłoszenia naruszeń</h1>
<p class="mt-1 text-muted">Mechanizm zgłaszania i usuwania treści (DSA). Rozpatrz zgłoszenie i – jeśli trzeba – zablokuj ogłoszenie z uzasadnieniem.</p>
<div class="mt-6 grid gap-3">
  <% reports.forEach(function(r){ %>
  <form method="post" action="/admin/naruszenia/<%= r._id %>" class="card p-5">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div><div class="flex items-center gap-2"><span class="badge tone-orange"><%= r.reason %></span><span class="text-xs text-muted"><%= fmt.dateTime(r.createdAt) %> · <%= r.email || 'anonimowo' %></span></div>
        <% if (r.listing) { %><a href="/oferta/<%= r.listing.slug %>-<%= r.listing.num %>" target="_blank" class="mt-2 block font-semibold hover:text-teal-600"><%= r.listing.title %></a><p class="text-xs text-muted">status oferty: <%= r.listing.status %></p><% } %></div>
      <select name="status" class="select !w-auto text-sm"><% ['nowe','rozpatrzone','odrzucone'].forEach(function(s){ %><option <%= r.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select>
    </div>
    <% if (r.details) { %><p class="mt-3 rounded-2xl bg-paper p-3 text-sm"><%= r.details %></p><% } %>
    <input name="decision" class="input mt-3 text-sm" placeholder="Decyzja i uzasadnienie" value="<%= r.decision || '' %>">
    <div class="mt-3 flex flex-wrap items-center gap-4"><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="block" class="check">Zablokuj ogłoszenie</label><button class="btn btn-primary btn-sm">Zapisz</button></div>
  </form>
  <% }) %>
  <% if (!reports.length) { %><div class="card p-10 text-center text-muted">Brak zgłoszeń.</div><% } %>
</div>

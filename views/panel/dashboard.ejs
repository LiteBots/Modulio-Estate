<div class="flex flex-wrap items-end justify-between gap-4">
  <div><p class="text-sm text-muted">Dzień dobry,</p><h1 class="font-display text-3xl font-extrabold"><%= (user.name || user.email).split(' ')[0] %></h1></div>
  <div class="flex gap-2"><a href="/sprzedaz" class="btn btn-outline"><%- icon('search', 'ico-sm') %>Szukaj</a><a href="/panel/ogloszenia/nowe" class="btn btn-accent"><%- icon('plus', 'ico-sm') %>Dodaj ogłoszenie</a></div>
</div>

<div class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <a href="/panel/ulubione" class="kpi hover:shadow-soft"><p class="flex items-center gap-2 text-sm text-muted"><%- icon('heart', 'ico-sm text-orange-500') %>Ulubione</p><p class="kpi-value"><%= user.favorites.length %></p></a>
  <a href="/panel/wyszukiwania" class="kpi hover:shadow-soft"><p class="flex items-center gap-2 text-sm text-muted"><%- icon('bell', 'ico-sm text-teal-500') %>Zapisane wyszukiwania</p><p class="kpi-value"><%= searches.length %></p></a>
  <a href="/panel/wiadomosci" class="kpi hover:shadow-soft"><p class="flex items-center gap-2 text-sm text-muted"><%- icon('message', 'ico-sm text-navy-500') %>Nieprzeczytane</p><p class="kpi-value"><%= unread %></p></a>
  <a href="/panel/ogloszenia" class="kpi hover:shadow-soft"><p class="flex items-center gap-2 text-sm text-muted"><%- icon('list', 'ico-sm text-sun-500') %>Moje ogłoszenia</p><p class="kpi-value"><%= myListings.length %></p></a>
</div>

<% if (chart) { %>
<div class="card card-pad mt-6">
  <div class="flex flex-wrap items-center justify-between gap-3"><h2 class="font-display text-lg font-bold">Wyświetlenia Twoich ogłoszeń – 30 dni</h2>
    <p class="text-sm text-muted num"><%= fmt.num(totals.views) %> wyświetleń · <%= totals.phone %> telefonów · <%= totals.inquiries %> zapytań</p></div>
  <div class="mt-4 overflow-x-auto"><div class="min-w-[480px]"><%- chart %></div></div>
</div>
<% } %>

<div class="mt-6 grid gap-6 xl:grid-cols-2">
  <div class="card card-pad">
    <div class="flex items-center justify-between"><h2 class="font-display text-lg font-bold">Ulubione</h2><a href="/panel/ulubione" class="text-sm font-semibold text-teal-600">Wszystkie</a></div>
    <% if (favs.length) { %>
    <div class="mt-4 grid gap-3"><% favs.forEach(function(l){ %>
      <a href="<%= l.url %>" class="flex items-center gap-3 rounded-2xl p-2 hover:bg-paper">
        <span class="scene h-14 w-20 shrink-0 overflow-hidden rounded-xl"><% if (l.images && l.images[0]) { %><img src="<%= l.images[0].url %>" alt=""><% } else { %><%- art.sceneFor(l) %><% } %></span>
        <span class="min-w-0 flex-1"><span class="block truncate font-semibold"><%= l.title %></span><span class="text-sm text-muted"><%= l.cityName %> · <span class="num"><%= fmt.price(l.price, l.transaction) %></span></span></span>
      </a><% }) %></div>
    <% } else { %><p class="mt-4 text-sm text-muted">Kliknij serduszko przy ofercie, aby ją zapisać.</p><% } %>
  </div>
  <div class="card card-pad">
    <div class="flex items-center justify-between"><h2 class="font-display text-lg font-bold">Ostatnie wiadomości</h2><a href="/panel/wiadomosci" class="text-sm font-semibold text-teal-600">Wszystkie</a></div>
    <% var msgs = received.concat(sent).sort(function(a,b){ return new Date(b.updatedAt) - new Date(a.updatedAt); }).slice(0, 5); %>
    <% if (msgs.length) { %>
    <ul class="mt-4 divide-y divide-line"><% msgs.forEach(function(m){ %>
      <li><a href="/panel/wiadomosci/<%= m._id %>" class="flex items-center justify-between gap-3 py-3 hover:text-teal-600"><span class="min-w-0"><span class="block truncate font-semibold"><%= m.listing ? m.listing.title : 'Wiadomość do biura' %></span><span class="block truncate text-sm text-muted"><%= m.message %></span></span><span class="shrink-0 text-xs text-muted"><%= fmt.timeAgo(m.updatedAt) %></span></a></li>
    <% }) %></ul>
    <% } else { %><p class="mt-4 text-sm text-muted">Brak wiadomości. Zapytania wysłane z ogłoszeń pojawią się tutaj.</p><% } %>
  </div>
  <div class="card card-pad">
    <div class="flex items-center justify-between"><h2 class="font-display text-lg font-bold">Zapisane wyszukiwania</h2><a href="/panel/wyszukiwania" class="text-sm font-semibold text-teal-600">Zarządzaj</a></div>
    <% if (searches.length) { %><ul class="mt-4 grid gap-2"><% searches.forEach(function(s){ %><li><a href="<%= s.url %>" class="flex items-center gap-2 rounded-xl bg-paper px-3 py-2.5 text-sm font-semibold hover:bg-navy-50"><%- icon('search', 'ico-sm text-teal-500') %><span class="truncate"><%= s.name %></span></a></li><% }) %></ul>
    <% } else { %><p class="mt-4 text-sm text-muted">W wynikach wyszukiwania kliknij „Zapisz i powiadamiaj”.</p><% } %>
  </div>
  <div class="card card-pad">
    <div class="flex items-center justify-between"><h2 class="font-display text-lg font-bold">Moje ogłoszenia</h2><a href="/panel/ogloszenia" class="text-sm font-semibold text-teal-600">Wszystkie</a></div>
    <% if (myListings.length) { %><ul class="mt-4 divide-y divide-line"><% myListings.forEach(function(l){ %><li class="flex items-center justify-between gap-3 py-3"><a href="/panel/ogloszenia/<%= l._id %>/edytuj" class="min-w-0 truncate font-semibold hover:text-teal-600"><%= l.title %></a><span class="flex shrink-0 items-center gap-2 text-sm text-muted"><span class="num"><%= l.views %></span><%- icon('eye', 'ico-sm') %><%- include('../partials/status-badge', { s: l.status }) %></span></li><% }) %></ul>
    <% } else { %><p class="mt-4 text-sm text-muted">Sprzedajesz lub wynajmujesz? <a href="/panel/ogloszenia/nowe" class="font-semibold text-teal-600">Dodaj pierwsze ogłoszenie</a>.</p><% } %>
  </div>
</div>

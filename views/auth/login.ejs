<%- include('../partials/auth-shell-start') %>
  <div class="mb-8 grid grid-cols-2 rounded-[14px] bg-white p-1 ring-1 ring-line"><span class="rounded-[11px] bg-paper py-2 text-center text-sm font-bold shadow-soft">Logowanie</span><a href="/rejestracja" class="py-2 text-center text-sm font-bold text-muted hover:text-ink">Załóż konto</a></div>
  <h1 class="font-display text-3xl font-bold" style="letter-spacing:-0.05em">Witaj ponownie</h1>
  <p class="mt-2 text-muted">Zaloguj się, aby zobaczyć obserwowane oferty, wiadomości i swoje ogłoszenia.</p>
  <div class="mt-8"><%- include('../partials/google-btn') %></div>
  <form method="post" action="/logowanie" class="grid gap-4 <%= googleEnabled ? '' : 'mt-8' %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div><label class="label" for="email">E-mail</label><input id="email" name="email" type="email" autocomplete="email" required class="input" value="<%= email %>"></div>
    <div><div class="flex items-center justify-between"><label class="label" for="password">Hasło</label><a href="/zapomnialem-hasla" class="mb-1.5 text-xs font-semibold text-muted hover:text-ink">Nie pamiętasz hasła?</a></div>
      <div class="relative"><input id="password" name="password" type="password" autocomplete="current-password" required class="input pr-12"><button type="button" data-reveal="#password" class="absolute right-2 top-1/2 grid h-9 w-9 -translate-y-1/2 place-items-center rounded-full text-muted hover:bg-paper" aria-label="Pokaż hasło"><%- icon('eye', 'ico-sm') %></button></div></div>
    <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="remember" value="1" class="check">Zapamiętaj mnie na 30 dni</label>
    <button class="btn btn-primary btn-lg w-full"><%- icon('login', 'ico-sm') %>Zaloguj się</button>
  </form>
  <p class="mt-6 text-center text-sm text-muted">Nie masz konta? <a href="/rejestracja" class="link">Załóż konto</a></p>
  <p class="mt-6 rounded-[16px] border border-dashed border-orange-300 bg-orange-50/50 p-4 text-sm text-muted">Prowadzisz biuro nieruchomości? Konta biur aktywujemy po kontakcie – <a href="/zostan-partnerem" class="link">zostań partnerem</a>.</p>
<%- include('../partials/auth-shell-end') %>

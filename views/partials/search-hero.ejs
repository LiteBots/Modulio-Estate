<form action="/szukaj" method="get" class="w-full rounded-[18px] bg-white p-2.5 text-ink shadow-lift sm:p-3" data-hero-search>
  <input type="hidden" name="transakcja" value="sprzedaz" data-hs-tr>
  <input type="hidden" name="rynek" value="" data-hs-market disabled>
  <div class="mb-2 grid grid-cols-2 rounded-[12px] bg-paper p-1 sm:mb-3 sm:inline-grid" role="tablist">
    <button type="button" class="rounded-[9px] bg-navy-800 px-6 py-2 text-[14px] font-bold text-white" data-hs-tab="sprzedaz" aria-selected="true">Kupno</button>
    <button type="button" class="rounded-[9px] px-6 py-2 text-[14px] font-bold text-muted" data-hs-tab="wynajem" aria-selected="false">Wynajem</button>
  </div>
  <div class="grid grid-cols-2 gap-2 md:grid-cols-[1.6fr_1fr_0.8fr_0.9fr_0.9fr_auto]">
    <label class="col-span-2 block rounded-[12px] border-[1.5px] border-line px-3.5 py-2 md:col-span-1"><span class="block text-[12px] font-medium text-muted">Gdzie szukasz?</span>
      <span class="flex items-center gap-2"><input name="q" list="cityList" autocomplete="off" placeholder="np. Kołobrzeg, Gdynia Orłowo" class="min-w-0 flex-1 bg-transparent text-[16px] font-bold outline-none placeholder:font-normal placeholder:text-navy-300"><button type="button" data-open-map-picker class="flex shrink-0 items-center gap-1 text-[13px] font-bold text-teal-500 hover:text-teal-700" title="Wybierz miasto na mapie"><%- icon('map', 'ico-sm') %>Mapa</button></span></label>
    <label class="block rounded-[12px] border-[1.5px] border-line px-3.5 py-2"><span class="block text-[12px] font-medium text-muted">Rodzaj</span>
      <select name="typ" class="w-full cursor-pointer bg-transparent text-[16px] font-bold outline-none" data-hs-type>
        <% P.TYPES.forEach(function(t){ %><option value="<%= t.key %>" <%= t.key === 'mieszkanie' ? 'selected' : '' %>><%= t.plural %></option><% }) %>
        <option value="">Wszystkie</option>
      </select></label>
    <label class="block rounded-[12px] border-[1.5px] border-line px-3.5 py-2"><span class="block text-[12px] font-medium text-muted">Do plaży</span>
      <select name="do_plazy" class="w-full cursor-pointer bg-transparent text-[16px] font-bold outline-none"><option value="">Dowolnie</option><% [[300,'do 300 m'],[500,'do 500 m'],[1000,'do 1 km'],[2000,'do 2 km'],[5000,'do 5 km']].forEach(function(o){ %><option value="<%= o[0] %>"><%= o[1] %></option><% }) %></select></label>
    <label class="hidden rounded-[12px] border-[1.5px] border-line px-3.5 py-2 md:block"><span class="block text-[12px] font-medium text-muted">Promień</span>
      <select name="promien" class="w-full cursor-pointer bg-transparent text-[16px] font-bold outline-none"><% P.RADIUS.forEach(function(r){ %><option value="<%= r || '' %>"><%= r ? '+ ' + r + ' km' : '+ 0 km' %></option><% }) %></select></label>
    <label class="hidden rounded-[12px] border-[1.5px] border-line px-3.5 py-2 md:block"><span class="block text-[12px] font-medium text-muted" data-hs-price-label>Cena do</span>
      <select name="cena_do" class="w-full cursor-pointer bg-transparent text-[16px] font-bold outline-none num" data-hs-price data-sale="300000,400000,500000,700000,900000,1200000,1500000,2000000" data-rent="1500,2000,2500,3000,4000,5000,7000">
        <option value="">Dowolna</option><% [300000,400000,500000,700000,900000,1200000,1500000,2000000].forEach(function(v){ %><option value="<%= v %>"><%= fmt.shortPrice(v) %> zł</option><% }) %>
      </select></label>
    <button class="btn btn-accent btn-lg col-span-2 !min-h-[54px] !text-[16px] md:col-span-1"><%- icon('search', 'ico-sm') %>Szukaj ofert</button>
  </div>
  <datalist id="cityList"><option value="Trójmiasto"></option><% LOC.CITIES.forEach(function(c){ %><option value="<%= c.name %>"></option><% }) %></datalist>
</form>

<section class="wrap py-8">
  <%- include('../partials/breadcrumbs') %>
  <h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight">Poradnik nieruchomości</h1>
  <p class="mt-2 max-w-2xl text-muted">Kupno, sprzedaż i najem na Pomorzu i Pomorzu Zachodnim – praktyczne porady bez żargonu.</p>
</section>
<section class="wrap grid gap-5 pb-16 md:grid-cols-2 lg:grid-cols-3">
  <% articles.forEach(function(a, i){ %>
  <a href="/poradnik/<%= a.slug %>" class="group overflow-hidden rounded-xl border border-line bg-white transition hover:shadow-lift <%= i === 0 ? 'md:col-span-2 lg:row-span-1' : '' %>">
    <div class="scene <%= i === 0 ? 'aspect-[21/9]' : 'aspect-[16/9]' %>"><%- art.scene(a.scene[0], a.scene[1], a.scene[2]) %></div>
    <div class="p-6"><div class="flex items-center gap-2"><span class="badge tone-teal"><%= a.category %></span><span class="text-xs text-muted"><%= a.readMin %> min czytania</span></div>
      <h2 class="mt-3 font-display <%= i === 0 ? 'text-2xl' : 'text-lg' %> font-bold leading-snug group-hover:text-orange-600"><%= a.title %></h2><p class="mt-2 text-sm text-muted"><%= a.excerpt %></p></div>
  </a>
  <% }) %>
</section>

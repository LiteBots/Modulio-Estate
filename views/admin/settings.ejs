<div class="flex flex-wrap items-end justify-between gap-4">
  <div><p class="text-sm text-muted">Platforma</p><h1 class="font-display text-3xl font-extrabold">Ustawienia serwisu</h1><p class="mt-1 text-muted">Zmiany działają od razu na całej stronie, w mailach i w danych dla Google. Puste pole = wartość domyślna (szara podpowiedź).</p></div>
</div>
<form method="post" action="/admin/ustawienia" class="mt-6 grid gap-6 xl:grid-cols-2">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% fields.forEach(function(g){ %>
  <section class="card card-pad grid content-start gap-4">
    <h2 class="font-display text-lg font-bold"><%= g.group %></h2>
    <% g.items.forEach(function(it){ var id = 'set-' + it[0].replace('.', '-'); %>
    <div><label class="label" for="<%= id %>"><%= it[1] %></label>
      <% if (it[2] === 'textarea') { %><textarea id="<%= id %>" name="<%= it[0] %>" class="textarea !min-h-[90px]" placeholder="<%= fallback(it[0]) %>"><%= current(it[0]) %></textarea>
      <% } else { %><input id="<%= id %>" name="<%= it[0] %>" type="<%= it[2] %>" class="input" value="<%= current(it[0]) %>" placeholder="<%= fallback(it[0]) %>"><% } %>
    </div>
    <% }) %>
  </section>
  <% }) %>
  <section class="card card-pad grid content-start gap-3 xl:col-span-2">
    <h2 class="font-display text-lg font-bold">Ustawiane w Railway → Variables</h2>
    <p class="text-sm text-muted">Te wartości ze względów bezpieczeństwa zmienia się tylko w Railway: <code>ADMIN_PIN</code> (kod do tego panelu), <code>SESSION_SECRET</code>, <code>MONGODB_URI</code>, <code>SITE_URL</code>, logowanie Google i serwer poczty <code>SMTP_*</code>.</p>
    <div><button class="btn btn-primary"><%- icon('check', 'ico-sm') %>Zapisz ustawienia</button></div>
  </section>
</form>

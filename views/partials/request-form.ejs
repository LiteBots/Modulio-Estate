<% var kind = typeof kind !== 'undefined' ? kind : 'biuro'; %>
<% if (sent) { %>
<div class="flex flex-col items-center rounded-xl bg-teal-50 p-8 text-center">
  <span class="grid h-14 w-14 place-items-center rounded-full bg-teal-500 text-white"><%- icon('check', 'ico-lg') %></span>
  <p class="mt-4 font-display text-2xl font-bold">Dziękujemy!</p>
  <p class="mt-2 max-w-md text-muted">Otrzymaliśmy wiadomość. Odezwiemy się w ciągu 1–2 dni roboczych na podany adres e-mail lub telefon.</p>
</div>
<% } else { %>
<form method="post" action="<%= action %>" class="grid gap-4">
  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true">
  <% if (kind === 'biuro') { %>
  <div><span class="label">Kim jesteś?</span>
    <div class="grid grid-cols-2 gap-2 text-sm">
      <label class="cursor-pointer"><input type="radio" name="kind" value="biuro" class="peer sr-only" checked><span class="block rounded-2xl border border-line py-3 text-center font-semibold peer-checked:border-navy-800 peer-checked:bg-navy-800 peer-checked:text-white">Biuro nieruchomości</span></label>
      <label class="cursor-pointer"><input type="radio" name="kind" value="deweloper" class="peer sr-only"><span class="block rounded-2xl border border-line py-3 text-center font-semibold peer-checked:border-navy-800 peer-checked:bg-navy-800 peer-checked:text-white">Deweloper</span></label>
    </div></div>
  <% } else { %><input type="hidden" name="kind" value="<%= kind %>"><% } %>
  <div class="grid gap-4 sm:grid-cols-2">
    <div><label class="label" for="rq-name">Imię i nazwisko *</label><input id="rq-name" name="name" required class="input"></div>
    <div><label class="label" for="rq-company">Firma<%= kind === 'inne' ? '' : ' *' %></label><input id="rq-company" name="company" <%= kind === 'inne' ? '' : 'required' %> class="input"></div>
    <div><label class="label" for="rq-email">E-mail *</label><input id="rq-email" name="email" type="email" required class="input"></div>
    <div><label class="label" for="rq-phone">Telefon</label><input id="rq-phone" name="phone" class="input"></div>
  </div>
  <% if (kind !== 'inne') { %>
  <div class="grid gap-4 sm:grid-cols-<%= kind === 'biuro' ? '3' : '1' %>">
    <div><label class="label" for="rq-city">Miasto</label><input id="rq-city" name="city" list="cityList2" class="input"></div>
    <% if (kind === 'biuro') { %>
    <div><label class="label" for="rq-agents">Liczba agentów</label><select id="rq-agents" name="agentsCount" class="select"><option>1</option><option>2–5</option><option>6–15</option><option>16+</option></select></div>
    <div><label class="label" for="rq-listings">Liczba ofert</label><select id="rq-listings" name="listingsCount" class="select"><option>do 20</option><option>21–100</option><option>101–300</option><option>ponad 300</option></select></div>
    <% } %>
  </div>
  <datalist id="cityList2"><% LOC.CITIES.forEach(function(c){ %><option value="<%= c.name %>"></option><% }) %></datalist>
  <% } %>
  <% if (kind === 'reklama') { %>
  <div><span class="label">Interesujące miejsca reklamowe</span><div class="grid gap-2 sm:grid-cols-2"><% Object.keys(P.AD_PLACEMENTS).forEach(function(k){ %><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="interests" value="<%= k %>" class="check"><%= P.AD_PLACEMENTS[k].label %></label><% }) %></div></div>
  <% } else if (kind === 'biuro') { %>
  <div><span class="label">Co Cię interesuje?</span><div class="grid gap-2 sm:grid-cols-2"><% ['Publikacja ofert','Strona biura w serwisie','Import ofert z CRM (XML)','Wyróżnienia ofert','Konta dla zespołu','Reklama biura'].forEach(function(x){ %><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="interests" value="<%= x %>" class="check"><%= x %></label><% }) %></div></div>
  <% } %>
  <div><label class="label" for="rq-msg">Wiadomość</label><textarea id="rq-msg" name="message" class="textarea" placeholder="<%= kind === 'reklama' ? 'Opisz kampanię: branża, miasta, termin, budżet orientacyjny.' : kind === 'inne' ? 'W czym możemy pomóc?' : 'Napisz kilka słów o biurze i o tym, czego oczekujesz.' %>"></textarea></div>
  <label class="flex items-start gap-2 text-sm text-muted"><input type="checkbox" name="consent" value="1" required class="check mt-1">Wyrażam zgodę na kontakt w sprawie zgłoszenia. Administratorem danych jest operator serwisu – szczegóły w <a href="/polityka-prywatnosci" class="underline">polityce prywatności</a>.</label>
  <button class="btn btn-accent btn-lg w-full sm:w-fit"><%- icon('send', 'ico-sm') %>Wyślij zgłoszenie</button>
</form>
<% } %>

<section class="wrap py-8 sm:py-10">
  <div class="grid overflow-hidden rounded-[28px] border border-line bg-paper shadow-lift lg:grid-cols-[1fr_1.1fr]">
    <aside class="dark-band relative hidden flex-col justify-between gap-10 p-10 text-white lg:flex">
      <%- include('logo', { dark: true }) %>
      <div>
        <p class="eyebrow !text-white/60">Twoje konto</p>
        <p class="section-title mt-4 !text-[44px] !text-white">Wszystkie oferty<br><span class="serif-accent text-white/70">w jednym miejscu.</span></p>
        <div class="mt-8 grid gap-2.5">
          <% [['heart','Obserwowane ogłoszenia','Zapisuj oferty i wracaj do nich z każdego urządzenia.'],['bell','Powiadomienia','E-mail, gdy pojawi się nowa oferta w Twoim mieście.'],['message','Wiadomości','Rozmowy ze sprzedającymi w jednym wątku.']].forEach(function(f){ %>
          <div class="dark-card flex items-center gap-4"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-[12px] bg-orange-500/15 text-orange-400"><%- icon(f[0], 'ico-sm') %></span><span><b class="block text-sm text-white"><%= f[1] %></b><span class="text-[13px] text-white/60"><%= f[2] %></span></span></div>
          <% }) %>
        </div>
      </div>
      <p class="flex items-center gap-2 text-xs text-white/50"><%- icon('lock', 'ico-sm text-orange-400') %>Połączenie szyfrowane · hasła chronione algorytmem bcrypt</p>
    </aside>
    <div class="p-6 sm:p-10 lg:p-14">
      <div class="mx-auto max-w-md">
